# Development image for docker compose (see compose.yaml). Not used in production.
ARG RUBY_VERSION=3.4.1
FROM docker.io/library/ruby:$RUBY_VERSION-slim

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git curl libpq-dev libyaml-dev \
      pkg-config postgresql-client libvips imagemagick && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

WORKDIR /rails

ENV BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock ./
RUN bundle install

CMD ["bin/rails", "server", "-b", "0.0.0.0"]
