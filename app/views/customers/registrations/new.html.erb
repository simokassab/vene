<% content_for :title, "#{t('vene.auth.create')} · VENÈ Jewelry" %>
<%= render "shared/vene/auth_shell", tab: :signup do %>
  <div class="flex flex-col gap-6">
    <h1 class="vn-h2 m-0"><%= t("vene.auth.create_title") %></h1>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col gap-6" }) do |f| %>
      <%= render "shared/vene/form_errors", record: resource %>
      <div class="vn-field">
        <%= f.label :name, t("activerecord.attributes.user.name"), class: "vn-field__label" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", required: true, class: "vn-input" %>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-6">
        <div class="vn-field">
          <%= f.label :email, t("activerecord.attributes.user.email"), class: "vn-field__label" %>
          <%= f.email_field :email, autocomplete: "email", dir: "ltr", required: true, placeholder: "you@example.com", class: "vn-input" %>
        </div>
        <div class="vn-field">
          <%= f.label :phone, t("activerecord.attributes.user.phone"), class: "vn-field__label" %>
          <%= f.telephone_field :phone, autocomplete: "tel", dir: "ltr", required: true, placeholder: "+961 70 000 000", class: "vn-input" %>
        </div>
      </div>
      <fieldset class="m-0 p-0 border-0 flex flex-col gap-6 pt-6 border-t border-line">
        <legend class="vn-eyebrow vn-eyebrow--muted mb-6"><%= t("auth.default_address_title") %></legend>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-6">
          <div class="vn-field">
            <%= f.label :default_country, t("activerecord.attributes.user.default_country"), class: "vn-field__label" %>
            <%= f.country_select :default_country,
                  { priority_countries: [current_settings.local_country], except: %w[IL IR CU RU KP], include_blank: t("common.select_country") },
                  { autocomplete: "country-name", class: "vn-select" } %>
          </div>
          <div class="vn-field">
            <%= f.label :default_city, t("activerecord.attributes.user.default_city"), class: "vn-field__label" %>
            <%= f.text_field :default_city, autocomplete: "address-level2", class: "vn-input" %>
          </div>
        </div>
        <div class="vn-field">
          <%= f.label :default_address, t("activerecord.attributes.user.default_address"), class: "vn-field__label" %>
          <%= f.text_area :default_address, rows: 2, autocomplete: "street-address", class: "vn-textarea" %>
        </div>
      </fieldset>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-6 pt-6 border-t border-line" x-data="{ show: false }">
        <div class="vn-field">
          <%= f.label :password, t("activerecord.attributes.user.password"), class: "vn-field__label" %>
          <%= f.password_field :password, autocomplete: "new-password", required: true, class: "vn-input", "x-bind:type": "show ? 'text' : 'password'", "aria-describedby": "pw-hint" %>
          <span id="pw-hint" class="vn-field__hint"><%= t("auth.min_password") %></span>
        </div>
        <div class="vn-field">
          <%= f.label :password_confirmation, t("activerecord.attributes.user.password_confirmation"), class: "vn-field__label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "vn-input", "x-bind:type": "show ? 'text' : 'password'" %>
        </div>
        <label class="vn-check vn-check--muted col-span-full"><input type="checkbox" x-model="show"><span><%= t("vene.auth.show_password") %></span></label>
      </div>
      <%= f.button t("vene.auth.create"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
      <p class="m-0 vn-small">
        <%= t("auth.agree_register") %>
        <%= link_to t("pages.terms"), page_path("terms-and-conditions", locale: I18n.locale), class: "vn-link" %>
        <%= t("auth.and") %>
        <%= link_to t("pages.privacy"), page_path("privacy-policy", locale: I18n.locale), class: "vn-link" %>.
      </p>
    <% end %>
  </div>
<% end %>
