<% content_for :title, "#{t('vene.auth.sign_in')} · VENÈ Jewelry" %>
<%= render "shared/vene/auth_shell", tab: :signin do %>
  <div class="flex flex-col gap-6">
    <h1 class="vn-h2 m-0"><%= t("vene.auth.welcome_back") %></h1>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-6" }) do |f| %>
      <div class="vn-field">
        <%= f.label :email, t("activerecord.attributes.user.email"), class: "vn-field__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", dir: "ltr", required: true, placeholder: "you@example.com", class: "vn-input" %>
      </div>
      <div class="vn-field" x-data="{ show: false }">
        <%= f.label :password, t("activerecord.attributes.user.password"), class: "vn-field__label" %>
        <div class="relative">
          <%= f.password_field :password, autocomplete: "current-password", required: true, class: "vn-input pe-12", "x-bind:type": "show ? 'text' : 'password'" %>
          <button type="button" class="vn-icon-btn absolute end-0 top-0 !min-w-11" @click="show = !show"
                  :aria-label="show ? '<%= j t('vene.auth.hide_password') %>' : '<%= j t('vene.auth.show_password') %>'" :aria-pressed="show.toString()"><%= vn_icon(:eye, size: 18) %></button>
        </div>
      </div>
      <div class="flex flex-wrap justify-between items-center gap-4">
        <% if devise_mapping.rememberable? %>
          <label class="vn-check vn-check--muted">
            <%= f.check_box :remember_me %><span><%= t("vene.auth.keep_signed_in") %></span>
          </label>
        <% end %>
        <% if devise_mapping.recoverable? %>
          <%= link_to t("vene.auth.forgot"), new_password_path(resource_name), class: "vn-link text-[13px]" %>
        <% end %>
      </div>
      <%= f.button t("vene.auth.sign_in"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
      <p class="m-0 vn-small">
        <%= t("auth.agree_signin") %>
        <%= link_to t("pages.terms"), page_path("terms-and-conditions", locale: I18n.locale), class: "vn-link" %>
        <%= t("auth.and") %>
        <%= link_to t("pages.privacy"), page_path("privacy-policy", locale: I18n.locale), class: "vn-link" %>.
      </p>
    <% end %>
  </div>
<% end %>
