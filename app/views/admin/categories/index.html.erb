<%= render "admin/shared/top_bar", title: t("admin.categories.title"), crumb: t("vene.admin.nav.catalog") do %>
  <%= link_to new_admin_category_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" do %><%= vn_icon(:plus, size: 16) %><span><%= t("admin.categories.new") %></span><% end %>
<% end %>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.categories.name") %></th>
          <th scope="col"><%= t("vene.admin.common.pieces") %></th>
          <th scope="col"><%= t("vene.admin.common.status") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @categories.any? %>
          <% @categories.each do |category| %>
            <tr>
              <td>
                <span class="flex items-center gap-3">
                  <span class="ad-thumb"><% if category.image? %><%= image_tag category.image.url, alt: "", class: "!w-full !h-full !object-cover" %><% end %></span>
                  <span class="flex flex-col">
                    <%= link_to category.name_en, edit_admin_category_path(category, locale: I18n.locale), class: "vn-quiet !text-ink font-display text-lg leading-6" %>
                    <span class="ad-hint" lang="ar" dir="rtl"><%= category.name_ar %></span>
                  </span>
                </span>
              </td>
              <td class="font-latin"><%= category.products.count %></td>
              <td><span class="vn-status <%= category.active? ? 'vn-status--ok' : 'vn-status--off' %>"><%= category.active? ? t("common.active") : t("common.inactive") %></span></td>
              <td class="!text-end whitespace-nowrap">
                <%= link_to t("admin.actions.edit"), edit_admin_category_path(category, locale: I18n.locale), class: "ad-textbtn" %>
                <span class="mx-2 ad-off" aria-hidden="true">·</span>
                <%= link_to t("admin.actions.delete"), admin_category_path(category, locale: I18n.locale), class: "ad-textbtn !text-danger",
                      data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="!py-12 text-center ad-muted"><%= t("vene.admin.common.empty") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
