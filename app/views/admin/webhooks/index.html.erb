<% tone = { "success" => "ok", "fail" => "bad", "waiting" => "warn" } %>
<%= render "admin/shared/top_bar", title: t("admin.webhooks.title"), crumb: t("vene.admin.nav.settings"), subtitle: t("admin.webhooks.subtitle"),
      badge: "#{@pagy.count} #{t('admin.webhooks.total')}", badge_tone: "outline" %>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.webhooks.webhook_id") %></th>
          <th scope="col"><%= t("admin.webhooks.type") %></th>
          <th scope="col"><%= t("admin.webhooks.order") %></th>
          <th scope="col"><%= t("admin.webhooks.status") %></th>
          <th scope="col"><%= t("admin.webhooks.received_at") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @webhooks.any? %>
          <% @webhooks.each do |webhook| %>
            <% payload = webhook.payload || {} %>
            <% status = payload["status"] || payload[:status] %>
            <tr>
              <td class="ad-mono"><%= link_to webhook.webhook_id.truncate(20), admin_webhook_path(webhook, locale: I18n.locale), class: "vn-link" %></td>
              <td><span class="vn-badge vn-badge--outline"><%= webhook.webhook_type %></span></td>
              <td><%= webhook.order_id.present? ? link_to("##{webhook.order_id}", admin_order_path(webhook.order_id, locale: I18n.locale), class: "vn-link ad-mono") : tag.span("—", class: "ad-off") %></td>
              <td><span class="vn-status vn-status--<%= tone.fetch(status.to_s, 'off') %>"><%= status || t("vene.admin.webhooks.unknown") %></span></td>
              <td class="ad-muted whitespace-nowrap ad-mono"><%= webhook.processed_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td class="!text-end"><%= link_to t("admin.actions.view"), admin_webhook_path(webhook, locale: I18n.locale), class: "ad-textbtn" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="!py-12 text-center ad-muted"><%= t("admin.webhooks.no_webhooks_subtitle") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %><div class="px-5 py-4 border-t border-line"><%== pagy_nav(@pagy) %></div><% end %>
</div>
