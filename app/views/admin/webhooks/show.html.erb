<% payload = @webhook.payload || {} %>
<% status = payload["status"] || payload[:status] %>
<% value = ->(key) { payload[key.to_s] || payload[key.to_sym] } %>
<% tone = { "success" => "noir", "fail" => "danger", "waiting" => "gold" } %>
<%= render "admin/shared/top_bar", title: t("admin.webhooks.details"), crumb: t("admin.webhooks.title"), crumb_href: admin_webhooks_path(locale: I18n.locale),
      badge: (status || t("vene.admin.webhooks.unknown")), badge_tone: tone.fetch(status.to_s, "outline"), subtitle: @webhook.webhook_id do %>
  <% if @order %><%= link_to t("admin.webhooks.view_order"), admin_order_path(@order, locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--sm" %><% end %>
<% end %>
<div class="flex flex-wrap items-start gap-6">
  <div class="flex-[999_1_560px] min-w-0 flex flex-col gap-6">
    <%= render "admin/shared/card", title: t("admin.webhooks.overview") do %>
      <dl class="m-0 ad-grid-2">
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.webhook_id") %></dt><dd class="m-0 ad-mono break-all"><%= @webhook.webhook_id %></dd></div>
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.type") %></dt><dd class="m-0"><%= @webhook.webhook_type %></dd></div>
        <div>
          <dt class="ad-label mb-1"><%= t("admin.webhooks.order") %></dt>
          <dd class="m-0">
            <% if @order %><%= link_to "##{@order.id}", admin_order_path(@order, locale: I18n.locale), class: "vn-link ad-mono" %>
            <% elsif @webhook.order_id.present? %><span class="ad-muted">#<%= @webhook.order_id %> · <%= t("vene.admin.webhooks.not_found") %></span>
            <% else %><span class="ad-off">—</span><% end %>
          </dd>
        </div>
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.received_at") %></dt><dd class="m-0 ad-mono"><%= @webhook.processed_at.strftime("%Y-%m-%d %H:%M:%S %Z") %></dd></div>
      </dl>
    <% end %>
    <%= render "admin/shared/card", title: t("admin.webhooks.payment_details") do %>
      <dl class="m-0 ad-grid-2">
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.amount") %></dt><dd class="m-0 font-display text-2xl leading-8"><bdi class="font-latin"><%= value.(:order_amount) || "—" %> <span class="ad-hint"><%= value.(:order_currency) %></span></bdi></dd></div>
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.payment_status") %></dt><dd class="m-0"><span class="vn-status vn-status--<%= { 'success' => 'ok', 'fail' => 'bad', 'waiting' => 'warn' }.fetch(status.to_s, 'off') %>"><%= status || t("vene.admin.webhooks.unknown") %></span></dd></div>
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.card") %></dt><dd class="m-0 ad-mono"><%= value.(:card) || "—" %></dd></div>
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.transaction_date") %></dt><dd class="m-0"><%= value.(:date) || "—" %></dd></div>
        <% if value.(:reason).present? %>
          <div class="col-span-full"><dt class="ad-label mb-1"><%= t("admin.webhooks.reason") %></dt><dd class="m-0 text-danger"><%= value.(:reason) %></dd></div>
        <% end %>
      </dl>
    <% end %>
    <% if (value.(:customer_name) || value.(:customer_email)).present? %>
      <%= render "admin/shared/card", title: t("admin.webhooks.customer_info") do %>
        <dl class="m-0 ad-grid-2">
          <div><dt class="ad-label mb-1"><%= t("admin.webhooks.customer_name") %></dt><dd class="m-0"><%= value.(:customer_name) || "—" %></dd></div>
          <div><dt class="ad-label mb-1"><%= t("admin.webhooks.customer_email") %></dt><dd class="m-0"><%= value.(:customer_email) || "—" %></dd></div>
        </dl>
      <% end %>
    <% end %>
    <section class="ad-card" x-data>
      <header class="flex items-center justify-between gap-4 mb-4">
        <h2 class="ad-h2"><%= t("admin.webhooks.raw_payload") %></h2>
        <button type="button" class="ad-iconbtn" @click="navigator.clipboard.writeText($refs.payload.textContent).then(() => $dispatch('show-toast', { message: '<%= j t('admin.webhooks.copied') %>', type: 'success' }))">
          <%= vn_icon(:file, size: 16) %><span><%= t("admin.webhooks.copy") %></span>
        </button>
      </header>
      <pre x-ref="payload" dir="ltr" class="vn-noir m-0 p-5 overflow-x-auto ad-mono text-[13px] leading-6"><%= JSON.pretty_generate(payload) %></pre>
    </section>
  </div>
  <aside class="flex-[1_1_280px] min-w-0 max-w-[360px]">
    <%= render "admin/shared/card", title: t("admin.webhooks.timestamps") do %>
      <dl class="m-0 flex flex-col gap-4">
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.processed_at") %></dt><dd class="m-0 ad-mono"><%= @webhook.processed_at.strftime("%Y-%m-%d %H:%M:%S") %></dd></div>
        <div><dt class="ad-label mb-1"><%= t("admin.webhooks.created_at") %></dt><dd class="m-0 ad-mono"><%= @webhook.created_at.strftime("%Y-%m-%d %H:%M:%S") %></dd></div>
      </dl>
    <% end %>
  </aside>
</div>
