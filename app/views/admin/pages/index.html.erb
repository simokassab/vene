<%= render "admin/shared/top_bar", title: t("admin.pages.title"), crumb: t("vene.admin.nav.storefront") do %>
  <%= link_to new_admin_page_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" do %><%= vn_icon(:plus, size: 16) %><span><%= t("admin.pages.new") %></span><% end %>
<% end %>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.pages.title_label") %></th>
          <th scope="col"><%= t("vene.admin.page_form.address") %></th>
          <th scope="col"><%= t("vene.admin.common.status") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @pages.any? %>
          <% @pages.each do |page| %>
            <tr>
              <td>
                <span class="flex flex-col">
                  <%= link_to page.title_en, edit_admin_page_path(page, locale: I18n.locale), class: "vn-quiet !text-ink font-display text-lg leading-6" %>
                  <span class="ad-hint" lang="ar" dir="rtl"><%= page.title_ar %></span>
                </span>
              </td>
              <td><%= link_to "/pages/#{page.slug}", page_path(page.slug, locale: I18n.locale), target: "_blank", rel: "noopener", class: "vn-quiet ad-mono" %></td>
              <td><span class="vn-status <%= page.active? ? 'vn-status--ok' : 'vn-status--off' %>"><%= page.active? ? t("common.active") : t("common.inactive") %></span></td>
              <td class="!text-end whitespace-nowrap">
                <%= link_to t("admin.actions.edit"), edit_admin_page_path(page, locale: I18n.locale), class: "ad-textbtn" %>
                <span class="mx-2 ad-off" aria-hidden="true">·</span>
                <%= link_to t("admin.actions.delete"), admin_page_path(page, locale: I18n.locale), class: "ad-textbtn !text-danger",
                      data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="!py-12 text-center ad-muted"><%= t("vene.admin.common.empty") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
