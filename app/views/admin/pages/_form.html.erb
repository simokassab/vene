<% tf = "vene.admin.product_form" %>
<%= form_with(model: [:admin, @page], local: true) do |form| %>
  <%= render "shared/vene/form_errors", record: @page, title: t("#{tf}.fix") %>
  <div class="flex flex-wrap items-start gap-6 mt-2">
    <div class="flex-[999_1_560px] min-w-0 flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.details") do %>
        <div class="ad-grid-2">
          <div class="ad-field"><%= form.label :title_en, t("vene.admin.page_form.title_en"), class: "ad-label" %><%= form.text_field :title_en, class: "ad-input", dir: "ltr" %></div>
          <div class="ad-field"><%= form.label :title_ar, t("vene.admin.page_form.title_ar"), class: "ad-label" %><%= form.text_field :title_ar, class: "ad-input", dir: "rtl", lang: "ar" %></div>
          <div class="ad-field col-span-full"><%= form.label :slug, t("#{tf}.slug"), class: "ad-label" %><%= form.text_field :slug, class: "ad-input ad-mono", dir: "ltr", placeholder: "delivery-policy" %><span class="ad-hint"><%= t("vene.admin.page_form.slug_hint") %></span></div>
        </div>
      <% end %>
      <%= render "admin/shared/card", title: t("vene.admin.page_form.content_en"), subtitle: t("vene.admin.page_form.content_hint") do %>
        <%= form.text_area :content_en, rows: 15, id: "content_en_editor", class: "ad-textarea tinymce-editor", "aria-label": t("vene.admin.page_form.content_en") %>
      <% end %>
      <%= render "admin/shared/card", title: t("vene.admin.page_form.content_ar") do %>
        <%= form.text_area :content_ar, rows: 15, id: "content_ar_editor", class: "ad-textarea tinymce-editor", dir: "rtl", "aria-label": t("vene.admin.page_form.content_ar") %>
      <% end %>
    </div>
    <aside class="flex-[1_1_280px] min-w-0 max-w-[360px] flex flex-col gap-6 lg:sticky lg:top-6">
      <%= render "admin/shared/card", title: t("#{tf}.visibility") do %>
        <label class="vn-check"><%= form.check_box :active %><span><%= t("#{tf}.active") %><span class="vn-check__hint"><%= t("#{tf}.active_hint") %></span></span></label>
      <% end %>
      <div class="ad-card flex flex-col gap-3">
        <%= form.button t("admin.actions.save"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
        <%= link_to t("common.cancel"), admin_pages_path(locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--block vn-btn--sm" %>
        <% if @page.persisted? %>
          <%= link_to page_path(@page.slug, locale: I18n.locale), target: "_blank", rel: "noopener", class: "ad-textbtn self-center inline-flex items-center gap-2" do %><%= t("#{tf}.view_live") %> <%= vn_icon(:external, size: 14) %><% end %>
        <% end %>
      </div>
    </aside>
  </div>
<% end %>

<script>
  // Initialize TinyMCE when the page loads (works with Turbo)
  document.addEventListener('turbo:load', initializeTinyMCE);
  document.addEventListener('DOMContentLoaded', initializeTinyMCE);

  function initializeTinyMCE() {
    // Remove existing instances to prevent duplicates
    if (typeof tinymce !== 'undefined') {
      tinymce.remove();
    }

    // Common configuration for both editors
    const commonConfig = {
      height: 500,
      menubar: true,
      plugins: [
        'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'link', 'lists', 'media',
        'searchreplace', 'table', 'visualblocks', 'wordcount', 'code', 'fullscreen', 'preview',
        'insertdatetime', 'advlist', 'help', 'image', 'quickbars', 'directionality'
      ],
      toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | ' +
        'forecolor backcolor | alignleft aligncenter alignright alignjustify | ' +
        'numlist bullist outdent indent | link image media table | emoticons charmap codesample | ' +
        'code visualblocks | removeformat | fullscreen preview help',
      image_advtab: true,
      file_picker_types: 'image',
      automatic_uploads: false,
      content_style: 'body { font-family: Jost, "Helvetica Neue", Arial, sans-serif; font-size: 16px; line-height: 1.7; color: #131313; padding: 12px; } h1, h2, h3 { font-family: "Cormorant Garamond", Georgia, serif; font-weight: 400; }'
    };

    // Initialize English editor
    if (document.getElementById('content_en_editor')) {
      tinymce.init({
        ...commonConfig,
        selector: '#content_en_editor',
        directionality: 'ltr'
      });
    }

    // Initialize Arabic editor
    if (document.getElementById('content_ar_editor')) {
      tinymce.init({
        ...commonConfig,
        selector: '#content_ar_editor',
        directionality: 'rtl',
        language: 'ar',
        language_url: '/tinymce/langs/ar.js',
        content_style: 'body { font-family: "IBM Plex Sans Arabic", Tahoma, sans-serif; font-size: 17px; direction: rtl; text-align: right; line-height: 1.8; color: #131313; padding: 12px; } h1, h2, h3 { font-family: Amiri, serif; font-weight: 700; }'
      });
    }
  }

  // Clean up when navigating away with Turbo
  document.addEventListener('turbo:before-cache', function() {
    if (typeof tinymce !== 'undefined') {
      tinymce.remove();
    }
  });
</script>
