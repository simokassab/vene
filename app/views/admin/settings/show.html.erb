<%# Settings (SettingRow / AdminMaintenance / AdminPayments): grouped cards of label, hint and
    control. Every field posts to admin_setting_path as before. %>
<% sf = "vene.admin.settings" %>
<%= render "admin/shared/top_bar", title: t("admin.settings.title"), crumb: t("vene.admin.nav.settings") %>
<%= form_with(model: [:admin, @setting], url: admin_setting_path(locale: I18n.locale), method: :put, local: true, class: "max-w-[960px] flex flex-col gap-6") do |form| %>
  <%= render "shared/vene/form_errors", record: @setting, title: t("vene.admin.product_form.fix") %>

  <%= render "admin/shared/card", title: t("#{sf}.store") do %>
    <div class="ad-grid-2">
      <div class="ad-field"><%= form.label :store_name, t("#{sf}.store_name"), class: "ad-label" %><%= form.text_field :store_name, class: "ad-input" %></div>
      <div class="ad-field"><%= form.label :default_currency, t("#{sf}.default_currency"), class: "ad-label" %><%= form.text_field :default_currency, class: "ad-input font-latin uppercase", dir: "ltr" %></div>
      <div class="ad-field"><%= form.label :local_country, t("#{sf}.local_country"), class: "ad-label" %><%= form.text_field :local_country, class: "ad-input font-latin uppercase", dir: "ltr" %><span class="ad-hint"><%= t("#{sf}.local_country_hint") %></span></div>
      <div class="ad-field"><%= form.label :whatsapp_phone_number, t("#{sf}.whatsapp"), class: "ad-label" %><%= form.text_field :whatsapp_phone_number, class: "ad-input font-latin", dir: "ltr", placeholder: "96178729590" %><span class="ad-hint"><%= t("#{sf}.whatsapp_hint") %></span></div>
    </div>
  <% end %>

  <%= render "admin/shared/card", title: t("#{sf}.tax_shipping") do %>
    <div class="ad-grid-3">
      <div class="ad-field"><%= form.label :local_tax_rate, t("#{sf}.local_tax"), class: "ad-label" %><%= form.number_field :local_tax_rate, step: 0.01, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint">%</span></div>
      <div class="ad-field"><%= form.label :international_tax_rate, t("#{sf}.international_tax"), class: "ad-label" %><%= form.number_field :international_tax_rate, step: 0.01, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint">%</span></div>
      <div class="ad-field"><%= form.label :shipping_flat_rate, t("#{sf}.flat_rate"), class: "ad-label" %><%= form.number_field :shipping_flat_rate, step: 0.01, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint"><%= t("#{sf}.flat_rate_hint") %></span></div>
    </div>
    <div class="flex items-start justify-between gap-6 mt-6 pt-5 border-t border-line">
      <span class="flex flex-col"><%= form.label :show_tax_notice, t("admin.settings.show_tax_notice"), class: "font-medium" %><span class="ad-hint"><%= t("admin.settings.show_tax_notice_hint") %></span></span>
      <%= form.check_box :show_tax_notice, class: "vn-switch", role: "switch" %>
    </div>
  <% end %>

  <%= render "admin/shared/card", title: t("#{sf}.maintenance") do %>
    <div class="flex items-start justify-between gap-6">
      <span class="flex flex-col"><%= form.label :maintenance_mode, t("#{sf}.maintenance_label"), class: "font-medium" %><span class="ad-hint"><%= t("#{sf}.maintenance_hint") %></span></span>
      <%= form.check_box :maintenance_mode, class: "vn-switch", role: "switch" %>
    </div>
    <% if @setting.maintenance_mode %>
      <div class="mt-5"><%= render "shared/vene/notice", variant: :banner, tone: :note, text: t("#{sf}.maintenance_on") %></div>
    <% end %>
  <% end %>

  <%= render "admin/shared/card", title: t("products.made_to_order_badge") do %>
    <div class="flex items-start justify-between gap-6 pb-5 mb-5 border-b border-line">
      <span class="flex flex-col"><%= form.label :preorder_enabled, t("#{sf}.preorders_label"), class: "font-medium" %><span class="ad-hint"><%= t("#{sf}.preorders_hint") %></span></span>
      <%= form.check_box :preorder_enabled, class: "vn-switch", role: "switch" %>
    </div>
    <div class="ad-grid-2">
      <div class="ad-field"><%= form.label :preorder_default_delivery_days, t("#{sf}.delivery_days"), class: "ad-label" %><%= form.number_field :preorder_default_delivery_days, class: "ad-input font-latin", dir: "ltr" %></div>
      <div></div>
      <div class="ad-field"><%= form.label :preorder_disclaimer_en, t("#{sf}.disclaimer_en"), class: "ad-label" %><%= form.text_area :preorder_disclaimer_en, rows: 3, class: "ad-textarea", dir: "ltr" %></div>
      <div class="ad-field"><%= form.label :preorder_disclaimer_ar, t("#{sf}.disclaimer_ar"), class: "ad-label" %><%= form.text_area :preorder_disclaimer_ar, rows: 3, class: "ad-textarea", dir: "rtl", lang: "ar" %></div>
    </div>
  <% end %>

  <div class="ad-row sticky bottom-0 py-4 bg-surface border-t border-line">
    <%= form.button t("admin.actions.save"), type: "submit", class: "vn-btn vn-btn--primary" %>
  </div>
<% end %>
