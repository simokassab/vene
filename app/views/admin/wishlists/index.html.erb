<%= render "admin/shared/top_bar", title: t("admin.wishlists.title"), crumb: t("vene.admin.nav.sales"), subtitle: t("admin.wishlists.subtitle") %>
<div class="ad-grid-3 mb-6">
  <%= render "admin/shared/stat_card", title: t("admin.wishlists.total_items"), value: WishlistItem.count.to_s %>
  <%= render "admin/shared/stat_card", title: t("admin.wishlists.unique_customers"), value: WishlistItem.select(:user_id).distinct.count.to_s %>
  <%= render "admin/shared/stat_card", title: t("admin.wishlists.unique_products"), value: WishlistItem.select(:product_id).distinct.count.to_s %>
</div>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.wishlists.customer") %></th>
          <th scope="col"><%= t("admin.wishlists.product") %></th>
          <th scope="col"><%= t("admin.wishlists.price_when_added") %></th>
          <th scope="col"><%= t("admin.wishlists.current_price") %></th>
          <th scope="col"><%= t("admin.wishlists.notifications") %></th>
          <th scope="col"><%= t("admin.wishlists.added_on") %></th>
        </tr>
      </thead>
      <tbody>
        <% if @wishlist_items.any? %>
          <% @wishlist_items.each do |item| %>
            <tr>
              <td>
                <% if item.user %>
                  <span class="flex flex-col"><span><%= item.user.name %></span><span class="ad-hint"><%= item.user.email %></span></span>
                <% else %>
                  <span class="ad-off"><%= t("admin.wishlists.deleted_user") %></span>
                <% end %>
              </td>
              <td>
                <% if item.product %>
                  <span class="flex items-center gap-3">
                    <span class="ad-thumb"><% if (src = vn_product_image_url(item.product, version: :thumb)) %><%= image_tag src, alt: "" %><% end %></span>
                    <span class="flex flex-col">
                      <span class="font-display text-lg leading-6"><%= item.product.name(I18n.locale) %></span>
                      <span class="ad-hint"><%= [item.product.sub_category&.name(I18n.locale), item.product_variant&.display_name].compact.join(" · ") %></span>
                    </span>
                  </span>
                <% else %>
                  <span class="ad-off"><%= t("admin.wishlists.deleted_product") %></span>
                <% end %>
              </td>
              <td class="whitespace-nowrap"><%= vn_price(item.price_when_added) %></td>
              <td class="whitespace-nowrap">
                <% if item.product %>
                  <%= vn_price(item.current_price) %>
                  <% if item.price_dropped? %><span class="vn-status vn-status--ok ms-2">−<%= item.price_drop_percentage %>%</span><% end %>
                <% else %>—<% end %>
              </td>
              <td>
                <span class="flex flex-wrap gap-1.5">
                  <% if item.notify_back_in_stock? %><span class="vn-badge vn-badge--outline"><%= t("admin.wishlists.stock_alert") %></span><% end %>
                  <% if item.notify_price_drop? %><span class="vn-badge vn-badge--outline"><%= t("admin.wishlists.price_alert") %></span><% end %>
                  <% unless item.notify_back_in_stock? || item.notify_price_drop? %><span class="ad-off">—</span><% end %>
                </span>
              </td>
              <td class="ad-muted whitespace-nowrap"><%= l(item.created_at.to_date, format: :long) %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="!py-12 text-center ad-muted"><%= t("admin.wishlists.no_items_subtitle") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %><div class="px-5 py-4 border-t border-line"><%== pagy_nav(@pagy) %></div><% end %>
</div>
