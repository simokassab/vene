<%# Tracking (Timeline.dc.html): DHL's status summary, then the journey, newest first. %>
<%= render "admin/shared/top_bar", title: t("vene.admin.orders.tracking_title", number: "##{@order.id}"), crumb: t("admin.orders.title"),
      crumb_href: admin_order_path(@order, locale: I18n.locale), subtitle: "DHL Express · #{@order.dhl_tracking_id}" %>
<% if @tracking_info.present? %>
  <div class="ad-card mb-6">
    <dl class="m-0 ad-grid-3">
      <div><dt class="ad-label mb-1"><%= t("vene.admin.orders.current_status") %></dt><dd class="m-0 font-display text-xl leading-7"><%= @tracking_info.status_description %></dd></div>
      <div><dt class="ad-label mb-1"><%= t("vene.admin.orders.origin") %></dt><dd class="m-0"><%= @tracking_info.origin.presence || "—" %></dd></div>
      <div><dt class="ad-label mb-1"><%= t("vene.admin.orders.destination") %></dt><dd class="m-0"><%= @tracking_info.destination.presence || "—" %></dd></div>
      <div><dt class="ad-label mb-1"><%= t("vene.admin.orders.estimated_delivery") %></dt><dd class="m-0"><%= @tracking_info.estimated_delivery ? l(@tracking_info.estimated_delivery.to_date, format: :long) : "—" %></dd></div>
    </dl>
  </div>
  <%= render "admin/shared/card", title: t("vene.admin.orders.journey") do %>
    <% if @tracking_info.events.any? %>
      <ol class="list-none m-0 p-0 border-s border-line flex flex-col">
        <% @tracking_info.events.each_with_index do |event, index| %>
          <li class="relative flex flex-wrap gap-x-8 gap-y-1 ps-8 pb-8 last:pb-0">
            <span aria-hidden="true" class="absolute -start-[5px] top-1.5 w-[9px] h-[9px] <%= index.zero? ? 'bg-ink' : 'bg-surface border border-line-control' %>"></span>
            <span class="flex-[0_0_160px] ad-hint pt-0.5"><%= event.formatted_time %></span>
            <span class="flex-1 min-w-0 flex flex-col">
              <span class="<%= index.zero? ? 'font-medium' : '' %>"><%= event.description %></span>
              <% if event.location.present? %><span class="ad-hint"><%= event.location %></span><% end %>
            </span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="m-0 ad-muted"><%= t("vene.admin.orders.no_events") %></p>
    <% end %>
  <% end %>
<% else %>
  <div class="ad-card flex flex-col items-start gap-4">
    <h2 class="ad-h2"><%= t("vene.admin.orders.tracking_unavailable") %></h2>
    <p class="m-0 ad-muted max-w-[620px]"><%= t("vene.admin.orders.tracking_unavailable_text") %></p>
    <%= link_to t("vene.admin.orders.back_to_order"), admin_order_path(@order, locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--sm" %>
  </div>
<% end %>
