<%# AdminOrders.dc.html: status tabs (the controller's ?status filter), the month at a glance,
    then the orders with payment, status and waybill. %>
<% statuses = Order::STATUSES %>
<% total = @status_counts.values.sum %>
<%= render "admin/shared/top_bar", title: t("admin.orders.title"), crumb: t("vene.admin.nav.sales") %>

<ul class="list-none m-0 mb-6 p-0 ad-grid-3">
  <li><%= render "admin/shared/stat_card", title: t("vene.admin.orders.to_prepare"), value: @status_counts.fetch("paid", 0).to_s %></li>
  <li><%= render "admin/shared/stat_card", title: t("vene.admin.orders.awaiting_payment"), value: (@status_counts.fetch("payment_pending", 0) + @status_counts.fetch("pending", 0)).to_s %></li>
  <li><%= render "admin/shared/stat_card", title: t("vene.admin.orders.on_the_way"), value: @status_counts.fetch("shipped", 0).to_s %></li>
</ul>

<div class="ad-card !p-0">
  <nav class="ad-tabs px-5 pt-1" aria-label="<%= t('vene.admin.orders.filter') %>">
    <%= link_to admin_orders_path(locale: I18n.locale), class: "ad-tab", "aria-current": (params[:status].blank? ? "page" : nil) do %>
      <%= t("vene.collection.all") %>&nbsp;<span class="ad-off font-latin"><%= total %></span>
    <% end %>
    <% statuses.each do |status| %>
      <%= link_to admin_orders_path(locale: I18n.locale, status: status), class: "ad-tab", "aria-current": (params[:status] == status ? "page" : nil) do %>
        <%= vn_status_label(status) %>&nbsp;<span class="ad-off font-latin"><%= @status_counts.fetch(status, 0) %></span>
      <% end %>
    <% end %>
  </nav>
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("vene.orders.order_label") %></th>
          <th scope="col"><%= t("vene.orders.placed") %></th>
          <th scope="col"><%= t("admin.orders.customer") %></th>
          <th scope="col"><%= t("vene.admin.orders.pieces") %></th>
          <th scope="col"><%= t("vene.orders.value") %></th>
          <th scope="col"><%= t("vene.orders.payment") %></th>
          <th scope="col"><%= t("admin.orders.status") %></th>
          <th scope="col"><%= t("vene.admin.orders.waybill") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @orders.any? %>
          <% @orders.each do |order| %>
            <% payment_tone = { "paid" => "ok", "failed" => "bad" }.fetch(order.payment_status, "warn") %>
            <tr>
              <td><%= link_to "##{order.id}", admin_order_path(order, locale: I18n.locale), class: "vn-link ad-mono" %></td>
              <td class="ad-muted whitespace-nowrap"><%= l(order.created_at.to_date, format: :long) %></td>
              <td><span class="flex flex-col"><span><%= order.name %></span><span class="ad-hint"><%= order.email %></span></span></td>
              <td class="font-latin"><%= order.order_items.sum(&:quantity) %></td>
              <td class="whitespace-nowrap"><%= vn_order_price(order.total_amount, order) %></td>
              <td><span class="vn-status vn-status--<%= payment_tone %>"><%= vn_payment_status_label(order.payment_status) %></span></td>
              <td><span class="vn-badge vn-badge--<%= vn_status_tone(order.status) %>"><%= vn_status_label(order.status) %></span></td>
              <td>
                <% if order.dhl_tracking_id.present? %>
                  <span class="ad-mono"><%= order.dhl_tracking_id %></span>
                <% elsif %w[paid shipped].include?(order.status) %>
                  <span class="vn-status vn-status--bad"><%= t("vene.admin.orders.missing") %></span>
                <% else %>
                  <span class="ad-off"><%= t("vene.admin.orders.not_shipped") %></span>
                <% end %>
              </td>
              <td class="!text-end"><%= link_to t("admin.actions.view"), admin_order_path(order, locale: I18n.locale), class: "ad-textbtn" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="9" class="!py-12 text-center ad-muted"><%= t("vene.admin.orders.none") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
