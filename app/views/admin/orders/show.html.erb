<%# AdminOrderDetail.dc.html: header with the status badge and actions, the pieces and totals,
    then client, delivery, payment and shipment cards. Every action posts where it did before. %>
<%= render "admin/shared/top_bar", title: "#{t('vene.orders.order_label')} ##{@order.id}", crumb: t("admin.orders.title"),
      crumb_href: admin_orders_path(locale: I18n.locale), badge: vn_status_label(@order.status), badge_tone: vn_status_tone(@order.status),
      subtitle: t("vene.orders.placed_on", date: l(@order.created_at, format: :long)) do %>
  <%= link_to invoice_admin_order_path(@order, locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--sm" do %>
    <%= vn_icon(:download, size: 16) %><span><%= t("admin.orders.invoice") %></span>
  <% end %>
  <%= link_to t("admin.actions.edit"), edit_admin_order_path(@order, locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" %>
<% end %>

<div class="flex flex-wrap items-start gap-6">
  <div class="flex-[999_1_560px] min-w-0 flex flex-col gap-6">
    <%= render "admin/shared/card", title: t("vene.checkout.pieces"), subtitle: t("vene.cart.count", count: @order.order_items.sum(&:quantity)) do %>
      <ul class="list-none m-0 p-0 flex flex-col">
        <% @order.order_items.each do |item| %>
          <li class="flex items-center gap-4 py-4 border-b border-line first:pt-0">
            <span class="ad-thumb !w-16 !h-16">
              <% if (src = vn_product_image_url(item.product, version: :thumb)) %><%= image_tag src, alt: "" %><% end %>
            </span>
            <span class="flex-1 min-w-0 flex flex-col">
              <%= link_to item.product.name(I18n.locale), edit_admin_product_path(item.product, locale: I18n.locale), class: "vn-quiet !text-ink font-display text-xl leading-7" %>
              <span class="ad-hint"><%= [item.product.category&.name(I18n.locale), item.product_variant&.display_name, (t("vene.email.made_to_order") if item.is_preorder)].compact.join(" · ") %></span>
              <span class="ad-hint"><%= vn_order_price(item.unit_price, @order) %> × <span class="font-latin"><%= item.quantity %></span></span>
            </span>
            <span class="whitespace-nowrap"><%= vn_order_price(item.line_total, @order) %></span>
          </li>
        <% end %>
      </ul>
      <div class="max-w-[420px] ms-auto pt-6">
        <%
          rows = [[t("orders.subtotal"), vn_order_price(@order.subtotal, @order)],
                  [t("vene.cart.delivery"), vn_order_price(@order.shipping_amount, @order)]]
          rows << [safe_join([t("coupons.discount"), " ", tag.span(@order.coupon_code, class: "ad-mono")]), safe_join(["−", vn_order_price(@order.discount_amount, @order)])] if @order.discount_amount.positive?
        %>
        <%= render "shared/vene/totals", rows: rows, total: vn_order_price(@order.total_amount, @order) %>
        <% if current_settings.show_tax_notice %><p class="m-0 mt-2 ad-hint text-end"><%= t("common.prices_include_tax") %></p><% end %>
      </div>
    <% end %>
  </div>

  <div class="flex-[1_1_320px] min-w-0 max-w-[420px] flex flex-col gap-6">
    <%= render "admin/shared/card", title: t("vene.admin.orders.fulfilment") do %>
      <dl class="m-0 flex flex-col gap-4">
        <div><dt class="ad-label mb-1"><%= t("admin.orders.status") %></dt><dd class="m-0"><span class="vn-badge vn-badge--<%= vn_status_tone(@order.status) %>"><%= vn_status_label(@order.status) %></span></dd></div>
        <div>
          <dt class="ad-label mb-1"><%= t("vene.orders.payment") %></dt>
          <dd class="m-0 flex flex-col gap-1">
            <span class="vn-status vn-status--<%= { 'paid' => 'ok', 'failed' => 'bad' }.fetch(@order.payment_status, 'warn') %>"><%= vn_payment_status_label(@order.payment_status) %></span>
            <span class="ad-hint"><%= payment_method_label(@order) %></span>
          </dd>
        </div>
      </dl>
      <div class="flex flex-col gap-3 mt-6">
        <%= button_to t("admin.orders.mark_shipped"), update_status_admin_order_path(@order, locale: I18n.locale, status: :shipped), method: :patch,
              form: { data: { turbo_confirm: t("admin.actions.confirm") } }, class: "vn-btn vn-btn--primary vn-btn--sm vn-btn--block" %>
        <%= button_to t("admin.orders.mark_paid"), update_payment_status_admin_order_path(@order, locale: I18n.locale, payment_status: :paid), method: :patch,
              form: { data: { turbo_confirm: t("admin.actions.confirm") } }, class: "vn-btn vn-btn--outline vn-btn--sm vn-btn--block" %>
      </div>
    <% end %>

    <%= render "admin/shared/card", title: t("vene.admin.orders.shipment") do %>
      <% if @order.dhl_tracking_id.present? %>
        <dl class="m-0 mb-5"><dt class="ad-label mb-1"><%= t("vene.admin.orders.waybill") %></dt><dd class="m-0 ad-mono"><%= @order.dhl_tracking_id %></dd></dl>
        <%= link_to tracking_admin_order_path(@order, locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--sm vn-btn--block" do %>
          <%= vn_icon(:truck, size: 16) %><span><%= t("vene.admin.orders.view_tracking") %></span>
        <% end %>
      <% else %>
        <p class="m-0 mb-5 ad-muted"><%= t("vene.admin.orders.no_waybill") %></p>
        <%= button_to create_shipment_admin_order_path(@order, locale: I18n.locale), method: :post,
              form: { data: { turbo_confirm: t("vene.admin.orders.confirm_shipment") } }, class: "vn-btn vn-btn--gold vn-btn--sm vn-btn--block" do %>
          <%= vn_icon(:package, size: 16) %><span><%= t("vene.admin.orders.create_shipment") %></span>
        <% end %>
      <% end %>
    <% end %>

    <%= render "admin/shared/card", title: t("admin.orders.customer") do %>
      <dl class="m-0 flex flex-col gap-3">
        <div><dt class="ad-label mb-1"><%= t("checkout.full_name") %></dt><dd class="m-0"><%= @order.name %><%= " · #{t('vene.admin.orders.guest')}" if @order.is_guest? %></dd></div>
        <div><dt class="ad-label mb-1"><%= t("activerecord.attributes.user.email") %></dt><dd class="m-0"><%= mail_to @order.email, @order.email, class: "vn-quiet" %></dd></div>
        <div><dt class="ad-label mb-1"><%= t("checkout.phone") %></dt><dd class="m-0 font-latin" dir="ltr"><%= @order.phone %></dd></div>
      </dl>
    <% end %>

    <%= render "admin/shared/card", title: t("vene.orders.deliver_to") do %>
      <address class="not-italic leading-6">
        <% if @order.street_address.present? %>
          <%= @order.street_address %><br>
          <% if @order.building.present? %><%= @order.building %><br><% end %>
          <%= [@order.city, @order.postal_code].compact_blank.join(", ") %><br>
          <%= @order.country %>
        <% else %>
          <%= @order.address_text %><br><%= @order.city %><br><%= @order.country %>
        <% end %>
      </address>
    <% end %>
  </div>
</div>
