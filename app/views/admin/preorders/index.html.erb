<%= render "admin/shared/top_bar", title: t("vene.admin.nav.preorders"), crumb: t("vene.admin.nav.sales"), subtitle: t("admin.preorders.subtitle") %>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("vene.orders.order_label") %></th>
          <th scope="col"><%= t("admin.preorders.customer") %></th>
          <th scope="col"><%= t("admin.preorders.product") %></th>
          <th scope="col"><%= t("admin.preorders.quantity") %></th>
          <th scope="col"><%= t("admin.preorders.est_delivery") %></th>
          <th scope="col"><%= t("admin.preorders.order_status") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @preorder_items.any? %>
          <% @preorder_items.each do |item| %>
            <tr>
              <td><%= link_to "##{item.order.id}", admin_order_path(item.order, locale: I18n.locale), class: "vn-link ad-mono" %></td>
              <td><span class="flex flex-col"><span><%= item.order.name %></span><span class="ad-hint"><%= item.order.email %></span></span></td>
              <td><span class="flex flex-col"><span class="font-display text-lg leading-6"><%= item.product.name(I18n.locale) %></span><% if item.product_variant %><span class="ad-hint"><%= item.variant_display_name %></span><% end %></span></td>
              <td class="font-latin"><%= item.quantity %></td>
              <td class="whitespace-nowrap"><%= item.preorder_estimated_delivery_date ? l(item.preorder_estimated_delivery_date, format: :long) : tag.span(t("admin.preorders.not_specified"), class: "ad-off") %></td>
              <td><span class="vn-badge vn-badge--<%= vn_status_tone(item.order.status) %>"><%= vn_status_label(item.order.status) %></span></td>
              <td class="!text-end"><%= link_to t("admin.preorders.view_order"), admin_order_path(item.order, locale: I18n.locale), class: "ad-textbtn" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="7" class="!py-12 text-center ad-muted"><%= t("admin.preorders.no_preorders_subtitle") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %><div class="px-5 py-4 border-t border-line"><%== pagy_nav(@pagy) %></div><% end %>
</div>
