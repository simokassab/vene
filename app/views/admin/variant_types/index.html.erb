<%= render "admin/shared/top_bar", title: t("admin.variant_types.title"), crumb: t("vene.admin.nav.catalog"), subtitle: t("admin.variant_types.subtitle") do %>
  <%= link_to new_admin_variant_type_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" do %><%= vn_icon(:plus, size: 16) %><span><%= t("admin.variant_types.new") %></span><% end %>
<% end %>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.variant_types.name") %></th>
          <th scope="col"><%= t("admin.variant_types.options") %></th>
          <th scope="col"><%= t("admin.variant_types.status") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @variant_types.any? %>
          <% @variant_types.each do |variant_type| %>
            <tr>
              <td>
                <span class="flex flex-col">
                  <%= link_to variant_type.name, edit_admin_variant_type_path(variant_type, locale: I18n.locale), class: "vn-quiet !text-ink font-display text-lg leading-6" %>
                  <% if variant_type.description.present? %><span class="ad-hint"><%= variant_type.description %></span><% end %>
                </span>
              </td>
              <td>
                <span class="flex flex-wrap gap-1.5">
                  <% variant_type.variant_options.active.ordered.limit(5).each do |option| %>
                    <span class="vn-badge vn-badge--outline !tracking-wide font-latin"><%= option.value %></span>
                  <% end %>
                  <% if variant_type.variant_options.count > 5 %>
                    <span class="ad-hint self-center"><%= t("admin.variant_types.more_options", count: variant_type.variant_options.count - 5) %></span>
                  <% end %>
                </span>
              </td>
              <td><span class="vn-status <%= variant_type.active ? 'vn-status--ok' : 'vn-status--off' %>"><%= variant_type.active ? t("common.active") : t("common.inactive") %></span></td>
              <td class="!text-end whitespace-nowrap">
                <%= link_to t("admin.actions.edit"), edit_admin_variant_type_path(variant_type, locale: I18n.locale), class: "ad-textbtn" %>
                <span class="mx-2 ad-off" aria-hidden="true">·</span>
                <%= link_to t("admin.actions.delete"), admin_variant_type_path(variant_type, locale: I18n.locale), class: "ad-textbtn !text-danger",
                      data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="4" class="!py-12 text-center ad-muted"><%= t("admin.variant_types.no_variant_types") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %><div class="px-5 py-4 border-t border-line"><%== pagy_nav(@pagy) %></div><% end %>
</div>
