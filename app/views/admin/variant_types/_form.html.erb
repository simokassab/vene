<% tf = "vene.admin.product_form" %>
<% vf = "vene.admin.variant_form" %>
<%= form_with(model: [:admin, @variant_type], data: { turbo: false }) do |form| %>
  <%= render "shared/vene/form_errors", record: @variant_type, title: t("#{tf}.fix") %>
  <div class="flex flex-wrap items-start gap-6 mt-2">
    <div class="flex-[999_1_480px] min-w-0 flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.details") do %>
        <div class="ad-grid-2">
          <div class="ad-field"><%= form.label :name, t("admin.variant_types.name"), class: "ad-label" %><%= form.text_field :name, class: "ad-input", placeholder: t("#{vf}.name_placeholder") %></div>
          <div class="ad-field col-span-full"><%= form.label :description, t("#{vf}.description"), class: "ad-label" %><%= form.text_area :description, rows: 2, class: "ad-textarea" %></div>
        </div>
      <% end %>

      <%# New options get a stable key when added, so their nested-attribute names do not change on re-render. %>
      <section class="ad-card" x-data="{ newOptions: [],
                                        addOption() { this.newOptions.push({ key: Date.now(), value: '', position: this.newOptions.length, active: true }) },
                                        removeNewOption(index) { this.newOptions.splice(index, 1) } }">
        <header class="flex flex-col gap-1 mb-5">
          <h2 class="ad-h2"><%= t("admin.variant_types.options") %></h2>
          <p class="m-0 ad-hint"><%= t("#{vf}.options_text") %></p>
        </header>
        <div class="flex flex-col">
          <div class="grid grid-cols-[minmax(0,3fr)_minmax(0,1fr)_auto_auto] gap-x-4 pb-2 border-b border-ink ad-label" aria-hidden="true">
            <span><%= t("#{vf}.value") %></span><span><%= t("#{vf}.order") %></span><span><%= t("#{tf}.active") %></span><span></span>
          </div>
          <%= form.fields_for :variant_options do |option_form| %>
            <div class="grid grid-cols-[minmax(0,3fr)_minmax(0,1fr)_auto_auto] gap-x-4 items-center py-2 border-b border-line" x-data="{ show: true }" x-show="show">
              <%= option_form.hidden_field :id %>
              <%= option_form.hidden_field :_destroy, value: "0", class: "destroy-field" %>
              <%= option_form.text_field :value, class: "ad-input font-latin", "aria-label": t("#{vf}.value") %>
              <%= option_form.number_field :position, class: "ad-input font-latin", "aria-label": t("#{vf}.order") %>
              <label class="vn-check !text-[13px]"><%= option_form.check_box :active %><span class="sr-only"><%= t("#{tf}.active") %></span></label>
              <button type="button" class="ad-textbtn !text-danger" @click="$el.closest('[x-data]').querySelector('.destroy-field').value = '1'; show = false"><%= t("cart.remove") %></button>
            </div>
          <% end %>
          <template x-for="(option, index) in newOptions" :key="option.key">
            <div class="grid grid-cols-[minmax(0,3fr)_minmax(0,1fr)_auto_auto] gap-x-4 items-center py-2 border-b border-line">
              <input type="text" class="ad-input font-latin" :name="`variant_type[variant_options_attributes][${option.key}][value]`" x-model="option.value" placeholder="48" aria-label="<%= t("#{vf}.value") %>">
              <input type="number" class="ad-input font-latin" :name="`variant_type[variant_options_attributes][${option.key}][position]`" x-model="option.position" aria-label="<%= t("#{vf}.order") %>">
              <label class="vn-check !text-[13px]">
                <input type="hidden" :name="`variant_type[variant_options_attributes][${option.key}][active]`" value="0">
                <input type="checkbox" :name="`variant_type[variant_options_attributes][${option.key}][active]`" x-model="option.active" value="1">
                <span class="sr-only"><%= t("#{tf}.active") %></span>
              </label>
              <button type="button" class="ad-textbtn !text-danger" @click="removeNewOption(index)"><%= t("cart.remove") %></button>
            </div>
          </template>
        </div>
        <button type="button" class="vn-btn vn-btn--outline vn-btn--sm mt-5" @click="addOption"><%= vn_icon(:plus, size: 16) %><span><%= t("#{vf}.add_option") %></span></button>
      </section>
    </div>
    <aside class="flex-[1_1_280px] min-w-0 max-w-[360px] flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.visibility") do %>
        <label class="vn-check"><%= form.check_box :active %><span><%= t("#{tf}.active") %></span></label>
      <% end %>
      <div class="ad-card flex flex-col gap-3">
        <%= form.button t("admin.actions.save"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
        <%= link_to t("common.cancel"), admin_variant_types_path(locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--block vn-btn--sm" %>
      </div>
    </aside>
  </div>
<% end %>
