<% tf = "vene.admin.product_form" %>
<%= form_with(model: [:admin, @coupon], local: true) do |form| %>
  <%= render "shared/vene/form_errors", record: @coupon, title: t("#{tf}.fix") %>
  <div class="flex flex-wrap items-start gap-6 mt-2">
    <div class="flex-[999_1_480px] min-w-0 flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("admin.coupons.basic_info") do %>
        <div class="ad-grid-2">
          <div class="ad-field"><%= form.label :code, t("admin.coupons.code"), class: "ad-label" %><%= form.text_field :code, class: "ad-input ad-mono uppercase", dir: "ltr", placeholder: "SUMMER2026", "aria-describedby": "code-hint" %><span id="code-hint" class="ad-hint"><%= t("admin.coupons.code_hint") %></span></div>
          <div class="ad-field"><%= form.label :discount_type, t("admin.coupons.discount_type"), class: "ad-label" %><%= form.select :discount_type, options_for_select([[t("admin.coupons.percentage"), "percentage"], [t("admin.coupons.fixed_amount"), "fixed"]], @coupon.discount_type), {}, class: "ad-select" %></div>
          <div class="ad-field"><%= form.label :discount_value, t("admin.coupons.discount_value"), class: "ad-label" %><%= form.number_field :discount_value, step: 0.01, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint"><%= t("admin.coupons.value_hint") %></span></div>
          <div class="ad-field"><%= form.label :min_order_amount, t("admin.coupons.min_order_amount"), class: "ad-label" %><%= form.number_field :min_order_amount, step: 0.01, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint"><%= t("admin.coupons.min_amount_hint") %></span></div>
        </div>
      <% end %>
      <%= render "admin/shared/card", title: t("admin.coupons.validity_usage") do %>
        <div class="ad-grid-2">
          <div class="ad-field"><%= form.label :valid_from, t("admin.coupons.valid_from"), class: "ad-label" %><%= form.date_field :valid_from, class: "ad-input" %><span class="ad-hint"><%= t("admin.coupons.valid_from_hint") %></span></div>
          <div class="ad-field"><%= form.label :valid_until, t("admin.coupons.valid_until"), class: "ad-label" %><%= form.date_field :valid_until, class: "ad-input" %><span class="ad-hint"><%= t("admin.coupons.valid_until_hint") %></span></div>
          <div class="ad-field"><%= form.label :usage_limit, t("admin.coupons.usage_limit"), class: "ad-label" %><%= form.number_field :usage_limit, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint"><%= t("admin.coupons.usage_limit_hint") %></span></div>
        </div>
        <label class="vn-check mt-6"><%= form.check_box :single_use_per_user %><span><%= t("admin.coupons.single_use_per_user") %><span class="vn-check__hint"><%= t("admin.coupons.single_use_hint") %></span></span></label>
      <% end %>
    </div>
    <aside class="flex-[1_1_280px] min-w-0 max-w-[360px] flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.visibility") do %>
        <label class="vn-check"><%= form.check_box :active %><span><%= t("admin.coupons.active") %><span class="vn-check__hint"><%= t("admin.coupons.active_hint") %></span></span></label>
        <% if @coupon.persisted? %>
          <dl class="m-0 mt-6 pt-5 border-t border-line grid grid-cols-[minmax(0,1fr)_auto] gap-y-2 text-[13px]">
            <dt class="ad-muted"><%= t("admin.coupons.current_usage") %></dt><dd class="m-0 font-latin"><%= @coupon.usage_count %></dd>
            <dt class="ad-muted"><%= t("admin.coupons.orders_count") %></dt><dd class="m-0 font-latin"><%= @coupon.orders.count %></dd>
          </dl>
        <% end %>
      <% end %>
      <div class="ad-card flex flex-col gap-3">
        <%= form.button t("admin.actions.save"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
        <%= link_to t("common.cancel"), admin_coupons_path(locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--block vn-btn--sm" %>
      </div>
    </aside>
  </div>
<% end %>
