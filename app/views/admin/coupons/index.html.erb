<%= render "admin/shared/top_bar", title: t("admin.coupons.title"), crumb: t("vene.admin.nav.sales"), subtitle: t("admin.coupons.subtitle") do %>
  <%= link_to new_admin_coupon_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" do %><%= vn_icon(:plus, size: 16) %><span><%= t("admin.coupons.new") %></span><% end %>
<% end %>
<div class="ad-card mb-6">
  <%= search_form_for [:admin, @q], html: { class: "flex flex-wrap items-end gap-x-6 gap-y-4" } do |f| %>
    <div class="ad-field flex-[2_1_200px]"><%= f.label :code_cont, t("admin.coupons.search_code"), class: "ad-label" %><%= f.search_field :code_cont, class: "ad-input ad-mono", placeholder: t("admin.coupons.search_code_placeholder") %></div>
    <div class="ad-field flex-[1_1_160px]"><%= f.label :discount_type_eq, t("admin.coupons.discount_type"), class: "ad-label" %><%= f.select :discount_type_eq, options_for_select([[t("vene.collection.all"), ""], [t("admin.coupons.percentage"), "percentage"], [t("admin.coupons.fixed_amount"), "fixed"]], @q.discount_type_eq), {}, class: "ad-select" %></div>
    <div class="ad-field flex-[1_1_160px]"><%= f.label :active_eq, t("admin.coupons.status"), class: "ad-label" %><%= f.select :active_eq, options_for_select([[t("vene.collection.all"), ""], [t("common.active"), "true"], [t("common.inactive"), "false"]], @q.active_eq), {}, class: "ad-select" %></div>
    <div class="ad-row">
      <%= f.button t("admin.actions.search"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--sm" %>
      <%= link_to t("admin.actions.reset"), admin_coupons_path(locale: I18n.locale), class: "ad-textbtn" %>
    </div>
  <% end %>
</div>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.coupons.code") %></th>
          <th scope="col"><%= t("admin.coupons.discount") %></th>
          <th scope="col"><%= t("admin.coupons.valid_dates") %></th>
          <th scope="col"><%= t("admin.coupons.usage") %></th>
          <th scope="col"><%= t("admin.coupons.status") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @coupons.any? %>
          <% @coupons.each do |coupon| %>
            <tr>
              <td><%= link_to coupon.code, edit_admin_coupon_path(coupon, locale: I18n.locale), class: "vn-link ad-mono" %></td>
              <td><span class="flex flex-col"><bdi class="font-latin"><%= coupon.discount_display %></bdi><span class="ad-hint"><%= coupon.discount_type == "percentage" ? t("admin.coupons.percentage") : t("admin.coupons.fixed_amount") %></span></span></td>
              <td class="ad-muted whitespace-nowrap">
                <% if coupon.valid_from || coupon.valid_until %>
                  <%= l(coupon.valid_from, format: :short) if coupon.valid_from %><%= " – " if coupon.valid_from && coupon.valid_until %><%= l(coupon.valid_until, format: :short) if coupon.valid_until %>
                <% else %>
                  <span class="ad-off"><%= t("vene.admin.coupons.always") %></span>
                <% end %>
              </td>
              <td><span class="flex flex-col"><span class="font-latin"><%= coupon.usage_count %><%= " / #{coupon.usage_limit}" if coupon.usage_limit %></span><% if coupon.single_use_per_user %><span class="ad-hint"><%= t("admin.coupons.single_use") %></span><% end %></span></td>
              <td><span class="vn-status <%= coupon.active? ? 'vn-status--ok' : 'vn-status--off' %>"><%= coupon.active? ? t("common.active") : t("common.inactive") %></span></td>
              <td class="!text-end whitespace-nowrap">
                <%= link_to t("admin.actions.edit"), edit_admin_coupon_path(coupon, locale: I18n.locale), class: "ad-textbtn" %>
                <span class="mx-2 ad-off" aria-hidden="true">·</span>
                <%= link_to t("admin.actions.delete"), admin_coupon_path(coupon, locale: I18n.locale), class: "ad-textbtn !text-danger",
                      data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="!py-12 text-center ad-muted"><%= t("admin.coupons.no_coupons") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
