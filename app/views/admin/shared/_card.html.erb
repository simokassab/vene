<%
  # Card (ad-card). Usage: render 'admin/shared/card', title: 'Card Title', padding: true do … end
  title ||= nil
  subtitle ||= nil
  padding = true if local_assigns[:padding].nil?
  actions ||= nil
%>
<section class="ad-card <%= '!p-0' unless padding %>">
  <% if title %>
    <header class="flex flex-wrap items-start justify-between gap-4 <%= padding ? 'mb-5' : 'px-6 pt-6 mb-5' %>">
      <div class="flex flex-col gap-1">
        <h2 class="ad-h2"><%= title %></h2>
        <% if subtitle %><p class="m-0 ad-hint"><%= subtitle %></p><% end %>
      </div>
      <% if actions %><div class="ad-row"><%= actions %></div><% end %>
    </header>
  <% end %>
  <%= yield %>
</section>
