<%
  # Button (Vene.Button). Usage: render 'admin/shared/button', text: 'Save', type: 'primary', href: nil, method: nil, data: {}
  type ||= 'primary'
  size ||= 'md'
  icon ||= nil
  href ||= nil
  method ||= nil
  data ||= {}
  full_width ||= false
  disabled ||= false
  button_type ||= 'button'
  variant = { 'primary' => 'primary', 'secondary' => 'outline', 'success' => 'primary', 'danger' => 'danger', 'outline' => 'outline', 'ghost' => 'link' }.fetch(type, 'primary')
  classes = ["vn-btn", "vn-btn--#{variant}", ("vn-btn--sm" unless size == 'lg'), ("vn-btn--block" if full_width)].compact.join(' ')
%>
<% if href %>
  <%= link_to href, class: classes, data: data.merge(method ? { turbo_method: method } : {}), "aria-disabled": (disabled ? "true" : nil) do %>
    <% if icon %><span aria-hidden="true"><%= icon %></span><% end %><span><%= text %></span>
  <% end %>
<% else %>
  <%= button_tag type: button_type, class: classes, disabled: disabled, data: data do %>
    <% if icon %><span aria-hidden="true"><%= icon %></span><% end %><span><%= text %></span>
  <% end %>
<% end %>
