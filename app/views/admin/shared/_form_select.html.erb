<%
  # Form select (ad-field). Usage: render 'admin/shared/form_select', form: f, field: :category_id, label: 'Category', options: categories, required: true
  required ||= false
  help_text ||= nil
  error ||= nil
  prompt ||= nil
  multiple ||= false
  include_blank ||= false
%>
<div class="ad-field mb-5 <%= 'ad-field--error' if error %>">
  <% if label %><%= form.label field, class: "ad-label" do %><%= label %><% if required %><span aria-hidden="true" class="ad-warn"> *</span><% end %><% end %><% end %>
  <%= form.select field, options, { prompt: prompt, include_blank: include_blank }, { class: (multiple ? "ad-input !h-auto py-2" : "ad-select"), required: required, multiple: multiple } %>
  <% if help_text %><span class="ad-hint"><%= help_text %></span><% end %>
  <% if error %><span class="ad-error"><%= error %></span><% end %>
</div>
