<%
  # Stat card (StatCard). Usage: render 'admin/shared/stat_card', title: 'Total sales', value: '$12,345', trend: '+12%', trend_direction: 'up'
  # icon and color are accepted for compatibility; the VENÈ stat card carries no emoji or colour fill.
  title ||= ''
  value ||= '0'
  trend ||= nil
  trend_direction ||= 'neutral'
%>
<div class="ad-stat">
  <span class="ad-label"><%= title %></span>
  <span class="ad-stat__value"><bdi><%= value %></bdi></span>
  <% if trend %>
    <span class="vn-status <%= { 'up' => 'vn-status--ok', 'down' => 'vn-status--bad' }.fetch(trend_direction, 'vn-status--off') %>"><%= trend %></span>
  <% end %>
</div>
