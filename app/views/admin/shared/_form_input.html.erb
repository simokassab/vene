<%
  # Form input (ad-field). Usage: render 'admin/shared/form_input', form: f, field: :name, label: 'Product name', type: 'text', required: true
  type ||= 'text'
  required ||= false
  placeholder ||= ''
  help_text ||= nil
  error ||= nil
  icon ||= nil
  disabled ||= false
  hint_id = "#{form.object_name}_#{field}_hint" if help_text || error
%>
<div class="ad-field mb-5 <%= 'ad-field--error' if error %>">
  <% if label %><%= form.label field, class: "ad-label" do %><%= label %><% if required %><span aria-hidden="true" class="ad-warn"> *</span><% end %><% end %><% end %>
  <%= form.send("#{type}_field", field, class: "ad-input", placeholder: placeholder, required: required, disabled: disabled,
        "aria-invalid": (error ? "true" : nil), "aria-describedby": hint_id) %>
  <% if help_text %><span id="<%= hint_id %>" class="ad-hint"><%= help_text %></span><% end %>
  <% if error %><span id="<%= hint_id %>" class="ad-error"><%= error %></span><% end %>
</div>
