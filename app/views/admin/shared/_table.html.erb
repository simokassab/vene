<%
  # Table (ad-table). Usage: render 'admin/shared/table', headers: ['Name', 'Price'], actions: true do <tr>…</tr> end
  headers ||= []
  searchable = false if local_assigns[:searchable].nil?
  actions_header ||= t('common.actions', default: 'Actions')
%>
<div class="ad-card !p-0">
  <% if searchable %>
    <div class="p-4 border-b border-line" x-data="{ search: '' }">
      <label class="sr-only" for="table-search"><%= t('admin.actions.search') %></label>
      <input id="table-search" type="search" x-model="search" class="ad-input" placeholder="<%= t('admin.actions.search') %>">
    </div>
  <% end %>
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <% headers.each do |header| %><th scope="col"><%= header %></th><% end %>
          <% if defined?(actions) && actions %><th scope="col" class="!text-end"><%= actions_header %></th><% end %>
        </tr>
      </thead>
      <tbody><%= yield %></tbody>
    </table>
  </div>
  <% if defined?(pagination) && pagination %>
    <div class="px-6 py-4 border-t border-line"><%= pagination %></div>
  <% end %>
</div>
