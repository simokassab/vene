<%
  # Form textarea (ad-field). Usage: render 'admin/shared/form_textarea', form: f, field: :description, label: 'Description', rows: 4, required: true
  required ||= false
  placeholder ||= ''
  help_text ||= nil
  error ||= nil
  rows ||= 4
%>
<div class="ad-field mb-5 <%= 'ad-field--error' if error %>">
  <% if label %><%= form.label field, class: "ad-label" do %><%= label %><% if required %><span aria-hidden="true" class="ad-warn"> *</span><% end %><% end %><% end %>
  <%= form.text_area field, class: "ad-textarea", placeholder: placeholder, required: required, rows: rows %>
  <% if help_text %><span class="ad-hint"><%= help_text %></span><% end %>
  <% if error %><span class="ad-error"><%= error %></span><% end %>
</div>
