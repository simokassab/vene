<%
  # Badge: a square-cut status label (Badge / StatusPill).
  # Usage: render 'admin/shared/badge', text: 'Active', type: 'success'
  type ||= 'default'
  size ||= 'md'
  tone = { 'default' => 'outline', 'primary' => 'noir', 'success' => 'noir', 'warning' => 'gold', 'danger' => 'danger', 'info' => 'outline' }.fetch(type, 'outline')
%>
<span class="vn-badge vn-badge--<%= tone %>"><%= text %></span>
