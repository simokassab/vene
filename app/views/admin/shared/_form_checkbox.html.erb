<%
  # Form checkbox. Usage: render 'admin/shared/form_checkbox', form: f, field: :active, label: 'Active', help_text: '…'
  help_text ||= nil
  checked ||= false
%>
<label class="vn-check mb-4">
  <%= form.check_box field, checked: checked %>
  <span><%= label %><% if help_text %><span class="vn-check__hint"><%= help_text %></span><% end %></span>
</label>
