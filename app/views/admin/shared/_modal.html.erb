<%
  # Modal (Alpine). Usage: render 'admin/shared/modal', id: 'delete-modal', title: 'Confirm delete', size: 'sm' do … end
  # Open with: $dispatch('open-modal-<id>')
  id ||= 'modal'
  title ||= ''
  size ||= 'md'
  close_text ||= t('common.cancel', default: 'Cancel')
  width = { 'sm' => 'max-w-md', 'md' => 'max-w-lg', 'lg' => 'max-w-2xl', 'xl' => 'max-w-4xl' }.fetch(size, 'max-w-lg')
%>
<div x-data="{ open: false }" @open-modal-<%= id %>.window="open = true" @keydown.escape.window="open = false"
     x-show="open" x-cloak class="fixed inset-0 z-50 overflow-y-auto">
  <div class="fixed inset-0 bg-ink/60" @click="open = false" x-show="open" x-transition.opacity.duration.300ms></div>
  <div class="flex min-h-screen items-center justify-center p-4">
    <div class="relative w-full <%= width %> bg-surface-raised shadow-lift" role="dialog" aria-modal="true" aria-labelledby="modal-<%= id %>-title"
         @click.outside="open = false" x-show="open" x-transition.opacity.duration.300ms>
      <div class="flex items-center justify-between gap-4 px-6 py-4 border-b border-line">
        <h3 id="modal-<%= id %>-title" class="ad-h2"><%= title %></h3>
        <button type="button" class="ad-iconbtn" @click="open = false" aria-label="<%= t('common.close') %>"><%= vn_icon(:close, size: 18) %></button>
      </div>
      <div class="px-6 py-5"><%= yield %></div>
      <% if defined?(actions) && actions %>
        <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-line">
          <button type="button" class="vn-btn vn-btn--outline vn-btn--sm" @click="open = false"><%= close_text %></button>
          <%= actions %>
        </div>
      <% end %>
    </div>
  </div>
</div>
