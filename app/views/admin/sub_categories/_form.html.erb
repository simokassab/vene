<% tf = "vene.admin.product_form" %>
<%= form_with(model: [:admin, @sub_category], local: true) do |form| %>
  <%= render "shared/vene/form_errors", record: @sub_category, title: t("#{tf}.fix") %>
  <div class="flex flex-wrap items-start gap-6 mt-2">
    <div class="flex-[999_1_480px] min-w-0 flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.details") do %>
        <div class="ad-grid-2">
          <div class="ad-field"><%= form.label :name_en, t("#{tf}.name_en"), class: "ad-label" %><%= form.text_field :name_en, required: true, class: "ad-input", dir: "ltr" %></div>
          <div class="ad-field"><%= form.label :name_ar, t("#{tf}.name_ar"), class: "ad-label" %><%= form.text_field :name_ar, required: true, class: "ad-input", dir: "rtl", lang: "ar" %></div>
          <div class="ad-field col-span-full"><%= form.label :description_en, t("#{tf}.description_en"), class: "ad-label" %><%= form.text_area :description_en, rows: 3, class: "ad-textarea", dir: "ltr" %></div>
          <div class="ad-field col-span-full"><%= form.label :description_ar, t("#{tf}.description_ar"), class: "ad-label" %><%= form.text_area :description_ar, rows: 3, class: "ad-textarea", dir: "rtl", lang: "ar" %></div>
          <div class="ad-field"><%= form.label :slug, t("#{tf}.slug"), class: "ad-label" %><%= form.text_field :slug, class: "ad-input ad-mono", dir: "ltr" %><span class="ad-hint"><%= t("#{tf}.slug_hint") %></span></div>
          <div class="ad-field"><%= form.label :position, t("vene.admin.common.position"), class: "ad-label" %><%= form.number_field :position, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint"><%= t("vene.admin.common.position_hint") %></span></div>
        </div>
      <% end %>
      <%= render "admin/shared/card", title: t("vene.admin.common.image"), subtitle: t("vene.admin.common.mega_menu_hint") do %>
        <div class="ad-field"><%= form.label :image, t("vene.admin.common.upload_image"), class: "ad-label" %><%= form.file_field :image, accept: "image/*", class: "ad-input" %></div>
        <% if @sub_category.image? %>
          <div class="mt-5 flex items-end gap-4">
            <div class="w-56 aspect-[4/3] bg-media shadow-hairline overflow-hidden"><%= image_tag @sub_category.image.url, alt: "", class: "w-full h-full object-cover" %></div>
            <div class="flex flex-col gap-1"><div class="w-24 h-24 bg-media shadow-hairline overflow-hidden"><%= image_tag @sub_category.image.mega_menu.url, alt: "", class: "w-full h-full object-cover" %></div><span class="ad-hint"><%= t("vene.admin.common.mega_menu") %></span></div>
          </div>
        <% end %>
      <% end %>
    </div>
    <aside class="flex-[1_1_280px] min-w-0 max-w-[360px] flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.placement") do %>
        <div class="ad-field">
          <%= form.label :category_id, t("admin.sub_categories.category"), class: "ad-label" %>
          <%= form.collection_select :category_id, @categories, :id, :name_en, { prompt: t("vene.admin.common.choose_category") }, class: "ad-select" %>
        </div>
      <% end %>
      <%= render "admin/shared/card", title: t("#{tf}.visibility") do %>
        <label class="vn-check"><%= form.check_box :active %><span><%= t("#{tf}.active") %><span class="vn-check__hint"><%= t("#{tf}.active_hint") %></span></span></label>
      <% end %>
      <div class="ad-card flex flex-col gap-3">
        <%= form.button t("admin.actions.save"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
        <%= link_to t("common.cancel"), admin_sub_categories_path(locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--block vn-btn--sm" %>
      </div>
    </aside>
  </div>
<% end %>
