<%= render "admin/shared/top_bar", title: t("admin.sub_categories.title"), crumb: t("vene.admin.nav.catalog") do %>
  <%= link_to new_admin_sub_category_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" do %><%= vn_icon(:plus, size: 16) %><span><%= t("admin.sub_categories.new") %></span><% end %>
<% end %>
<div class="ad-card mb-6">
  <%= search_form_for [:admin, @q], url: admin_sub_categories_path(locale: I18n.locale), html: { class: "flex flex-wrap items-end gap-x-6 gap-y-4" } do |f| %>
    <div class="ad-field flex-[2_1_220px]">
      <%= f.label :name_en_cont, t("admin.sub_categories.search_name"), class: "ad-label" %>
      <%= f.search_field :name_en_cont, class: "ad-input", placeholder: t("admin.sub_categories.search_placeholder") %>
    </div>
    <div class="ad-field flex-[1_1_200px]">
      <%= f.label :category_id_eq, t("admin.sub_categories.filter_category"), class: "ad-label" %>
      <%= f.collection_select :category_id_eq, Category.ordered, :id, :name_en, { include_blank: t("admin.sub_categories.all_categories") }, class: "ad-select" %>
    </div>
    <div class="ad-row">
      <%= f.button t("admin.actions.search"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--sm" %>
      <%= link_to t("admin.actions.reset"), admin_sub_categories_path(locale: I18n.locale), class: "ad-textbtn" %>
    </div>
  <% end %>
</div>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("admin.sub_categories.name") %></th>
          <th scope="col"><%= t("admin.sub_categories.category") %></th>
          <th scope="col"><%= t("admin.sub_categories.slug") %></th>
          <th scope="col"><%= t("admin.sub_categories.position") %></th>
          <th scope="col"><%= t("admin.sub_categories.status") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @sub_categories.any? %>
          <% @sub_categories.each do |sub_category| %>
            <tr>
              <td>
                <span class="flex items-center gap-3">
                  <span class="ad-thumb"><% if sub_category.image? %><%= image_tag sub_category.image.url, alt: "", class: "!w-full !h-full !object-cover" %><% end %></span>
                  <span class="flex flex-col">
                    <%= link_to sub_category.name_en, edit_admin_sub_category_path(sub_category, locale: I18n.locale), class: "vn-quiet !text-ink font-display text-lg leading-6" %>
                    <span class="ad-hint" lang="ar" dir="rtl"><%= sub_category.name_ar %></span>
                  </span>
                </span>
              </td>
              <td><%= sub_category.category&.name_en %></td>
              <td class="ad-mono ad-muted"><%= sub_category.slug %></td>
              <td class="font-latin"><%= sub_category.position %></td>
              <td><span class="vn-status <%= sub_category.active? ? 'vn-status--ok' : 'vn-status--off' %>"><%= sub_category.active? ? t("common.active") : t("common.inactive") %></span></td>
              <td class="!text-end whitespace-nowrap">
                <%= link_to t("admin.actions.edit"), edit_admin_sub_category_path(sub_category, locale: I18n.locale), class: "ad-textbtn" %>
                <span class="mx-2 ad-off" aria-hidden="true">·</span>
                <%= link_to t("admin.actions.delete"), admin_sub_category_path(sub_category, locale: I18n.locale), class: "ad-textbtn !text-danger",
                      data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="!py-12 text-center ad-muted"><%= t("admin.sub_categories.no_items") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy.pages > 1 %><div class="px-5 py-4 border-t border-line"><%== pagy_nav(@pagy) %></div><% end %>
</div>
