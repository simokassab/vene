<% tf = "vene.admin.product_form" %>
<% bf = "vene.admin.banner_form" %>
<%= form_with(model: [:admin, @banner], local: true) do |form| %>
  <%= render "shared/vene/form_errors", record: @banner, title: t("#{tf}.fix") %>
  <div class="flex flex-wrap items-start gap-6 mt-2">
    <div class="flex-[999_1_480px] min-w-0 flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{bf}.copy"), subtitle: t("#{bf}.copy_hint") do %>
        <div class="ad-grid-2">
          <div class="ad-field"><%= form.label :title_en, t("#{bf}.title_en"), class: "ad-label" %><%= form.text_field :title_en, class: "ad-input", dir: "ltr" %></div>
          <div class="ad-field"><%= form.label :title_ar, t("#{bf}.title_ar"), class: "ad-label" %><%= form.text_field :title_ar, class: "ad-input", dir: "rtl", lang: "ar" %></div>
          <div class="ad-field"><%= form.label :subtitle_en, t("#{bf}.subtitle_en"), class: "ad-label" %><%= form.text_field :subtitle_en, class: "ad-input", dir: "ltr" %></div>
          <div class="ad-field"><%= form.label :subtitle_ar, t("#{bf}.subtitle_ar"), class: "ad-label" %><%= form.text_field :subtitle_ar, class: "ad-input", dir: "rtl", lang: "ar" %></div>
        </div>
      <% end %>
      <%= render "admin/shared/card", title: t("#{bf}.link"), subtitle: t("#{bf}.link_hint") do %>
        <div class="ad-grid-2">
          <div class="ad-field"><%= form.label :product_id, t("admin.banners.product"), class: "ad-label" %><%= form.collection_select :product_id, Product.all, :id, :name_en, { include_blank: t("#{bf}.no_product") }, class: "ad-select" %></div>
          <div class="ad-field"><%= form.label :url, t("#{bf}.url"), class: "ad-label" %><%= form.text_field :url, class: "ad-input ad-mono", dir: "ltr", placeholder: "/en/categories/rings" %></div>
        </div>
      <% end %>
      <%= render "admin/shared/card", title: t("vene.admin.common.image"), subtitle: t("#{bf}.image_hint") do %>
        <div class="ad-field"><%= form.label :image, t("vene.admin.common.upload_image"), class: "ad-label" %><%= form.file_field :image, accept: "image/*", class: "ad-input" %></div>
        <% if @banner.image? %>
          <%# The hero shows the photo in a near-square box: preview that crop while the focus moves. %>
          <div class="mt-5 flex flex-wrap items-end gap-6" x-data="{ focus: <%= @banner.image_focus.to_i %> }">
            <div class="w-56 aspect-[6/7] bg-media shadow-hairline overflow-hidden">
              <%= image_tag @banner.image.url, alt: "", class: "w-full h-full object-cover", ":style": "`object-position: ${focus}% 50%`" %>
            </div>
            <div class="ad-field flex-1 min-w-[200px]">
              <%= form.label :image_focus, t("#{bf}.image_focus"), class: "ad-label" %>
              <%= form.range_field :image_focus, in: 0..100, step: 1, class: "w-full", "x-model.number": "focus", dir: "ltr" %>
              <div class="flex justify-between ad-hint" dir="ltr"><span><%= t("#{bf}.focus_left") %></span><span class="font-latin" x-text="`${focus}%`"></span><span><%= t("#{bf}.focus_right") %></span></div>
              <span class="ad-hint"><%= t("#{bf}.image_focus_hint") %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
    <aside class="flex-[1_1_280px] min-w-0 max-w-[360px] flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.visibility") do %>
        <label class="vn-check mb-5"><%= form.check_box :active %><span><%= t("#{tf}.active") %></span></label>
        <div class="ad-field"><%= form.label :position, t("vene.admin.common.position"), class: "ad-label" %><%= form.number_field :position, class: "ad-input font-latin", dir: "ltr" %><span class="ad-hint"><%= t("vene.admin.common.position_hint") %></span></div>
      <% end %>
      <div class="ad-card flex flex-col gap-3">
        <%= form.button t("admin.actions.save"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
        <%= link_to t("common.cancel"), admin_banners_path(locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--block vn-btn--sm" %>
      </div>
    </aside>
  </div>
<% end %>
