<%= render "admin/shared/top_bar", title: t("admin.banners.title"), crumb: t("vene.admin.nav.storefront") do %>
  <%= link_to new_admin_banner_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" do %><%= vn_icon(:plus, size: 16) %><span><%= t("admin.banners.new") %></span><% end %>
<% end %>
<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("vene.admin.common.image") %></th>
          <th scope="col"><%= t("admin.banners.title_label") %></th>
          <th scope="col"><%= t("vene.admin.common.position") %></th>
          <th scope="col"><%= t("vene.admin.common.status") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @banners.any? %>
          <% @banners.each do |banner| %>
            <tr>
              <td><span class="block w-32 aspect-[12/5] bg-media shadow-hairline overflow-hidden"><% if banner.image? %><%= image_tag banner.image.url, alt: "", class: "w-full h-full object-cover" %><% end %></span></td>
              <td>
                <span class="flex flex-col">
                  <%= link_to banner.title_en.presence || "—", edit_admin_banner_path(banner, locale: I18n.locale), class: "vn-quiet !text-ink font-display text-lg leading-6" %>
                  <span class="ad-hint" lang="ar" dir="rtl"><%= banner.title_ar %></span>
                </span>
              </td>
              <td class="font-latin"><%= banner.position || "—" %></td>
              <td><span class="vn-status <%= banner.active? ? 'vn-status--ok' : 'vn-status--off' %>"><%= banner.active? ? t("common.active") : t("common.inactive") %></span></td>
              <td class="!text-end whitespace-nowrap">
                <%= link_to t("admin.actions.edit"), edit_admin_banner_path(banner, locale: I18n.locale), class: "ad-textbtn" %>
                <span class="mx-2 ad-off" aria-hidden="true">·</span>
                <%= link_to t("admin.actions.delete"), admin_banner_path(banner, locale: I18n.locale), class: "ad-textbtn !text-danger",
                      data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="5" class="!py-12 text-center ad-muted"><%= t("vene.admin.common.empty") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
