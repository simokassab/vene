<%= render "admin/shared/top_bar", title: @product.name_en, crumb: t("admin.products.title"), crumb_href: admin_products_path(locale: I18n.locale),
      badge: (@product.active? ? t("common.active") : t("common.inactive")), badge_tone: (@product.active? ? "noir" : "outline") do %>
  <%= link_to t("admin.actions.edit"), edit_admin_product_path(@product, locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" %>
  <%= link_to t("admin.actions.delete"), admin_product_path(@product, locale: I18n.locale), class: "vn-btn vn-btn--danger vn-btn--sm",
        data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
<% end %>
<div class="flex flex-wrap items-start gap-6">
  <div class="flex-[999_1_480px] min-w-0">
    <%= render "admin/shared/card", title: t("vene.admin.product_form.details") do %>
      <dl class="m-0 ad-grid-2">
        <div><dt class="ad-label mb-1"><%= t("admin.products.category") %></dt><dd class="m-0"><%= @product.category&.name_en || "—" %></dd></div>
        <div><dt class="ad-label mb-1"><%= t("admin.products.price") %></dt><dd class="m-0"><%= render "shared/product_price", product: @product %></dd></div>
        <% %i[metal diamonds gemstones].each do |field| %>
          <div><dt class="ad-label mb-1"><%= t("products.#{field}") %></dt><dd class="m-0"><%= @product.public_send(field).presence || "—" %></dd></div>
        <% end %>
        <div class="col-span-full"><dt class="ad-label mb-1">EN</dt><dd class="m-0 ad-muted"><%= @product.description_en %></dd></div>
        <div class="col-span-full" lang="ar" dir="rtl"><dt class="ad-label mb-1">AR</dt><dd class="m-0 ad-muted"><%= @product.description_ar %></dd></div>
      </dl>
    <% end %>
  </div>
  <div class="flex-[1_1_320px] min-w-0">
    <%= render "admin/shared/card", title: t("admin.products.images") do %>
      <ul class="list-none m-0 p-0 grid grid-cols-2 gap-3">
        <% @product.product_images.each do |img| %>
          <li class="aspect-square bg-media shadow-hairline flex items-center justify-center"><%= image_tag img.image.url, alt: "", class: "w-[88%] h-[88%] object-contain" if img.image? %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
