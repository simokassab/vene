<%# AdminProducts.dc.html: ransack filters on one quiet row, then the catalogue with a
    thumbnail, price (sale shown struck), stock and flags. %>
<%= render "admin/shared/top_bar", title: t("admin.products.title"), crumb: t("vene.admin.nav.catalog") do %>
  <%= link_to new_admin_product_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" do %>
    <%= vn_icon(:plus, size: 16) %><span><%= t("admin.products.new") %></span>
  <% end %>
<% end %>

<div class="ad-card mb-6">
  <%= search_form_for @q, url: admin_products_path(locale: I18n.locale), method: :get, html: { class: "flex flex-wrap items-end gap-x-6 gap-y-4" } do |f| %>
    <div class="ad-field flex-[2_1_220px]">
      <%= f.label :name_en_or_name_ar_cont, t("vene.admin.products.search"), class: "ad-label" %>
      <%= f.search_field :name_en_or_name_ar_cont, placeholder: t("vene.admin.products.search_placeholder"), class: "ad-input" %>
    </div>
    <div class="ad-field flex-[1_1_180px]">
      <%= f.label :sub_category_id_eq, t("vene.admin.nav.subcategories"), class: "ad-label" %>
      <%= f.select :sub_category_id_eq,
            grouped_options_for_select(
              Category.active.ordered.map { |cat| [cat.name_en, cat.sub_categories.active.ordered.map { |sc| [sc.name_en, sc.id] }] },
              params.dig(:q, :sub_category_id_eq)
            ),
            { include_blank: t("vene.admin.products.all_subcategories") }, class: "ad-select" %>
    </div>
    <div class="ad-field flex-[1_1_140px]">
      <%= f.label :featured_eq, t("vene.admin.products.featured"), class: "ad-label" %>
      <%= f.select :featured_eq, [[t("vene.collection.all"), ""], [t("vene.admin.common.yes_label"), true], [t("vene.admin.common.no_label"), false]], {}, class: "ad-select" %>
    </div>
    <div class="ad-field flex-[1_1_140px]">
      <%= f.label :on_sale_eq, t("vene.admin.products.on_sale"), class: "ad-label" %>
      <%= f.select :on_sale_eq, [[t("vene.collection.all"), ""], [t("vene.admin.common.yes_label"), true], [t("vene.admin.common.no_label"), false]], {}, class: "ad-select" %>
    </div>
    <div class="ad-row">
      <%= f.button t("admin.actions.search"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--sm" %>
      <%= link_to t("admin.actions.reset"), admin_products_path(locale: I18n.locale), class: "ad-textbtn" %>
    </div>
  <% end %>
</div>

<div class="ad-card !p-0">
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= sort_link(@q, :name_en, t("admin.products.name"), class: "vn-quiet") %></th>
          <th scope="col"><%= sort_link(@q, :category_id, t("admin.products.category"), class: "vn-quiet") %></th>
          <th scope="col"><%= sort_link(@q, :price, t("admin.products.price"), class: "vn-quiet") %></th>
          <th scope="col"><%= sort_link(@q, :stock_quantity, t("vene.admin.products.stock"), class: "vn-quiet") %></th>
          <th scope="col"><%= sort_link(@q, :featured, t("vene.admin.products.featured"), class: "vn-quiet") %></th>
          <th scope="col"><%= sort_link(@q, :on_sale, t("vene.admin.products.on_sale"), class: "vn-quiet") %></th>
          <th scope="col"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @products.any? %>
          <% variant_summaries = admin_variant_summaries(@products) %>
          <% variant_stock = admin_variant_stock(@products) %>
          <% @products.each do |product| %>
            <tr>
              <td>
                <span class="flex items-center gap-3">
                  <span class="ad-thumb"><% if (src = vn_product_image_url(product, version: :thumb)) %><%= image_tag src, alt: "" %><% end %></span>
                  <span class="flex flex-col min-w-0">
                    <%= link_to product.name_en, edit_admin_product_path(product, locale: I18n.locale), class: "vn-quiet !text-ink font-display text-lg leading-6" %>
                    <span class="ad-hint" lang="ar" dir="rtl"><%= product.name_ar %></span>
                    <% if (summary = variant_summaries[product.id]) %><span class="ad-hint"><%= summary %></span><% end %>
                  </span>
                  <% if product.made_to_order? %><span class="vn-badge vn-badge--gold"><%= t("products.made_to_order_badge") %></span><% end %>
                </span>
              </td>
              <td><%= product.category&.name(I18n.locale) || "—" %><br><span class="ad-hint"><%= product.sub_category&.name(I18n.locale) %></span></td>
              <td class="whitespace-nowrap">
                <% if product.on_sale_with_price? %>
                  <%= vn_price(product.sale_price) %> <s class="ad-off"><%= vn_price(product.price, css: "!text-[13px]") %></s>
                <% else %>
                  <%= vn_price(product.price) %>
                <% end %>
              </td>
              <td>
                <% stock = variant_stock.fetch(product.id, product.stock_quantity) %>
                <span class="vn-status <%= stock.positive? ? 'vn-status--ok' : (product.made_to_order? ? 'vn-status--off' : 'vn-status--bad') %> font-latin"><%= stock %></span>
              </td>
              <td><%= product.featured? ? tag.span(t("vene.admin.common.yes_label"), class: "vn-badge vn-badge--noir") : tag.span(t("vene.admin.common.no_label"), class: "ad-off") %></td>
              <td><%= product.on_sale? ? tag.span(t("vene.product.sale"), class: "vn-badge vn-badge--outline") : tag.span(t("vene.admin.common.no_label"), class: "ad-off") %></td>
              <td class="!text-end whitespace-nowrap">
                <%= link_to t("admin.actions.edit"), edit_admin_product_path(product, locale: I18n.locale), class: "ad-textbtn" %>
                <span class="mx-2 ad-off" aria-hidden="true">·</span>
                <%= link_to t("admin.actions.delete"), admin_product_path(product, locale: I18n.locale), class: "ad-textbtn !text-danger",
                      data: { turbo_method: :delete, turbo_confirm: t("admin.actions.confirm") } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="7" class="!py-12 text-center ad-muted"><%= t("vene.admin.products.none") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @pagy && @pagy.pages > 1 %>
    <div class="px-5 py-4 border-t border-line"><%== pagy_nav(@pagy) %></div>
  <% end %>
</div>
