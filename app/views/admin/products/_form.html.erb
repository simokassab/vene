<%# AdminProductEdit.dc.html: content in the main column (names, story, price, made to order,
    specifications, sizes, related pieces, media); visibility, placement and save in the side
    column. Field names, the variant builder's inputs and the image delete forms are unchanged. %>
<% tf = "vene.admin.product_form" %>
<%= form_with(model: [:admin, @product], data: { turbo: false }) do |form| %>
  <%= render "shared/vene/form_errors", record: @product, title: t("#{tf}.fix") %>
  <div class="flex flex-wrap items-start gap-6 mt-2">
    <div class="flex-[999_1_560px] min-w-0 flex flex-col gap-6">
      <%= render "admin/shared/card", title: t("#{tf}.details") do %>
        <div class="ad-grid-2">
          <div class="ad-field">
            <%= form.label :name_en, t("#{tf}.name_en"), class: "ad-label" %>
            <%= form.text_field :name_en, class: "ad-input", dir: "ltr" %>
          </div>
          <div class="ad-field">
            <%= form.label :name_ar, t("#{tf}.name_ar"), class: "ad-label" %>
            <%= form.text_field :name_ar, class: "ad-input", dir: "rtl", lang: "ar" %>
          </div>
          <div class="ad-field col-span-full">
            <%= form.label :description_en, t("#{tf}.description_en"), class: "ad-label" %>
            <%= form.text_area :description_en, rows: 4, class: "ad-textarea", dir: "ltr" %>
          </div>
          <div class="ad-field col-span-full">
            <%= form.label :description_ar, t("#{tf}.description_ar"), class: "ad-label" %>
            <%= form.text_area :description_ar, rows: 4, class: "ad-textarea", dir: "rtl", lang: "ar" %>
          </div>
          <div class="ad-field col-span-full">
            <%= form.label :slug, t("#{tf}.slug"), class: "ad-label" %>
            <%= form.text_field :slug, class: "ad-input ad-mono", dir: "ltr", placeholder: t("#{tf}.slug_placeholder"), "aria-describedby": "slug-hint" %>
            <span id="slug-hint" class="ad-hint"><%= t("#{tf}.slug_hint") %></span>
          </div>
        </div>
      <% end %>

      <%= render "admin/shared/card", title: t("#{tf}.pricing") do %>
        <div class="ad-grid-2">
          <div class="ad-field">
            <%= form.label :price, t("#{tf}.price"), class: "ad-label" %>
            <%= form.number_field :price, step: 0.01, class: "ad-input font-latin", dir: "ltr", placeholder: "0.00" %>
          </div>
          <div class="ad-field">
            <%= form.label :sale_price, t("#{tf}.sale_price"), class: "ad-label" %>
            <%= form.number_field :sale_price, step: 0.01, class: "ad-input font-latin", dir: "ltr", placeholder: "0.00", "aria-describedby": "sale-hint" %>
            <span id="sale-hint" class="ad-hint"><%= t("#{tf}.sale_hint") %></span>
          </div>
          <div class="ad-field">
            <%= form.label :stock_quantity, t("#{tf}.stock"), class: "ad-label" %>
            <%= form.number_field :stock_quantity, class: "ad-input font-latin", dir: "ltr", placeholder: "0" %>
          </div>
        </div>
      <% end %>

      <%= render "admin/shared/card", title: t("products.made_to_order_badge"), subtitle: t("#{tf}.mto_text") do %>
        <label class="vn-check mb-6">
          <%= form.check_box :allow_preorder %>
          <span><%= t("#{tf}.mto_label") %><span class="vn-check__hint"><%= t("#{tf}.mto_hint") %></span></span>
        </label>
        <div class="ad-grid-2">
          <div class="ad-field">
            <%= form.label :lead_time_en, t("#{tf}.lead_time_en"), class: "ad-label" %>
            <%= form.text_field :lead_time_en, class: "ad-input", dir: "ltr", placeholder: "2-3 weeks", "aria-describedby": "lead-en-hint" %>
            <span id="lead-en-hint" class="ad-hint"><%= t("#{tf}.lead_time_hint") %></span>
          </div>
          <div class="ad-field">
            <%= form.label :lead_time_ar, t("#{tf}.lead_time_ar"), class: "ad-label" %>
            <%= form.text_field :lead_time_ar, class: "ad-input", dir: "rtl", lang: "ar", placeholder: "٢-٣ أسابيع" %>
          </div>
          <div class="ad-field">
            <%= form.label :preorder_estimated_delivery_date, t("#{tf}.estimated_date"), class: "ad-label" %>
            <%= form.date_field :preorder_estimated_delivery_date, class: "ad-input", "aria-describedby": "eta-hint" %>
            <span id="eta-hint" class="ad-hint"><%= t("#{tf}.estimated_date_hint") %></span>
          </div>
          <div></div>
          <div class="ad-field">
            <%= form.label :preorder_note_en, t("#{tf}.note_en"), class: "ad-label" %>
            <%= form.text_area :preorder_note_en, rows: 2, class: "ad-textarea", dir: "ltr" %>
          </div>
          <div class="ad-field">
            <%= form.label :preorder_note_ar, t("#{tf}.note_ar"), class: "ad-label" %>
            <%= form.text_area :preorder_note_ar, rows: 2, class: "ad-textarea", dir: "rtl", lang: "ar" %>
          </div>
        </div>
      <% end %>

      <%= render "admin/shared/card", title: t("vene.product.specifications") do %>
        <div class="ad-grid-2">
          <% { metal: "18K Yellow Gold", diamonds: "0.24 ct natural diamonds", gemstones: "Morganite", others: "" }.each do |field, example| %>
            <div class="ad-field">
              <%= form.label field, t("#{tf}.#{field}"), class: "ad-label" %>
              <%= form.text_field field, class: "ad-input", placeholder: example %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%
        variant_types_data = VariantType.includes(:variant_options).active.map do |vt|
          {
            id: vt.id,
            name: vt.name,
            options: vt.variant_options.active.ordered.map do |vo|
              existing_pv = @product.product_variants.find { |pv| pv.variant_option_id == vo.id }
              {
                variant_option_id: vo.id,
                value: vo.value,
                stock_quantity: existing_pv&.stock_quantity || 0,
                id: existing_pv&.id,
                active: existing_pv&.active || true,
                allow_preorder: existing_pv&.allow_preorder || false,
                preorder_estimated_delivery_date: existing_pv&.preorder_estimated_delivery_date&.iso8601 || ""
              }
            end
          }
        end
        selected_variant_type_id = @product.product_variants.first&.variant_type_id || nil
      %>
      <section class="ad-card"
               x-data="{
                 selectedVariantTypeId: <%= selected_variant_type_id.to_json %>,
                 variantTypes: <%= variant_types_data.to_json %>,
                 get currentVariantType() { return this.variantTypes.find(vt => vt.id === this.selectedVariantTypeId); },
                 get currentOptions() { return this.currentVariantType?.options || []; },
                 shouldSubmitVariant(option) { return option.id || option.stock_quantity > 0; }
               }">
        <header class="flex flex-wrap items-start justify-between gap-4 mb-5">
          <div class="flex flex-col gap-1">
            <h2 class="ad-h2"><%= t("#{tf}.variants") %></h2>
            <p class="m-0 ad-hint"><%= t("#{tf}.variants_text") %></p>
          </div>
          <%= link_to t("vene.admin.nav.variant_types"), admin_variant_types_path(locale: I18n.locale), target: "_blank", class: "ad-textbtn" %>
        </header>
        <div class="ad-field max-w-[320px] mb-6">
          <label for="variant-type" class="ad-label"><%= t("#{tf}.variant_type") %></label>
          <select id="variant-type" x-model.number="selectedVariantTypeId" class="ad-select">
            <option value=""><%= t("#{tf}.no_variants") %></option>
            <% VariantType.active.each do |vt| %>
              <option value="<%= vt.id %>" <%= "selected" if selected_variant_type_id == vt.id %>><%= vt.name %></option>
            <% end %>
          </select>
        </div>
        <div x-show="selectedVariantTypeId !== null" class="grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3">
          <template x-for="(option, index) in currentOptions" :key="option.variant_option_id">
            <div class="p-4 border border-line bg-surface flex flex-col gap-3" :class="option.stock_quantity > 0 && '!border-ink'">
              <span class="font-latin text-lg vn-num" x-text="option.value"></span>
              <input type="hidden" :name="`product[product_variants_attributes][${index}][id]`" :value="option.id || ''">
              <input type="hidden" :name="`product[product_variants_attributes][${index}][variant_type_id]`" :value="selectedVariantTypeId">
              <input type="hidden" :name="`product[product_variants_attributes][${index}][variant_option_id]`" :value="option.variant_option_id">
              <input type="hidden" :name="`product[product_variants_attributes][${index}][stock_quantity]`" :value="option.stock_quantity">
              <input type="hidden" :name="`product[product_variants_attributes][${index}][active]`" value="1">
              <label class="ad-field">
                <span class="ad-label"><%= t("#{tf}.stock") %></span>
                <input type="number" x-model.number="option.stock_quantity" class="ad-input font-latin" placeholder="0" min="0">
              </label>
              <label class="vn-check !text-[13px] !leading-5">
                <input type="checkbox" x-model="option.allow_preorder" :name="`product[product_variants_attributes][${index}][allow_preorder]`" value="1">
                <span><%= t("products.made_to_order_badge") %></span>
              </label>
              <input type="date" x-show="option.allow_preorder" x-model="option.preorder_estimated_delivery_date"
                     :name="`product[product_variants_attributes][${index}][preorder_estimated_delivery_date]`"
                     class="ad-input" aria-label="<%= t("#{tf}.estimated_date") %>">
            </div>
          </template>
        </div>
        <p x-show="selectedVariantTypeId === null" class="m-0 ad-muted"><%= t("#{tf}.no_variants_text") %></p>
      </section>

      <%= render "admin/shared/card", title: t("#{tf}.related") do %>
        <div class="ad-field">
          <%= form.label :related_product_ids, t("#{tf}.related_label"), class: "ad-label" %>
          <%= form.collection_select :related_product_ids, Product.where.not(id: @product.id), :id, :name_en,
                { include_hidden: false, selected: @product.related_product_ids }, multiple: true, class: "ad-input !h-40 py-2", "aria-describedby": "related-hint" %>
          <span id="related-hint" class="ad-hint"><%= t("#{tf}.related_hint") %></span>
        </div>
      <% end %>

      <%= render "admin/shared/card", title: t("admin.products.images"), subtitle: t("admin.products.image_hint") do %>
        <div class="ad-field mb-6">
          <%= form.label :images, t("#{tf}.upload_images"), class: "ad-label" %>
          <%= form.file_field :images, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "ad-input" %>
          <span class="ad-hint"><%= t("admin.products.multiple_upload") %></span>
        </div>
        <% if @product.persisted? && @product.product_images.any? %>
          <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fill,minmax(120px,1fr))] gap-4">
            <% @product.product_images.each_with_index do |img, i| %>
              <li class="flex flex-col gap-2">
                <span class="aspect-square bg-media shadow-hairline flex items-center justify-center">
                  <% if img.image.present? %><%= image_tag img.image.url, alt: "", class: "w-[88%] h-[88%] object-contain" %><% end %>
                </span>
                <span class="flex justify-between items-center">
                  <span class="ad-hint"><%= i.zero? ? t("#{tf}.cover") : "##{i + 1}" %></span>
                  <button type="button" class="ad-textbtn !text-danger" onclick="document.getElementById('delete-image-form-<%= img.id %>').requestSubmit()"><%= t("admin.actions.delete") %></button>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <%= render "admin/shared/card", title: t("#{tf}.video"), subtitle: t("#{tf}.optional") do %>
        <div class="ad-field">
          <%= form.label :video, t("#{tf}.upload_video"), class: "ad-label" %>
          <%= form.file_field :video, accept: "video/mp4,video/mov,video/avi,video/webm,video/mkv", class: "ad-input", "aria-describedby": "video-hint" %>
          <span id="video-hint" class="ad-hint"><%= t("#{tf}.video_hint") %></span>
        </div>
        <% if @product.persisted? && @product.video.present? %>
          <div class="mt-5 flex flex-col gap-3 max-w-md">
            <video controls class="w-full bg-media"><source src="<%= @product.video.url %>" type="video/mp4"></video>
            <label class="vn-check vn-check--muted"><%= form.check_box :remove_video %><span class="text-danger"><%= t("#{tf}.remove_video") %></span></label>
          </div>
        <% end %>
      <% end %>
    </div>

    <aside class="flex-[1_1_280px] min-w-0 max-w-[360px] flex flex-col gap-6 lg:sticky lg:top-6">
      <%= render "admin/shared/card", title: t("#{tf}.visibility") do %>
        <div class="flex flex-col gap-4">
          <label class="vn-check"><%= form.check_box :active %><span><%= t("#{tf}.active") %><span class="vn-check__hint"><%= t("#{tf}.active_hint") %></span></span></label>
          <label class="vn-check"><%= form.check_box :featured %><span><%= t("vene.admin.products.featured") %><span class="vn-check__hint"><%= t("#{tf}.featured_hint") %></span></span></label>
          <label class="vn-check"><%= form.check_box :on_sale %><span><%= t("vene.admin.products.on_sale") %><span class="vn-check__hint"><%= t("#{tf}.on_sale_hint") %></span></span></label>
        </div>
      <% end %>
      <%= render "admin/shared/card", title: t("#{tf}.placement") do %>
        <div class="ad-field">
          <%= form.label :sub_category_id, t("vene.admin.nav.subcategories"), class: "ad-label" %>
          <%= form.grouped_collection_select :sub_category_id, Category.active.ordered, :sub_categories, :name_en, :id, :name_en,
                { prompt: t("#{tf}.choose_subcategory") }, class: "ad-select" %>
        </div>
      <% end %>
      <div class="ad-card flex flex-col gap-3">
        <%= form.button t("admin.actions.save"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
        <%= link_to t("common.cancel"), admin_products_path(locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--block vn-btn--sm" %>
        <% if @product.persisted? %>
          <%= link_to product_path(@product.slug, locale: I18n.locale), target: "_blank", rel: "noopener", class: "ad-textbtn self-center inline-flex items-center gap-2" do %>
            <%= t("#{tf}.view_live") %> <%= vn_icon(:external, size: 14) %>
          <% end %>
        <% end %>
      </div>
    </aside>
  </div>
<% end %>
<%# Image delete forms sit outside the product form so forms never nest. %>
<% if @product.persisted? && @product.product_images.any? %>
  <% @product.product_images.each do |img| %>
    <form id="delete-image-form-<%= img.id %>" action="<%= admin_product_product_image_path(@product, img, locale: I18n.locale) %>" method="post"
          data-turbo="true" data-turbo-confirm="<%= t("admin.actions.confirm") %>">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token, id: nil %>
      <%= hidden_field_tag :_method, "delete", id: nil %>
    </form>
  <% end %>
<% end %>
