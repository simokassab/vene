<%= render "admin/shared/top_bar", title: t("admin.nav.dashboard"), subtitle: t("vene.admin.dashboard.welcome") do %>
  <%= link_to admin_orders_path(locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--sm" do %><span><%= t("admin.nav.orders") %></span><span class="vn-btn__arrow" aria-hidden="true">→</span><% end %>
<% end %>

<div class="ad-grid-3 mb-8">
  <%= render "admin/shared/stat_card", title: t("admin.dashboard.products"), value: @products_count.to_s %>
  <%= render "admin/shared/stat_card", title: t("admin.dashboard.orders"), value: @orders_count.to_s %>
  <%= render "admin/shared/stat_card", title: t("vene.admin.dashboard.recent_value", count: @recent_orders.size), value: vn_price(@recent_orders.sum(&:total_amount)) %>
</div>

<%= render "admin/shared/card", title: t("admin.dashboard.recent_orders"), padding: false do %>
  <div class="ad-table-wrap">
    <table class="ad-table">
      <thead>
        <tr>
          <th scope="col"><%= t("vene.orders.order_label") %></th>
          <th scope="col"><%= t("admin.orders.status") %></th>
          <th scope="col"><%= t("admin.orders.customer") %></th>
          <th scope="col"><%= t("admin.orders.total") %></th>
          <th scope="col"><%= t("vene.orders.placed") %></th>
          <th scope="col" class="!text-end"><span class="sr-only"><%= t("common.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% if @recent_orders.any? %>
          <% @recent_orders.each do |order| %>
            <tr>
              <td class="ad-mono"><%= link_to "##{order.id}", admin_order_path(order, locale: I18n.locale), class: "vn-quiet !text-ink" %></td>
              <td><span class="vn-badge vn-badge--<%= vn_status_tone(order.status) %>"><%= vn_status_label(order.status) %></span></td>
              <td><%= order.name %></td>
              <td><%= vn_order_price(order.total_amount, order) %></td>
              <td class="ad-muted"><%= l(order.created_at.to_date, format: :long) %></td>
              <td class="!text-end"><%= link_to t("admin.actions.view"), admin_order_path(order, locale: I18n.locale), class: "ad-textbtn" %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6" class="!py-12 text-center ad-muted"><%= t("vene.admin.dashboard.no_orders") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
