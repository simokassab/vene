<% content_for :title, "#{t('vene.admin.sign_in.title')} · VENÈ Admin" %>
<% content_for :full_width, true %>
<%# Admin sign in: the noir ground and the mark, a single quiet form. %>
<div class="vn-noir min-h-[70vh] flex items-center justify-center px-[var(--gutter)] py-20">
  <div class="w-full max-w-[420px] flex flex-col gap-8">
    <div class="flex flex-col items-center gap-4 text-center">
      <%= image_tag "logo-hq.png", alt: "VENÈ Jewelry", width: 160, height: 109, class: "block w-40 h-auto" %>
      <span class="vn-label !text-gold-text"><%= t("vene.admin.badge") %></span>
      <h1 class="vn-h2 m-0"><%= t("vene.admin.sign_in.title") %></h1>
    </div>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-6" }) do |f| %>
      <div class="vn-field">
        <%= f.label :email, t("activerecord.attributes.user.email"), class: "vn-field__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, dir: "ltr", class: "vn-input" %>
      </div>
      <div class="vn-field" x-data="{ show: false }">
        <%= f.label :password, t("activerecord.attributes.user.password"), class: "vn-field__label" %>
        <div class="relative">
          <%= f.password_field :password, autocomplete: "current-password", required: true, class: "vn-input pe-12", "x-bind:type": "show ? 'text' : 'password'" %>
          <button type="button" class="vn-icon-btn absolute end-0 top-0" @click="show = !show" :aria-pressed="show.toString()"
                  :aria-label="show ? '<%= j t('vene.auth.hide_password') %>' : '<%= j t('vene.auth.show_password') %>'"><%= vn_icon(:eye, size: 18) %></button>
        </div>
      </div>
      <% if devise_mapping.rememberable? %>
        <label class="vn-check vn-check--muted"><%= f.check_box :remember_me %><span><%= t("vene.auth.keep_signed_in") %></span></label>
      <% end %>
      <%= f.button t("vene.auth.sign_in"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
    <% end %>
  </div>
</div>
