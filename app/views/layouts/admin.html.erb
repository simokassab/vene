<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale == :ar ? 'rtl' : 'ltr' %>">
<head>
  <title><%= content_for(:title).presence || t("vene.admin.title") %> · VENÈ Admin</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= favicon_link_tag "favicon.ico" %>
  <%= render "shared/vene/font_links" %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <script src="/tinymce/tinymce.min.js"></script>
</head>
<%# AdminLayout.dc.html: the noir AdminNav beside the ivory work area. On small screens the nav
    folds into a drawer under a top bar. %>
<%
  signed_in_admin = current_admin_user if admin_user_signed_in?
  signed_in_admin ||= current_user if user_signed_in?
  sign_out_path = admin_user_signed_in? ? destroy_admin_user_session_path(locale: I18n.locale) : destroy_user_session_path(locale: I18n.locale)
  nav_groups = [
    [t("vene.admin.nav.sales"), [
      [t("admin.nav.dashboard"), admin_root_path(locale: I18n.locale), :exact],
      [t("admin.nav.orders"), admin_orders_path(locale: I18n.locale)],
      [t("vene.admin.nav.preorders"), admin_preorders_path(locale: I18n.locale)],
      [t("admin.nav.coupons"), admin_coupons_path(locale: I18n.locale)],
      [t("admin.nav.wishlists"), admin_wishlists_path(locale: I18n.locale)]
    ]],
    [t("vene.admin.nav.catalog"), [
      [t("admin.nav.products"), admin_products_path(locale: I18n.locale)],
      [t("admin.nav.categories"), admin_categories_path(locale: I18n.locale)],
      [t("vene.admin.nav.subcategories"), admin_sub_categories_path(locale: I18n.locale)],
      [t("vene.admin.nav.variant_types"), admin_variant_types_path(locale: I18n.locale)]
    ]],
    [t("vene.admin.nav.storefront"), [
      [t("admin.nav.banners"), admin_banners_path(locale: I18n.locale)],
      [t("admin.nav.pages"), admin_pages_path(locale: I18n.locale)]
    ]],
    [t("vene.admin.nav.settings"), [
      [t("admin.nav.settings"), admin_setting_path(locale: I18n.locale)],
      [t("admin.nav.webhooks"), admin_webhooks_path(locale: I18n.locale)]
    ]]
  ]
%>
<body class="bg-surface text-ink" x-data="{ mobileMenu: false }" @keydown.escape.window="mobileMenu = false">
  <a href="#admin-main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:start-2 focus:z-50 vn-btn vn-btn--primary vn-btn--sm"><%= t("vene.skip_to_content") %></a>
  <div class="ad-shell">
    <div class="lg:hidden vn-noir w-full flex items-center justify-between px-4 h-14 border-b border-line">
      <button type="button" class="vn-icon-btn" @click="mobileMenu = !mobileMenu" :aria-expanded="mobileMenu.toString()" aria-controls="admin-nav" aria-label="<%= t('vene.header.menu') %>">
        <span x-show="!mobileMenu"><%= vn_icon(:menu, size: 22) %></span><span x-show="mobileMenu" x-cloak><%= vn_icon(:close, size: 22) %></span>
      </button>
      <span class="font-display text-xl tracking-nav uppercase" lang="en" dir="ltr" style="letter-spacing: var(--tracking-nav);">VENÈ</span>
      <span class="vn-label !text-gold-text"><%= t("vene.admin.badge") %></span>
    </div>

    <aside id="admin-nav" class="ad-side vn-noir lg:block" :class="mobileMenu ? 'block' : 'hidden'">
      <div class="lg:sticky lg:top-0 lg:h-screen lg:overflow-y-auto flex flex-col gap-6 pt-7 pb-6">
        <%= link_to admin_root_path(locale: I18n.locale), class: "hidden lg:flex items-center gap-3 px-6 no-underline text-ink", "aria-label": t("vene.admin.home_label") do %>
          <%= image_tag "logo-hq.png", alt: "", width: 72, height: 49, class: "block w-[72px] h-auto" %>
          <span class="vn-label !text-gold-text"><%= t("vene.admin.badge") %></span>
        <% end %>
        <nav aria-label="<%= t('vene.admin.nav.label') %>" class="flex flex-col gap-5">
          <% nav_groups.each do |title, items| %>
            <div class="flex flex-col">
              <span class="ad-navgroup !pt-0 !px-6 rtl:!text-xs rtl:!tracking-normal rtl:normal-case"><%= title %></span>
              <% items.each do |label, path, match| %>
                <% active = match == :exact ? request.path == path : request.path.start_with?(path) %>
                <%= link_to label, path, class: "ad-navlink !px-6", "aria-current": (active ? "page" : nil) %>
              <% end %>
            </div>
          <% end %>
        </nav>
        <div class="mt-auto flex flex-col gap-1 px-6 pt-4 border-t border-line text-[13px] leading-5">
          <%= link_to root_path(locale: I18n.locale), target: "_blank", rel: "noopener", class: "vn-quiet inline-flex items-center gap-2 min-h-9" do %>
            <%= t("vene.admin.view_store") %> <%= vn_icon(:external, size: 14) %>
          <% end %>
          <div class="inline-flex items-center gap-3 min-h-9 text-ink-muted">
            <%= link_to "EN", url_for(locale: :en), class: "vn-quiet font-latin text-xs tracking-nav #{'!text-ink' if I18n.locale == :en}", "aria-current": (I18n.locale == :en ? "true" : nil) %>
            <span aria-hidden="true">|</span>
            <%= link_to "العربية", url_for(locale: :ar), class: "vn-quiet font-arabic #{'!text-ink' if I18n.locale == :ar}", "aria-current": (I18n.locale == :ar ? "true" : nil) %>
          </div>
          <% if signed_in_admin %>
            <span class="text-ink-muted truncate"><%= t("vene.admin.signed_in_as", email: signed_in_admin.email) %></span>
            <%= button_to t("vene.account.sign_out"), sign_out_path, method: :delete, class: "vn-quiet bg-transparent border-0 p-0 min-h-9 cursor-pointer text-start", form: { class: "flex" } %>
          <% end %>
        </div>
      </div>
    </aside>

    <main id="admin-main" class="ad-main">
      <% if (messages = vn_flash_messages).any? %>
        <div class="flex flex-col gap-3 pt-6">
          <% messages.each do |key, value| %>
            <%= render "shared/vene/notice", text: value, tone: vn_flash_tone(key) %>
          <% end %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </div>
  <%= render "admin/shared/toast" %>
</body>
</html>
