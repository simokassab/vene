<%#
  Wishlist Icon Button (compact, for product cards): a hairline heart, filled when saved.
  Usage: render "shared/wishlist_icon_button", product: @product, variant: @variant
%>
<% variant ||= nil %>
<% in_wishlist = user_signed_in? && current_user.product_in_wishlist?(product, variant) %>
<% wishlist_item = in_wishlist ? current_user.wishlist_item_for(product, variant) : nil %>
<% btn = "vn-icon-btn !bg-surface-raised/80 hover:!bg-surface-raised" %>
<% if user_signed_in? %>
  <% if in_wishlist %>
    <%= button_to wishlist_item_path(wishlist_item, locale: I18n.locale), method: :delete,
          class: "#{btn} !text-gold-text", title: t("wishlist.remove"), "aria-label": t("wishlist.remove"), "aria-pressed": "true" do %>
      <%= vn_icon(:heart, size: 20, filled: true) %>
    <% end %>
  <% else %>
    <%= button_to wishlist_items_path(locale: I18n.locale), method: :post,
          params: { product_id: product.id, product_variant_id: variant&.id },
          class: btn, title: t("wishlist.add"), "aria-label": t("wishlist.add"), "aria-pressed": "false" do %>
      <%= vn_icon(:heart, size: 20) %>
    <% end %>
  <% end %>
<% else %>
  <%= link_to new_user_session_path(locale: I18n.locale), class: btn, title: t("wishlist.login_required"), "aria-label": t("wishlist.login_required") do %>
    <%= vn_icon(:heart, size: 20) %>
  <% end %>
<% end %>
