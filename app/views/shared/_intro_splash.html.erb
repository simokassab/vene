<%#
  Intro splash: the VENÈ mark on the noir ground, a slow fade and a gold hairline loader, then
  the site after ~3s. Shown once per browser session (sessionStorage guard in the <head>).
  Quiet by design: no gradient, sweep or sparkle (README → Motion).
%>
<div id="vene-splash" class="vene-splash vn-noir" role="status" aria-label="<%= t('brand.name', default: 'VENÈ Jewelry') %>">
  <div class="vene-splash__stage">
    <%= image_tag "vene-splash-logo.png", alt: t("brand.name", default: "VENÈ Jewelry"),
          width: 896, height: 609, class: "vene-splash__logo", fetchpriority: "high" %>
    <span class="vene-splash__tagline"><%= t("vene.brand.tagline") %></span>
  </div>
  <div class="vene-splash__loader" aria-hidden="true"><span class="vene-splash__loader-bar"></span></div>
</div>
<noscript>
  <style>
    #vene-splash { display: none !important; }
  </style>
</noscript>
<style>
  html.splash-lock, html.splash-lock body { overflow: hidden; }
  html.splash-seen #vene-splash { display: none !important; }

  .vene-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    opacity: 1;
    transition: opacity .6s var(--ease), visibility .6s var(--ease);
  }
  .vene-splash.is-leaving { opacity: 0; visibility: hidden; pointer-events: none; }

  .vene-splash__stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    animation: vene-splash-in 1.2s var(--ease) both;
  }
  .vene-splash__logo { display: block; width: min(72vw, 460px); height: auto; }
  .vene-splash__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 28px;
    color: var(--ink-muted);
    opacity: 0;
    animation: vene-splash-in .8s var(--ease) .6s both;
  }
  [dir="rtl"] .vene-splash__tagline { font-family: var(--font-arabic); font-style: normal; font-size: 16px; }

  .vene-splash__loader {
    position: absolute;
    bottom: clamp(48px, 12vh, 120px);
    width: min(46vw, 220px);
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }
  .vene-splash__loader-bar {
    display: block;
    height: 100%;
    width: 100%;
    transform-origin: left center;
    transform: scaleX(0);
    background: var(--gold);
    animation: vene-splash-load 3s var(--ease) forwards;
  }
  [dir="rtl"] .vene-splash__loader-bar { transform-origin: right center; }

  @keyframes vene-splash-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes vene-splash-load {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vene-splash__stage, .vene-splash__tagline { animation: none; opacity: 1; }
    .vene-splash__loader { display: none; }
  }
</style>
<script>
  (function () {
    var html = document.documentElement;
    // Already shown this session (guard added class in <head>), or a Turbo
    // navigation re-ran this script after the first visit — do nothing.
    if (html.classList.contains("splash-seen")) return;

    var splash = document.getElementById("vene-splash");
    if (!splash) return;

    html.classList.add("splash-lock");

    var reduce = window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function dismiss() {
      if (splash.dataset.done) return;
      splash.dataset.done = "1";
      try { sessionStorage.setItem("veneSplashSeen", "1"); } catch (e) {}
      html.classList.add("splash-seen");
      html.classList.remove("splash-lock");
      splash.classList.add("is-leaving");
      setTimeout(function () {
        if (splash.parentNode) splash.parentNode.removeChild(splash);
      }, 750);
    }

    // Let visitors skip by clicking/tapping.
    splash.addEventListener("click", dismiss);
    // Reveal the site after the intro plays (shorter when motion is reduced).
    setTimeout(dismiss, reduce ? 900 : 3000);
  })();
</script>
