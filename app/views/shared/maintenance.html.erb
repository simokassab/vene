<%# Maintenance: the noir splash ground, the silver-white mark, one calm sentence and a way to reach us. %>
<% whatsapp = current_settings.whatsapp_phone_number.to_s.gsub(/[^0-9]/, "") %>
<main class="max-w-[620px] mx-auto flex flex-col items-center gap-8 text-center">
  <%= image_tag "logo-hq.png", alt: "VENÈ Jewelry", width: 220, height: 150, class: "block w-[200px] h-auto" %>
  <%= render "shared/vene/eyebrow", text: t("vene.maintenance.eyebrow") %>
  <h1 class="vn-display-l m-0"><%= t("vene.maintenance.title") %></h1>
  <p class="vn-lead m-0"><%= t("vene.maintenance.lead") %></p>
  <p class="vn-body m-0"><%= t("vene.maintenance.body") %></p>
  <% if whatsapp.present? %>
    <div class="flex flex-col items-center gap-3 pt-4">
      <span class="vn-small"><%= t("vene.maintenance.help") %></span>
      <a href="https://wa.me/<%= whatsapp %>" target="_blank" rel="noopener" class="vn-btn vn-btn--gold">
        <%= render "shared/whatsapp_icon", css_class: "w-4 h-4" %><span><%= t("vene.header.whatsapp") %></span>
      </a>
    </div>
  <% end %>
  <span class="vn-small pt-8"><%= t("vene.brand.tagline") %></span>
</main>
