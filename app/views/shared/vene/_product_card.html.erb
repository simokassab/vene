<%# locals: (product:, heading: :h3, wishlist: true, loading: "lazy", css: nil, color: nil) %>
<%# ProductCard (ds/vene, ProductGrid.dc.html): the piece on white at 4:5, badges top-start, actions
    top-end, then name, metal and price centred. The actions sit outside the card link so no
    interactive element is nested inside another. Needs product_images preloaded. %>
<%# color: the option a listing is filtered by; the card then opens on that color. %>
<% href = product_path(product.slug, locale: I18n.locale) %>
<%# A piece sold by color is sold out only when no color can be bought; others keep the
    product's own stock rule. %>
<% swatches = product.swatch_options %>
<% sold_out = swatches.any? ? swatches.none?(&:available) : !product.purchasable? %>
<% filtered = color && swatches.find { |sw| sw.option.id == color.id } %>
<% cover_photo = filtered && product.images_for(color.id).first %>
<% cover_src = cover_photo ? cover_photo.image.medium.url : vn_product_image_url(product) %>
<% cover_slug = (filtered || swatches.find { |sw| sw.option.default_choice? } || swatches.first)&.option&.slug %>
<% href = product_path(product.slug, locale: I18n.locale, color: color.slug) if filtered %>
<% metal_line = [product.metal.presence, (t("vene.product.diamonds") if product.diamonds.present?)].compact.join(" · ") %>
<div class="vn-card relative min-w-0 <%= css %>" x-data="{ src: <%= cover_src.to_json %>, href: <%= href.to_json %>, color: <%= cover_slug.to_json %> }">
  <%= link_to href, class: "block text-inherit no-underline", ":href": "href" do %>
    <div class="vn-card__media">
      <% if (src = cover_src) %>
        <%= image_tag src, alt: product.name(I18n.locale), loading: loading, ":src": "src" %>
      <% else %>
        <div class="w-full h-full flex items-center justify-center text-line-control"><%= vn_icon(:diamond, size: 40, stroke: 1) %></div>
      <% end %>
      <div class="vn-card__badge">
        <%= render "shared/made_to_order_badge", product: product, positioned: false %>
        <% if sold_out %>
          <span class="vn-badge vn-badge--noir"><%= t("vene.product.sold_out") %></span>
        <% elsif product.on_sale_with_price? %>
          <span class="vn-badge vn-badge--outline"><%= t("vene.product.sale") %></span>
        <% end %>
      </div>
    </div>
    <div class="vn-card__body">
      <%= content_tag heading, product.name(I18n.locale), class: "vn-card__name" %>
      <% if metal_line.present? %><span class="vn-card__metal"><%= metal_line %></span><% end %>
      <span class="vn-card__price"><%= render "shared/product_price", product: product %></span>
    </div>
  <% end %>
  <% if swatches.size > 1 %>
    <%# Color dots: hovering, focusing or tapping one shows that color's photo and points the
        card link at it (?color=rose-gold). Kept outside the link so controls never nest. %>
    <% shown = swatches.first(4) %>
    <div class="flex items-center justify-center gap-3 pt-3" role="group" aria-label="<%= t("vene.product.colors_of", name: product.name(I18n.locale)) %>">
      <% shown.each do |swatch| %>
        <% option = swatch.option %>
        <% photo = product.images_for(option.id).first %>
        <% color_href = product_path(product.slug, locale: I18n.locale, color: option.slug) %>
        <% photo_src = photo ? photo.image.medium.url : cover_src %>
        <button type="button"
                class="vn-metal !w-4 !h-4 <%= "vn-metal--#{option.swatch_color}" if VariantOption::SWATCH_TOKENS.include?(option.swatch_color) %> <%= 'opacity-40' unless swatch.available %>"
                <% if option.swatch_color.to_s.start_with?("#") %>style="background: <%= option.swatch_color %>"<% end %>
                :class="color === <%= option.slug.to_json %> && 'is-active'"
                @mouseenter="src = <%= photo_src.to_json %>; href = <%= color_href.to_json %>; color = <%= option.slug.to_json %>"
                @focus="src = <%= photo_src.to_json %>; href = <%= color_href.to_json %>; color = <%= option.slug.to_json %>"
                @click="src = <%= photo_src.to_json %>; href = <%= color_href.to_json %>; color = <%= option.slug.to_json %>"
                aria-label="<%= option.label %><%= " — #{t('products.out_of_stock')}" unless swatch.available %>"
                title="<%= option.label %>"></button>
      <% end %>
      <% if swatches.size > shown.size %>
        <span class="vn-small font-latin" aria-label="<%= t("vene.product.more_colors", count: swatches.size - shown.size) %>">+<%= swatches.size - shown.size %></span>
      <% end %>
    </div>
  <% end %>
  <div class="vn-card__action flex flex-col gap-1">
    <% if wishlist %>
      <%= render "shared/wishlist_icon_button", product: product %>
    <% end %>
    <% if product.made_to_order? && (wa = made_to_order_whatsapp_url(product)) %>
      <%= link_to wa, target: "_blank", rel: "noopener", class: "vn-icon-btn !bg-surface-raised/80 hover:!bg-surface-raised",
            title: t("products.order_on_whatsapp"), "aria-label": "#{t('products.order_on_whatsapp')}: #{product.name(I18n.locale)}" do %>
        <%= render "shared/whatsapp_icon", css_class: "w-[18px] h-[18px]" %>
      <% end %>
    <% end %>
  </div>
</div>
