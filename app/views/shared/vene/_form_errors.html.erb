<%# locals: (record:, title: nil) %>
<% if record.errors.any? %>
  <div role="alert" class="vn-notice vn-notice--error flex-col !items-start gap-2">
    <strong class="font-medium"><%= title || t("auth.errors_title", count: record.errors.count) %></strong>
    <ul class="m-0 ps-5 list-disc text-[13px] leading-5">
      <% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
