<%#
  Wishlist Button (product page): an outline button, labelled, heart filled when saved.
  Usage: render "shared/wishlist_button", product: @product, variant: @variant
%>
<% variant ||= nil %>
<% in_wishlist = user_signed_in? && current_user.product_in_wishlist?(product, variant) %>
<% wishlist_item = in_wishlist ? current_user.wishlist_item_for(product, variant) : nil %>
<% if user_signed_in? %>
  <% if in_wishlist %>
    <%= button_to wishlist_item_path(wishlist_item, locale: I18n.locale), method: :delete,
          class: "vn-icon-btn !px-0 text-xs tracking-nav uppercase rtl:text-sm", title: t("wishlist.remove"), "aria-pressed": "true" do %>
      <%= vn_icon(:heart, size: 18, filled: true, css: "text-gold-text") %><span><%= t("wishlist.in_wishlist") %></span>
    <% end %>
  <% else %>
    <%= button_to wishlist_items_path(locale: I18n.locale), method: :post,
          params: { product_id: product.id, product_variant_id: variant&.id },
          class: "vn-icon-btn !px-0 text-xs tracking-nav uppercase rtl:text-sm", title: t("wishlist.add"), "aria-pressed": "false" do %>
      <%= vn_icon(:heart, size: 18) %><span><%= t("wishlist.add") %></span>
    <% end %>
  <% end %>
<% else %>
  <%= link_to new_user_session_path(locale: I18n.locale), class: "vn-icon-btn !px-0 text-xs tracking-nav uppercase rtl:text-sm", title: t("wishlist.login_required") do %>
    <%= vn_icon(:heart, size: 18) %><span><%= t("wishlist.add") %></span>
  <% end %>
<% end %>
