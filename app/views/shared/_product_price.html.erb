<%# Product price for cards and the product page. Sale items show the sale price and the
    struck-through original side by side, so every page reads the same.
    size: :card (grids, carousels) or :page (product page headline). %>
<% size = local_assigns.fetch(:size, :card) %>
<% main_class, original_class = size == :page ? ["!text-xl !leading-7", "!text-[15px]"] : ["", "!text-[13px]"] %>
<span class="inline-flex flex-wrap items-baseline gap-x-2">
  <% if product.on_sale_with_price? %>
    <span>
      <span class="sr-only"><%= t("products.sale_price", default: "Sale price") %></span>
      <%= vn_price(product.current_price, css: "text-ink #{main_class}") %>
    </span>
    <s class="text-ink-subtle">
      <span class="sr-only"><%= t("products.original_price", default: "Original price") %></span>
      <%= vn_price(product.price, css: original_class) %>
    </s>
  <% else %>
    <%= vn_price(product.price, css: "text-ink #{main_class}") %>
  <% end %>
</span>
