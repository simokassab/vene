<% content_for :title, "#{t('vene.auth.new_password')} · VENÈ Jewelry" %>
<%= render "shared/vene/auth_shell" do %>
  <div class="flex flex-col gap-6">
    <h1 class="vn-h2 m-0"><%= t("vene.auth.new_password") %></h1>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "flex flex-col gap-6" }) do |f| %>
      <%= render "shared/vene/form_errors", record: resource %>
      <%= f.hidden_field :reset_password_token %>
      <div class="vn-field">
        <%= f.label :password, t("activerecord.attributes.user.password"), class: "vn-field__label" %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, class: "vn-input", "aria-describedby": "pw-hint" %>
        <% if @minimum_password_length %><span id="pw-hint" class="vn-field__hint"><%= t("auth.min_password") %></span><% end %>
      </div>
      <div class="vn-field">
        <%= f.label :password_confirmation, t("activerecord.attributes.user.password_confirmation"), class: "vn-field__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "vn-input" %>
      </div>
      <%= f.button t("vene.auth.save_password"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
    <% end %>
  </div>
<% end %>
