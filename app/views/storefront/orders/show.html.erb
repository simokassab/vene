<% content_for :full_width, true %>
<% content_for :title, "#{vn_order_number(@order)} · VENÈ Jewelry" %>
<%# Tracking.dc.html: where the order is, its journey, the pieces and the totals, with the
    actions that still apply (pay, cancel, receipt). %>
<%
  steps = %w[placed paid shipped delivered]
  reached = { "pending" => 0, "payment_pending" => 0, "paid" => 1, "shipped" => 2, "delivered" => 3 }
  current = reached[@order.status]
  canceled = @order.status == "canceled"
  dhl_url = "https://www.dhl.com/global-en/home/tracking/tracking-express.html?submit=1&tracking-id=#{ERB::Util.url_encode(@order.dhl_tracking_id)}" if @order.dhl_tracking_id.present?
%>
<div class="vn-container pt-[clamp(48px,6vw,96px)] pb-[var(--section)] flex flex-col gap-16">
  <% if @order.is_guest? && !user_signed_in? && session[:pending_order_id].to_s == @order.id.to_s %>
    <%= render "shared/vene/help_card", variant: :band, title: t("guest_checkout.create_account_prompt_title"), text: t("guest_checkout.create_account_prompt_desc") do %>
      <%= link_to t("guest_checkout.create_account_button_short"), new_guest_registration_path(locale: I18n.locale), class: "vn-btn vn-btn--primary vn-btn--sm" %>
    <% end %>
  <% end %>

  <header class="flex flex-wrap justify-between items-end gap-6">
    <div class="flex flex-col gap-4">
      <%= render "shared/vene/eyebrow", text: t("vene.orders.order", number: vn_order_number(@order)) %>
      <h1 class="vn-h1 m-0"><%= t("vene.orders.headline.#{@order.status}", default: vn_status_label(@order.status)) %></h1>
      <p class="vn-lead m-0"><%= t("vene.orders.placed_on", date: l(@order.created_at.to_date, format: :long)) %></p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <span class="vn-badge vn-badge--<%= vn_status_tone(@order.status) %>"><%= vn_status_label(@order.status) %></span>
    </div>
  </header>

  <% unless canceled || current.nil? %>
    <ol aria-label="<%= t('vene.orders.progress') %>" class="list-none m-0 p-0 relative grid grid-cols-4">
      <li aria-hidden="true" class="absolute top-[9px] inset-x-[12.5%] h-px bg-line-control"></li>
      <li aria-hidden="true" class="absolute top-[9px] start-[12.5%] h-px bg-ink" style="width: <%= current * 25 %>%;"></li>
      <% steps.each_with_index do |step, i| %>
        <li class="relative flex flex-col items-center gap-3 text-center" <%= 'aria-current="step"'.html_safe if i == current %>>
          <span aria-hidden="true" class="block w-[19px] h-[19px] border <%= i <= current ? 'bg-ink border-ink' : 'bg-surface border-line-control' %> <%= 'shadow-[0_0_0_4px_var(--gold-soft)]' if i == current %>"></span>
          <span class="text-xs leading-5 tracking-nav uppercase rtl:text-sm <%= i <= current ? 'text-ink' : 'text-ink-subtle' %>"><%= t("vene.orders.steps.#{step}") %></span>
          <% if i.zero? %><span class="vn-small"><%= l(@order.created_at.to_date, format: :short) %></span><% end %>
          <% if i == 1 && @order.paid_at %><span class="vn-small"><%= l(@order.paid_at.to_date, format: :short) %></span><% end %>
        </li>
      <% end %>
    </ol>
  <% end %>

  <div class="flex flex-wrap items-start gap-y-16 gap-x-[clamp(48px,6vw,96px)]">
    <section aria-labelledby="pieces-title" class="flex-[999_1_560px] min-w-0 flex flex-col gap-8">
      <h2 id="pieces-title" class="vn-h2 m-0"><%= t("vene.checkout.pieces") %></h2>
      <ul class="list-none m-0 p-0 border-t border-line">
        <% @order.order_items.each do |item| %>
          <li class="py-6 border-b border-line">
            <%= render "shared/vene/line_item", size: :md, title: item.product.name(I18n.locale), image: vn_product_image_url(item.product),
                  href: product_path(item.product.slug, locale: I18n.locale),
                  meta: [item.product.metal.presence, item.product_variant&.display_name].compact.join(" · "),
                  detail: safe_join([vn_order_price(item.unit_price, @order), " × ", tag.bdi(item.quantity, class: "font-latin")]),
                  price: vn_order_price(item.line_total, @order) %>
          </li>
        <% end %>
      </ul>
      <%
        rows = [[t("orders.subtotal"), vn_order_price(@order.subtotal, @order)],
                [t("vene.cart.delivery"), vn_order_price(@order.shipping_amount, @order)]]
        if @order.discount_amount.positive?
          rows << [safe_join([t("coupons.discount"), " ", tag.bdi(@order.coupon_code, class: "font-latin")]), safe_join(["−", vn_order_price(@order.discount_amount, @order)])]
        end
      %>
      <div class="max-w-[460px] w-full ms-auto">
        <%= render "shared/vene/totals", rows: rows, total: vn_order_price(@order.total_amount, @order) %>
        <% if current_settings.show_tax_notice %><p class="m-0 mt-3 vn-small text-end"><%= t("common.prices_include_tax") %></p><% end %>
      </div>
    </section>

    <aside aria-label="<%= t('vene.orders.shipment') %>" class="flex-[1_1_340px] min-w-0 max-w-[440px] flex flex-col gap-6">
      <div class="p-8 bg-surface-raised shadow-hairline flex flex-col gap-5">
        <dl class="m-0 flex flex-col gap-4 text-[15px] leading-6">
          <div><dt class="vn-label mb-1"><%= t("vene.orders.carrier") %></dt><dd class="m-0">DHL Express</dd></div>
          <div><dt class="vn-label mb-1"><%= t("vene.orders.tracking_number") %></dt><dd class="m-0"><bdi class="font-latin"><%= @order.dhl_tracking_id.presence || t("vene.orders.tracking_soon") %></bdi></dd></div>
          <div><dt class="vn-label mb-1"><%= t("vene.orders.payment") %></dt><dd class="m-0"><%= payment_method_label(@order) %> · <%= vn_payment_status_label(@order.payment_status) %></dd></div>
          <div>
            <dt class="vn-label mb-1"><%= t("vene.orders.deliver_to") %></dt>
            <dd class="m-0 text-ink-muted"><%= @order.name %><br><%= @order.address_text %>, <%= @order.city %>, <%= @order.country %><br><bdi class="font-latin"><%= @order.phone %></bdi></dd>
          </div>
        </dl>
        <% if dhl_url %>
          <%= link_to dhl_url, target: "_blank", rel: "noopener", class: "vn-btn vn-btn--link self-start" do %>
            <span><%= t("vene.orders.view_on_dhl") %></span><span class="vn-btn__arrow" aria-hidden="true">→</span>
          <% end %>
        <% end %>
      </div>
      <div class="flex flex-col gap-3">
        <% if @order.awaiting_card_payment? %>
          <%= button_to t("orders.pay_now"), pay_order_path(@order, locale: I18n.locale), form: { data: { turbo: false } }, class: "vn-btn vn-btn--primary vn-btn--block" %>
        <% end %>
        <%= link_to invoice_order_path(@order, locale: I18n.locale), class: "vn-btn vn-btn--outline vn-btn--block" do %>
          <%= vn_icon(:download, size: 16) %><span><%= t("orders.invoice") %></span>
        <% end %>
        <% if %w[pending payment_pending].include?(@order.status) %>
          <%= button_to t("vene.orders.cancel"), cancel_order_path(@order, locale: I18n.locale), method: :patch,
                form: { data: { turbo_confirm: t("vene.orders.confirm_cancel") } }, class: "vn-btn vn-btn--danger vn-btn--block" %>
        <% end %>
      </div>
      <p class="m-0 p-5 bg-gold-soft text-[13px] leading-5"><%= t("vene.product.duties") %></p>
    </aside>
  </div>
</div>
