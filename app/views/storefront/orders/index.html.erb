<% content_for :full_width, true %>
<% content_for :title, "#{t('vene.account.eyebrow')} · VENÈ Jewelry" %>
<%# Orders.dc.html (AccountLayout): the account lives here as four tabs (orders, details,
    addresses, password); the account nav switches them without a reload. Every form posts
    where it did before. %>
<% first_name = current_user.name.to_s.split.first %>
<% whatsapp = current_settings.whatsapp_phone_number.to_s.gsub(/[^0-9]/, "") %>
<div x-data="{ activeTab: '<%= j(params[:tab].presence_in(%w[orders profile addresses security]) || 'orders') %>', showAddAddress: false, editingAddressId: null }"
     class="vn-container pt-[clamp(48px,6vw,96px)] pb-[var(--section)] flex flex-col gap-12">
  <%= render "shared/vene/page_header", eyebrow: t("vene.account.eyebrow"), title: t("vene.orders.welcome", name: first_name) %>
  <%= render "shared/vene/account_nav", active: :orders, tabs: true %>

  <%# ---------- Orders ---------- %>
  <div x-show="activeTab === 'orders'" class="flex flex-wrap items-start gap-y-12 gap-x-[clamp(48px,6vw,96px)]">
    <section aria-labelledby="orders-title" class="flex-[999_1_640px] min-w-0 flex flex-col gap-8">
      <h2 id="orders-title" class="vn-h2 m-0"><%= t("vene.orders.history") %></h2>
      <% if @orders.any? %>
        <% @orders.each do |order| %>
          <%= render "shared/vene/order_card", order: order %>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center gap-6 py-16 px-6 text-center bg-surface-sunken">
          <p class="m-0 font-display text-2xl leading-8"><%= t("vene.orders.empty") %></p>
          <%= render "shared/vene/button", label: t("storefront.home.hero_cta"), href: products_path(locale: I18n.locale), arrow: true %>
        </div>
      <% end %>
    </section>
    <aside aria-label="<%= t('vene.orders.details_and_help') %>" class="flex-[1_1_300px] min-w-0 max-w-[400px] flex flex-col gap-6">
      <div class="p-8 bg-surface-sunken flex flex-col gap-3">
        <h2 class="m-0 font-display font-medium text-2xl leading-8 rtl:font-bold rtl:text-xl"><%= current_user.name %></h2>
        <bdi class="font-latin text-[15px] leading-6 text-ink-muted"><%= current_user.email %></bdi>
        <dl class="m-0 mt-2 pt-4 border-t border-line grid grid-cols-[minmax(0,1fr)_auto] gap-y-2 text-[13px] leading-5">
          <dt class="text-ink-muted"><%= t("vene.orders.count") %></dt><dd class="m-0 font-latin vn-num"><%= @orders.size %></dd>
          <dt class="text-ink-muted"><%= t("vene.orders.total_spent") %></dt><dd class="m-0"><%= vn_price(@orders.sum(&:total_amount)) %></dd>
        </dl>
      </div>
      <%= render "shared/vene/help_card", variant: :card, title: t("vene.orders.help_title"), text: t("vene.orders.help_text") do %>
        <% if whatsapp.present? %>
          <a href="https://wa.me/<%= whatsapp %>" target="_blank" rel="noopener" class="vn-btn vn-btn--outline vn-btn--sm"><%= t("vene.cart.message_us") %></a>
        <% end %>
      <% end %>
    </aside>
  </div>

  <%# ---------- Account details ---------- %>
  <section x-show="activeTab === 'profile'" x-cloak aria-labelledby="profile-title" class="max-w-[760px] flex flex-col gap-8">
    <div class="flex flex-col gap-2">
      <h2 id="profile-title" class="vn-h2 m-0"><%= t("vene.account.details") %></h2>
      <p class="m-0 vn-small"><%= t("vene.account.details_text") %></p>
    </div>
    <%= form_with model: current_user, url: user_registration_path(locale: I18n.locale), method: :put, local: true, class: "flex flex-col gap-6" do |f| %>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6">
        <div class="vn-field"><%= f.label :name, t("activerecord.attributes.user.name"), class: "vn-field__label" %><%= f.text_field :name, autocomplete: "name", class: "vn-input" %></div>
        <div class="vn-field"><%= f.label :email, t("activerecord.attributes.user.email"), class: "vn-field__label" %><%= f.email_field :email, autocomplete: "email", dir: "ltr", class: "vn-input" %></div>
        <div class="vn-field"><%= f.label :phone, t("activerecord.attributes.user.phone"), class: "vn-field__label" %><%= f.text_field :phone, autocomplete: "tel", dir: "ltr", class: "vn-input" %></div>
        <div class="vn-field"><%= f.label :default_country, t("activerecord.attributes.user.default_country"), class: "vn-field__label" %><%= f.text_field :default_country, autocomplete: "country-name", class: "vn-input" %></div>
        <div class="vn-field"><%= f.label :default_city, t("activerecord.attributes.user.default_city"), class: "vn-field__label" %><%= f.text_field :default_city, autocomplete: "address-level2", class: "vn-input" %></div>
        <div class="vn-field"><%= f.label :default_address, t("activerecord.attributes.user.default_address"), class: "vn-field__label" %><%= f.text_field :default_address, autocomplete: "street-address", class: "vn-input" %></div>
      </div>
      <div><%= f.button t("vene.account.save"), type: "submit", class: "vn-btn vn-btn--primary" %></div>
    <% end %>
  </section>

  <%# ---------- Addresses ---------- %>
  <section x-show="activeTab === 'addresses'" x-cloak aria-labelledby="addresses-title" class="flex flex-col gap-8">
    <div class="flex flex-wrap justify-between items-end gap-4">
      <div class="flex flex-col gap-2">
        <h2 id="addresses-title" class="vn-h2 m-0"><%= t("vene.account.addresses") %></h2>
        <p class="m-0 vn-small"><%= t("vene.addresses.subtitle") %></p>
      </div>
      <button type="button" class="vn-btn vn-btn--outline vn-btn--sm" @click="showAddAddress = !showAddAddress; editingAddressId = null" :aria-expanded="showAddAddress.toString()">
        <%= vn_icon(:plus, size: 16) %><span><%= t("vene.addresses.add") %></span>
      </button>
    </div>

    <div x-show="showAddAddress" x-cloak class="p-8 bg-surface-raised shadow-hairline flex flex-col gap-6">
      <h3 class="vn-h3 m-0"><%= t("vene.addresses.new") %></h3>
      <%= form_with model: Address.new, url: addresses_path(locale: I18n.locale), method: :post, local: true, class: "flex flex-col gap-6" do |f| %>
        <%= render "shared/vene/address_fields", f: f, prefill: { name: current_user.name, phone: current_user.phone } %>
        <label class="vn-check vn-check--muted"><%= f.check_box :is_default %><span><%= t("vene.addresses.set_default") %></span></label>
        <div class="flex flex-wrap gap-3">
          <%= f.button t("vene.addresses.save"), type: "submit", class: "vn-btn vn-btn--primary" %>
          <button type="button" class="vn-btn vn-btn--outline" @click="showAddAddress = false"><%= t("common.cancel") %></button>
        </div>
      <% end %>
    </div>

    <% if @addresses.any? %>
      <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-6">
        <% @addresses.each do |addr| %>
          <li class="bg-surface-raised shadow-hairline p-6 flex flex-col gap-4" :class="editingAddressId === <%= addr.id %> && 'col-span-full'">
            <div x-show="editingAddressId !== <%= addr.id %>" class="flex flex-col gap-4 h-full">
              <div class="flex flex-wrap items-center gap-2">
                <strong class="font-display font-medium text-[22px] leading-7 rtl:font-bold rtl:text-xl"><%= addr.name %></strong>
                <% if addr.label.present? %><span class="vn-badge vn-badge--outline"><%= addr.label %></span><% end %>
                <% if addr.is_default? %><span class="vn-badge vn-badge--gold"><%= t("vene.checkout.default") %></span><% end %>
              </div>
              <address class="not-italic text-[15px] leading-6 text-ink-muted">
                <%= addr.street_address %><% if addr.building.present? %><br><%= addr.building %><% end %><br>
                <%= [addr.city, addr.postal_code].compact_blank.join(", ") %><br><%= addr.country %><br>
                <bdi class="font-latin"><%= addr.phone %></bdi>
              </address>
              <div class="flex flex-wrap gap-x-6 mt-auto pt-2 border-t border-line">
                <button type="button" class="vn-textbtn" @click="editingAddressId = <%= addr.id %>; showAddAddress = false"><%= t("vene.checkout.edit") %></button>
                <% unless addr.is_default? %>
                  <%= button_to t("vene.addresses.make_default"), set_default_address_path(addr, locale: I18n.locale), method: :patch, class: "vn-textbtn", form: { class: "inline" } %>
                <% end %>
                <%= button_to t("vene.addresses.delete"), address_path(addr, locale: I18n.locale), method: :delete, class: "vn-textbtn vn-textbtn--danger",
                      form: { class: "inline", data: { turbo_confirm: t("vene.addresses.confirm_delete") } } %>
              </div>
            </div>
            <div x-show="editingAddressId === <%= addr.id %>" x-cloak>
              <%= form_with model: addr, url: address_path(addr, locale: I18n.locale), method: :patch, local: true, class: "flex flex-col gap-6" do |f| %>
                <%= render "shared/vene/address_fields", f: f %>
                <div class="flex flex-wrap gap-3">
                  <%= f.button t("vene.addresses.update"), type: "submit", class: "vn-btn vn-btn--primary" %>
                  <button type="button" class="vn-btn vn-btn--outline" @click="editingAddressId = null"><%= t("common.cancel") %></button>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div x-show="!showAddAddress" class="flex flex-col items-center gap-6 py-16 px-6 text-center bg-surface-sunken">
        <p class="m-0 font-display text-2xl leading-8"><%= t("vene.addresses.empty") %></p>
        <button type="button" class="vn-btn vn-btn--primary" @click="showAddAddress = true"><%= t("vene.addresses.add_first") %></button>
      </div>
    <% end %>
  </section>

  <%# ---------- Password ---------- %>
  <section x-show="activeTab === 'security'" x-cloak aria-labelledby="security-title" class="max-w-[760px] flex flex-col gap-8">
    <div class="flex flex-col gap-2">
      <h2 id="security-title" class="vn-h2 m-0"><%= t("vene.account.security") %></h2>
      <p class="m-0 vn-small"><%= t("vene.account.security_text") %></p>
    </div>
    <%= form_with model: current_user, url: user_registration_path(locale: I18n.locale), method: :put, local: true, class: "flex flex-col gap-6" do |f| %>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6">
        <div class="vn-field col-span-full max-w-[360px]"><%= f.label :current_password, t("vene.account.current_password"), class: "vn-field__label" %><%= f.password_field :current_password, autocomplete: "current-password", class: "vn-input" %></div>
        <div class="vn-field"><%= f.label :password, t("vene.account.new_password"), class: "vn-field__label" %><%= f.password_field :password, autocomplete: "new-password", class: "vn-input" %></div>
        <div class="vn-field"><%= f.label :password_confirmation, t("vene.account.confirm_password"), class: "vn-field__label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "vn-input" %></div>
      </div>
      <div><%= f.button t("vene.account.update_password"), type: "submit", class: "vn-btn vn-btn--primary" %></div>
    <% end %>
  </section>
</div>
