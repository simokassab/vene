<% content_for :title, "#{t('guest_checkout.create_account_title')} · VENÈ Jewelry" %>
<%# After a guest checkout: confirm the order, then offer an account linked to it. %>
<%= render "shared/vene/auth_shell" do %>
  <div class="flex flex-col gap-6">
    <%= render "shared/vene/notice", text: safe_join([t("guest_checkout.order_placed"), " · ", tag.bdi("#{t('vene.orders.number_prefix')}#{@order.id}", class: "font-latin")]) %>
    <%= render "shared/vene/eyebrow", text: t("vene.auth.optional") %>
    <h1 class="vn-h2 m-0"><%= t("guest_checkout.create_account_title") %></h1>
    <p class="m-0 text-[15px] leading-6 text-ink-muted"><%= t("guest_checkout.create_account_subtitle") %></p>
    <%= form_with model: @user, url: guest_registration_path(locale: I18n.locale), method: :post, data: { turbo: false }, class: "flex flex-col gap-6" do |form| %>
      <%= render "shared/vene/form_errors", record: @user %>
      <div class="vn-field">
        <%= form.label :email, t("activerecord.attributes.user.email"), class: "vn-field__label" %>
        <%= form.email_field :email, value: @order.email, readonly: true, dir: "ltr", class: "vn-input text-ink-muted", "aria-describedby": "email-hint" %>
        <span id="email-hint" class="vn-field__hint"><%= t("guest_checkout.email_from_order") %></span>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-6">
        <div class="vn-field">
          <%= form.label :name, t("activerecord.attributes.user.name"), class: "vn-field__label" %>
          <%= form.text_field :name, required: true, autocomplete: "name", class: "vn-input" %>
        </div>
        <div class="vn-field">
          <%= form.label :phone, t("activerecord.attributes.user.phone"), class: "vn-field__label" %>
          <%= form.text_field :phone, autocomplete: "tel", dir: "ltr", class: "vn-input" %>
        </div>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-6">
        <div class="vn-field">
          <%= form.label :password, t("activerecord.attributes.user.password"), class: "vn-field__label" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", class: "vn-input", "aria-describedby": "pw-hint" %>
          <span id="pw-hint" class="vn-field__hint"><%= t("auth.min_password") %></span>
        </div>
        <div class="vn-field">
          <%= form.label :password_confirmation, t("activerecord.attributes.user.password_confirmation"), class: "vn-field__label" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "vn-input" %>
        </div>
      </div>
      <%= form.button t("guest_checkout.create_account_button"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
      <%= link_to t("guest_checkout.skip_account"), order_path(@order, locale: I18n.locale), class: "vn-btn vn-btn--link self-center" %>
    <% end %>
  </div>
<% end %>
