<% content_for :full_width, true %>
<% content_for :title, "#{t('nav.search')} · VENÈ Jewelry" %>
<%# Search: a quiet field under a display heading, then the same grid as a collection. %>
<div class="vn-container pt-[clamp(48px,6vw,96px)] pb-[var(--section)]">
  <%= render "shared/vene/page_header", eyebrow: t("nav.search"),
        title: (@query.present? ? t("vene.search.results_for", query: @query) : t("vene.search.title")) %>

  <%= form_with url: search_path(locale: I18n.locale), method: :get, local: true, role: "search", class: "mt-10 mb-12 flex items-end gap-4 max-w-[640px]" do %>
    <div class="vn-field flex-1">
      <label for="search-q" class="vn-field__label"><%= t("vene.search.label") %></label>
      <input id="search-q" type="search" name="q" value="<%= @query %>" placeholder="<%= t('vene.header.search_placeholder') %>" class="vn-input">
    </div>
    <button type="submit" class="vn-btn vn-btn--primary"><%= t("nav.search") %></button>
  <% end %>

  <% if @query.blank? %>
    <div class="flex flex-col items-center gap-4 py-24 px-4 text-center bg-surface-sunken">
      <p class="vn-h2 !font-light m-0"><%= t("vene.search.enter_query") %></p>
      <p class="m-0 text-[15px] leading-6 text-ink-muted"><%= t("vene.search.tip") %></p>
    </div>
  <% elsif @products.empty? %>
    <div class="flex flex-col items-center gap-6 py-24 px-4 text-center bg-surface-sunken">
      <p class="vn-h2 !font-light m-0"><%= t("vene.search.no_results") %></p>
      <p class="m-0 text-[15px] leading-6 text-ink-muted max-w-[460px]"><%= t("vene.search.try_again") %></p>
      <%= render "shared/vene/button", label: t("storefront.home.hero_cta"), href: products_path(locale: I18n.locale), variant: :outline %>
    </div>
  <% else %>
    <p aria-live="polite" class="m-0 mb-6 vn-small"><%= t("vene.collection.count", count: @products.size) %></p>
    <div class="vn-products">
      <% @products.each do |product| %>
        <%= render "shared/vene/product_card", product: product, heading: :h2 %>
      <% end %>
    </div>
  <% end %>
</div>
