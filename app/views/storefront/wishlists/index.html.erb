<% content_for :full_width, true %>
<% content_for :title, "#{t('vene.header.wishlist')} · VENÈ Jewelry" %>
<%# Account → Wishlist: saved pieces with stock and price-drop state, each movable to the bag
    (or ordered on WhatsApp when made to order). %>
<div class="vn-container pt-[clamp(48px,6vw,96px)] pb-[var(--section)] flex flex-col gap-12">
  <%= render "shared/vene/page_header", eyebrow: t("vene.account.eyebrow"), title: t("vene.header.wishlist"),
        meta: (@wishlist_items.any? ? t("vene.cart.count", count: @wishlist_items.size) : nil) %>
  <%= render "shared/vene/account_nav", active: :wishlist %>

  <% if @wishlist_items.empty? %>
    <div class="flex flex-col items-center gap-6 py-24 px-4 text-center bg-surface-sunken">
      <p class="vn-h2 !font-light m-0"><%= t("wishlist.empty_title") %></p>
      <p class="m-0 text-[15px] leading-6 text-ink-muted max-w-[460px]"><%= t("wishlist.empty_message") %></p>
      <%= render "shared/vene/button", label: t("wishlist.start_shopping"), href: products_path(locale: I18n.locale), arrow: true %>
    </div>
  <% else %>
    <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-x-8 gap-y-12">
      <% @wishlist_items.each do |item| %>
        <% product = item.product %>
        <%# Opens the product on the saved color (?color=rose-gold). %>
        <% href = product_path(product.slug, locale: I18n.locale, color: item.product_variant&.image_option&.slug) %>
        <% made_to_order = product.made_to_order_with?(item.product_variant) %>
        <li class="flex flex-col gap-3">
          <div class="relative">
            <%= link_to href, class: "flex aspect-[4/5] bg-media items-center justify-center overflow-hidden", tabindex: "-1", "aria-hidden": "true" do %>
              <% if (src = vn_product_image_url(product, variant: item.product_variant)) %>
                <%= image_tag src, alt: "", loading: "lazy", class: "block w-[84%] h-[84%] object-contain" %>
              <% end %>
            <% end %>
            <div class="vn-card__badge">
              <%# Made to order takes precedence: such pieces are not held in stock, so "out of stock" would misdescribe them. %>
              <% if made_to_order %>
                <%= render "shared/made_to_order_badge", product: product, variant: item.product_variant, positioned: false %>
              <% elsif !item.in_stock? %>
                <span class="vn-badge vn-badge--noir"><%= t("vene.product.sold_out") %></span>
              <% end %>
              <% if item.price_dropped? %>
                <span class="vn-badge vn-badge--gold"><%= t("wishlist.price_dropped", percentage: item.price_drop_percentage) %></span>
              <% end %>
            </div>
          </div>
          <div class="flex flex-col gap-1 text-center pt-1">
            <span class="vn-card__metal"><%= product.sub_category&.name(I18n.locale) %></span>
            <h2 class="vn-card__name"><%= link_to product.name(I18n.locale), href, class: "text-inherit no-underline hover:text-gold-text" %></h2>
            <% if item.product_variant %><span class="vn-small"><%= item.product_variant.display_name %></span><% end %>
            <span class="inline-flex justify-center items-baseline gap-2">
              <%= vn_price(item.current_price) %>
              <% if item.price_dropped? %><s class="text-ink-subtle"><%= vn_price(item.price_when_added, css: "!text-[13px]") %></s><% end %>
            </span>
            <% unless made_to_order %>
              <span class="vn-status <%= item.in_stock? ? 'vn-status--ok' : 'vn-status--bad' %> justify-center"><%= item.in_stock? ? t("wishlist.in_stock") : t("wishlist.out_of_stock") %></span>
            <% end %>
          </div>
          <% if made_to_order %>
            <% if (wa = made_to_order_whatsapp_url(product, variant: item.product_variant)) %>
              <%= link_to wa, target: "_blank", rel: "noopener", class: "vn-btn vn-btn--outline vn-btn--sm vn-btn--block" do %>
                <%= render "shared/whatsapp_icon", css_class: "w-4 h-4" %><span><%= t("products.order_on_whatsapp") %></span>
              <% end %>
            <% end %>
          <% elsif item.in_stock? %>
            <%= form_with url: add_item_cart_path(locale: I18n.locale), method: :post do |f| %>
              <%= hidden_field_tag :product_id, product.id, id: nil %>
              <% if item.product_variant %><%= hidden_field_tag :product_variant_id, item.product_variant.id, id: nil %><% end %>
              <%= hidden_field_tag :quantity, 1, id: nil %>
              <%= hidden_field_tag :redirect_to, wishlist_items_path(locale: I18n.locale), id: nil %>
              <button type="submit" class="vn-btn vn-btn--outline vn-btn--sm vn-btn--block" aria-label="<%= t('vene.wishlist.move_to_bag', name: product.name(I18n.locale)) %>"><%= t("vene.wishlist.to_bag") %></button>
            <% end %>
          <% end %>
          <%= button_to t("cart.remove"), wishlist_item_path(item, locale: I18n.locale), method: :delete, class: "vn-textbtn", form: { class: "self-center" },
                "aria-label": t("vene.wishlist.remove", name: product.name(I18n.locale)), data: { turbo_frame: "_top" } %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
