<%# Collection.dc.html: breadcrumb, centred heading, filter and sort bar, the grid, then help. %>
<% content_for :title, "#{@category.name(I18n.locale)} · VENÈ Jewelry" %>
<% content_for :full_width, true %>
<% count = @products.size %>
<% subcategories = @subcategories_with_counts.to_a %>
<% total = subcategories.sum { |s| s.products_count.to_i } %>
<% whatsapp = current_settings.whatsapp_phone_number.to_s.gsub(/[^0-9]/, "") %>

<div class="vn-container pb-[var(--section)]">
  <%= render "shared/vene/breadcrumb",
        trail: (@selected_subcategory ? [[@category.name(I18n.locale), category_path(@category.slug, locale: I18n.locale)]] : []),
        current: (@selected_subcategory || @category).name(I18n.locale) %>

  <div class="pt-[clamp(32px,5vw,64px)] pb-12">
    <%= render "shared/vene/page_header",
          eyebrow: t("vene.collection.eyebrow"),
          title: (@selected_subcategory || @category).name(I18n.locale),
          lead: @selected_subcategory&.description(I18n.locale).presence || t("vene.collection.lead"),
          align: :center %>
  </div>

  <div role="group" aria-label="<%= t('vene.collection.filter_sort') %>"
       class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 py-4 border-y border-line mb-12">
    <% if subcategories.any? %>
      <nav aria-label="<%= t('vene.collection.subcategories') %>" x-data x-init="$el.querySelector('[aria-current=page]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' })" class="vn-scroll-x flex items-center gap-3 overflow-x-auto max-w-full">
        <span class="vn-label whitespace-nowrap me-1"><%= t("vene.collection.category") %></span>
        <%= link_to category_path(@category.slug, locale: I18n.locale, sort: @sort, color: @selected_color&.slug), class: "vn-chip", "aria-current": (@selected_subcategory ? nil : "page") do %>
          <%= t("vene.collection.all") %> <span class="vn-num font-latin opacity-70"><%= total %></span>
        <% end %>
        <% subcategories.each do |sub| %>
          <%= link_to category_path(@category.slug, locale: I18n.locale, subcategory: sub.slug, sort: @sort, color: @selected_color&.slug), class: "vn-chip",
                "aria-current": (@selected_subcategory&.id == sub.id ? "page" : nil) do %>
            <%= sub.name(I18n.locale) %> <span class="vn-num font-latin opacity-70"><%= sub.products_count %></span>
          <% end %>
        <% end %>
      </nav>
    <% end %>
    <%= render "shared/vene/color_filter", options: @color_options, selected: @selected_color,
          href_for: ->(option) { category_path(@category.slug, locale: I18n.locale, subcategory: @selected_subcategory&.slug, sort: @sort, color: option&.slug) } %>
    <%= form_with url: category_path(@category.slug, locale: I18n.locale), method: :get, local: true, class: "flex items-center gap-3 min-w-[220px]" do %>
      <% if @selected_subcategory %><%= hidden_field_tag :subcategory, @selected_subcategory.slug %><% end %>
      <% if @selected_color %><%= hidden_field_tag :color, @selected_color.slug %><% end %>
      <label for="sort" class="vn-label whitespace-nowrap"><%= t("vene.collection.sort") %></label>
      <%= select_tag :sort, options_for_select({
            t("vene.collection.sort_featured") => "featured",
            t("vene.collection.sort_price_low") => "price_low",
            t("vene.collection.sort_price_high") => "price_high",
            t("vene.collection.sort_newest") => "newest"
          }, @sort), id: "sort", class: "vn-select", onchange: "this.form.requestSubmit()" %>
      <noscript><button type="submit" class="vn-btn vn-btn--outline vn-btn--sm"><%= t("vene.collection.apply") %></button></noscript>
    <% end %>
  </div>

  <p aria-live="polite" class="m-0 mb-6 vn-small"><%= t("vene.collection.count", count: count) %></p>

  <% if count.positive? %>
    <div class="vn-products">
      <% @products.each do |product| %>
        <%= render "shared/vene/product_card", product: product, heading: :h2, color: @selected_color %>
      <% end %>
    </div>
  <% else %>
    <div class="flex flex-col items-center gap-6 py-24 px-4 text-center bg-surface-sunken">
      <p class="vn-h2 !font-light m-0"><%= t("vene.collection.empty_title") %></p>
      <p class="m-0 text-[15px] leading-6 text-ink-muted max-w-[460px]"><%= t("vene.collection.empty_text") %></p>
      <%= render "shared/vene/button", label: t("vene.collection.clear"), href: category_path(@category.slug, locale: I18n.locale), variant: :outline %>
    </div>
  <% end %>

  <div class="mt-24">
    <%= render "shared/vene/help_card", variant: :banner, title: t("vene.collection.help_title"), text: t("vene.collection.help_text") do %>
      <button type="button" class="vn-btn vn-btn--outline" @click="ringSizeModal = true"><%= t("footer.ring_size_guide") %></button>
      <% if whatsapp.present? %>
        <a href="https://wa.me/<%= whatsapp %>" target="_blank" rel="noopener" class="vn-btn vn-btn--primary"><%= t("vene.header.whatsapp") %></a>
      <% end %>
    <% end %>
  </div>
</div>
