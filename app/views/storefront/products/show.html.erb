<%
  content_for :title, "#{@product.name} | VENÈ Jewelry"
  content_for :og_description, @product.description.to_s.squish.truncate(300)
  content_for :og_image, image_url(@product.primary_image.image.url) if @product.primary_image&.image&.url.present?
  content_for :og_type, "product"
  content_for :head, meta_catalog_microdata(@product)
  content_for :full_width, true
%>
<%
  images = @product.product_images.to_a
  primary_url = @product.primary_image&.image&.url
  name = @product.name(I18n.locale)
  category = @product.category
  metal_line = [@product.metal, @product.diamonds, @product.gemstones].compact_blank.join(" · ")
  page_config = {
    primaryUrl: primary_url,
    images: images.map { |img| img.image.url },
    hasVariants: @product.has_variants?,
    product: { stock: @product.stock_quantity, allowPreorder: @product.allow_preorder?,
               estimatedDate: @product.estimated_delivery_date&.iso8601 || "",
               madeToOrder: @product.made_to_order?, purchasable: @product.purchasable? },
    picker: (vn_variant_picker_data(@product, images) if @product.has_variants?)
  }
%>
<%# Product.dc.html: gallery on the start side, the buy box beside it, accordions under the
    actions, then related pieces. State lives in components/product_page.js: the picker
    (color swaps the photos), and the purchase logic, which reads selectedVariant. %>
<div x-data="productPage(<%= page_config.to_json %>)" @keydown.escape.window="showImageModal = false" class="vn-container">
  <%= render "shared/vene/breadcrumb", trail: [[category.name(I18n.locale), category_path(category.slug, locale: I18n.locale)]], current: name %>

  <div class="flex flex-wrap items-start gap-y-12 gap-x-[clamp(48px,6vw,96px)] pb-[var(--section)]">
    <%# ---------- Gallery ---------- %>
    <section aria-label="<%= t('vene.product.images') %>" class="flex-[1_1_560px] min-w-0 flex flex-col gap-4 lg:sticky lg:top-[180px]">
      <div class="relative aspect-square bg-media overflow-hidden">
        <%# Inline rather than shared/_made_to_order_badge: it tracks the selected variant live. %>
        <span x-show="currentIsPreorder" x-cloak class="vn-badge vn-badge--gold absolute top-4 start-4 z-20 pointer-events-none">
          <%= t("products.made_to_order_badge") %>
        </span>
        <% if @product.video.present? %>
          <div x-show="viewingVideo" x-cloak class="absolute inset-0 bg-media">
            <video controls controlsList="nodownload" class="w-full h-full object-contain"
                   x-init="$watch('viewingVideo', value => { if (!value) { $el.pause(); $el.currentTime = 0; } })">
              <source src="<%= @product.video.url %>" type="video/mp4">
              <%= t("products.video_not_supported") %>
            </video>
            <button type="button" @click="viewingVideo = false" class="vn-icon-btn absolute top-3 end-3 z-10 bg-surface-raised/80" aria-label="<%= t('common.close') %>">
              <%= vn_icon(:close, size: 20) %>
            </button>
          </div>
        <% end %>
        <div x-show="!viewingVideo" class="absolute inset-0 flex items-center justify-center cursor-zoom-in"
             @mouseenter="imageZoom = true" @mouseleave="imageZoom = false" @mousemove="handleMouseMove"
             @click="showImageModal = true">
          <% if primary_url %>
            <img :src="activeImage" src="<%= primary_url %>" alt="<%= name %>" data-main-image
                 class="block w-[88%] h-[88%] object-contain transition-opacity duration-400 ease-vene"
                 :class="imageZoom ? 'opacity-0' : 'opacity-100'">
            <div x-show="imageZoom" x-cloak class="absolute inset-0 pointer-events-none"
                 :style="{ backgroundImage: `url(${activeImage})`, backgroundPosition: `${zoomX}% ${zoomY}%`, backgroundSize: '200%', backgroundRepeat: 'no-repeat' }"></div>
            <span class="vn-hide-sm absolute bottom-4 end-4 vn-small pointer-events-none" x-show="!imageZoom"><%= t("products.hover_to_zoom") %> · <%= t("products.click_fullscreen") %></span>
          <% else %>
            <div class="flex flex-col items-center gap-3 text-ink-subtle"><%= vn_icon(:diamond, size: 56, stroke: 1) %><span class="vn-small"><%= t("vene.product.no_image") %></span></div>
          <% end %>
        </div>
      </div>
      <% if images.size > 1 || @product.video.present? %>
        <div class="grid grid-cols-4 gap-4" x-show="gallery.length > 1 || <%= @product.video.present? %>">
          <% if @product.video.present? %>
            <button type="button" @click="viewingVideo = true; imageZoom = false" :aria-pressed="viewingVideo.toString()"
                    class="aspect-square bg-surface-sunken flex flex-col items-center justify-center gap-1 cursor-pointer border transition-colors duration-400"
                    :class="viewingVideo ? 'border-ink' : 'border-transparent hover:border-line-control'" aria-label="<%= t('products.watch_video') %>">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M7 4v16l13-8Z"/></svg>
              <span class="vn-label !text-[10px] rtl:!text-xs"><%= t("products.video") %></span>
            </button>
          <% end %>
          <%# The gallery follows the chosen color: its own photos, then the shared ones. %>
          <template x-for="(src, index) in gallery" :key="src">
            <button type="button" @click="activeImage = src; imageZoom = false; viewingVideo = false"
                    :aria-pressed="(activeImage === src && !viewingVideo).toString()"
                    :aria-label="'<%= j t('vene.product.show_image', number: '__N__', count: '__C__') %>'.replace('__N__', index + 1).replace('__C__', gallery.length)"
                    class="aspect-square bg-media shadow-hairline cursor-pointer border transition-colors duration-400 p-1"
                    :class="(activeImage === src && !viewingVideo) ? 'border-ink' : 'border-transparent hover:border-line-control'">
              <img :src="src" alt="" loading="lazy" class="block w-full h-full object-contain">
            </button>
          </template>
        </div>
      <% end %>
    </section>

    <%# ---------- Buy box ---------- %>
    <section aria-labelledby="pdp-title" class="flex-[1_1_400px] min-w-0 max-w-[520px] flex flex-col gap-8">
      <div class="flex flex-col gap-3 items-start">
        <%= link_to category.name(I18n.locale), category_path(category.slug, locale: I18n.locale), class: "vn-eyebrow vn-eyebrow--muted no-underline hover:!text-gold-text" %>
        <h1 id="pdp-title" class="m-0 mt-1 font-display font-normal text-[clamp(32px,3.4vw,44px)] leading-[1.15] rtl:font-bold rtl:leading-[1.5]"><%= name %></h1>
        <% if metal_line.present? %><span class="vn-caps text-ink-muted !text-[13px]"><%= metal_line %></span><% end %>
        <div class="flex flex-wrap items-baseline gap-3 pt-2">
          <span x-show="currentIsPreorder" x-cloak class="vn-small"><%= t("products.starting_from") %></span>
          <%= render "shared/product_price", product: @product, size: :page %>
          <% if @product.on_sale_with_price? %>
            <span class="vn-badge vn-badge--outline self-center"><%= t("vene.product.sale") %></span>
          <% end %>
          <% if current_settings.show_tax_notice %>
            <span class="vn-small"><%= t("common.prices_include_tax") %></span>
          <% end %>
        </div>
        <%# x-show so it tracks variant selection. Lead time is per product. %>
        <p x-show="currentIsPreorder" x-cloak class="m-0 vn-small"><%= t("products.made_to_order_line", lead_time: @product.lead_time(I18n.locale)) %></p>
      </div>

      <% if @product.has_variants? %>
        <%# One row per type. Sold-out and missing combinations stay in place, greyed out, and
            remain selectable so a color's photos can still be seen. %>
        <div class="pt-6 border-t border-line flex flex-col gap-6 min-w-0">
          <template x-for="type in types" :key="type.id">
            <div role="group" :aria-labelledby="`variant-label-${type.id}`" class="flex flex-col gap-4">
              <div class="flex justify-between items-baseline gap-4">
                <span :id="`variant-label-${type.id}`" class="vn-label">
                  <span x-text="type.name"></span><span x-show="chosenLabel(type.id)" class="!text-ink"> · <bdi x-text="chosenLabel(type.id)"></bdi></span>
                </span>
                <button type="button" x-show="type.size" class="vn-link bg-transparent border-x-0 border-t-0 cursor-pointer text-[13px] leading-5 p-0 pb-0.5" @click="ringSizeModal = true"><%= t("footer.ring_size_guide") %></button>
              </div>
              <div x-show="type.swatch" class="flex flex-wrap gap-5 ps-1">
                <template x-for="option in type.options" :key="option.id">
                  <button type="button" class="vn-metal"
                          :class="[isChosen(type.id, option.id) && 'is-active', ['yellow','rose','white'].includes(option.swatch) && `vn-metal--${option.swatch}`, optionState(type.id, option.id) !== 'ok' && 'opacity-40']"
                          :style="option.swatch && option.swatch.startsWith('#') ? `background:${option.swatch}` : ''"
                          :aria-pressed="isChosen(type.id, option.id).toString()"
                          :aria-label="option.label + (optionState(type.id, option.id) === 'ok' ? '' : ' — <%= j t('products.out_of_stock') %>')"
                          :title="option.label"
                          @click="choose(type.id, option.id)"></button>
                </template>
              </div>
              <div x-show="!type.swatch" class="flex flex-wrap gap-2">
                <template x-for="option in type.options" :key="option.id">
                  <button type="button" class="vn-chip min-w-14 !px-4 justify-center relative font-latin vn-num !tracking-wide"
                          :class="[isChosen(type.id, option.id) && 'is-active', optionState(type.id, option.id) !== 'ok' && 'opacity-40 line-through']"
                          :aria-pressed="isChosen(type.id, option.id).toString()"
                          @click="choose(type.id, option.id)">
                    <bdi x-text="option.label"></bdi>
                    <span class="sr-only" x-show="optionState(type.id, option.id) !== 'ok'"> — <%= t("products.out_of_stock") %></span>
                  </button>
                </template>
              </div>
            </div>
          </template>
          <p x-show="!allChosen()" class="m-0 text-[13px] leading-5 text-ink-muted"
             x-text="'<%= j t('auth.please_select', option: '__OPTION__') %>'.replace('__OPTION__', missingTypeNames().join(' · '))"></p>
          <p x-show="combinationMissing" x-cloak role="status" class="m-0 text-[13px] leading-5 text-ink-muted"><%= t("vene.product.combination_missing") %></p>
        </div>
      <% end %>

      <div class="flex flex-col gap-4">
        <div x-show="!currentIsPreorder" class="flex flex-col gap-3">
          <div class="flex items-center justify-between gap-4">
            <span class="vn-label" id="qty-label"><%= t("vene.product.quantity") %></span>
            <span class="vn-small" x-show="!currentIsPreorder && currentStock > 0"><bdi class="font-latin vn-num" x-text="currentStock"></bdi> <%= t("products.available") %></span>
          </div>
          <div class="inline-flex items-center self-start border border-line-control" role="group" aria-labelledby="qty-label">
            <button type="button" class="vn-icon-btn" @click="decrementQuantity()" :disabled="quantity <= 1" :class="quantity <= 1 && 'opacity-40 cursor-not-allowed'" aria-label="<%= t('vene.product.decrease') %>"><%= vn_icon(:minus, size: 16) %></button>
            <input type="number" x-model.number="quantity" min="1" :max="currentMaxQty" aria-labelledby="qty-label"
                   class="w-14 h-11 text-center border-0 bg-transparent font-latin vn-num text-[15px] focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none">
            <button type="button" class="vn-icon-btn" @click="incrementQuantity()" :disabled="quantity >= currentMaxQty" :class="quantity >= currentMaxQty && 'opacity-40 cursor-not-allowed'" aria-label="<%= t('vene.product.increase') %>"><%= vn_icon(:plus, size: 16) %></button>
          </div>
          <p x-show="!currentIsPreorder && currentStock > 0 && currentStock <= 5 && (!hasVariants || selectedVariant)" class="m-0 text-[13px] leading-5 text-gold-text"
             x-text="'<%= j t('products.low_stock', count: '__COUNT__') %>'.replace('__COUNT__', currentStock)"></p>
          <p x-show="!currentCanPurchase && (!hasVariants || selectedVariant)" role="alert" class="m-0 text-[13px] leading-5 text-danger"><%= t("products.out_of_stock_no_preorder") %></p>
        </div>

        <%
          # One href per variant so the enquiry names the exact piece.
          wa_hrefs = { "default" => made_to_order_whatsapp_url(@product, url: request.original_url) }
          if @product.has_variants?
            # display_name reads each option and its type, so eager-load both.
            @product.product_variants.active.includes(:variant_type, :variant_option, product_variant_options: %i[variant_type variant_option]).each do |pv|
              wa_hrefs[pv.id.to_s] = made_to_order_whatsapp_url(@product, variant: pv, url: request.original_url)
            end
          end
        %>
        <div class="flex flex-col gap-3" x-data="{ waHrefs: <%= wa_hrefs.to_json %> }">
          <%# Made-to-order pieces are ordered over WhatsApp instead of online checkout. %>
          <% if wa_hrefs["default"].present? %>
            <a x-show="currentIsPreorder" x-cloak :href="waHrefs[selectedVariant] || waHrefs['default']" href="<%= wa_hrefs['default'] %>"
               target="_blank" rel="noopener" class="vn-btn vn-btn--primary vn-btn--block">
              <%= render "shared/whatsapp_icon", css_class: "w-4 h-4" %><span><%= t("products.order_on_whatsapp") %></span>
            </a>
          <% end %>
          <form action="<%= add_item_cart_path(locale: I18n.locale) %>" method="post" x-show="!currentIsPreorder">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= hidden_field_tag :product_id, @product.id %>
            <input type="hidden" name="product_variant_id" x-model="selectedVariant">
            <input type="hidden" name="quantity" x-model="quantity">
            <button type="submit" class="vn-btn vn-btn--primary vn-btn--block"
                    :disabled="(hasVariants && !selectedVariant) || !currentCanPurchase"
                    :aria-disabled="((hasVariants && !selectedVariant) || !currentCanPurchase).toString()">
              <span x-show="currentCanPurchase"><%= t("vene.product.add_to_bag") %></span>
              <span x-show="!currentCanPurchase" x-cloak><%= t("products.not_available") %></span>
            </button>
          </form>
          <form action="<%= add_item_cart_path(locale: I18n.locale) %>" method="post" x-show="!currentIsPreorder && currentCanPurchase">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= hidden_field_tag :product_id, @product.id %>
            <%= hidden_field_tag :redirect_to, checkout_path(locale: I18n.locale) %>
            <input type="hidden" name="product_variant_id" x-model="selectedVariant">
            <input type="hidden" name="quantity" x-model="quantity">
            <button type="submit" class="vn-btn vn-btn--outline vn-btn--block"
                    :disabled="(hasVariants && !selectedVariant) || !currentCanPurchase"
                    :aria-disabled="((hasVariants && !selectedVariant) || !currentCanPurchase).toString()">
              <%= t("products.buy_now") %>
            </button>
          </form>
        </div>

        <div class="flex flex-wrap justify-between items-center gap-x-6 gap-y-2 pt-2">
          <span class="inline-flex items-center gap-2 vn-small">
            <%= vn_icon(:truck, size: 18) %>
            <span x-show="currentIsPreorder" x-cloak><%= t("vene.product.mto_shipping", lead_time: @product.lead_time(I18n.locale)) %></span>
            <span x-show="!currentIsPreorder"><%= t("products.shipping_note") %></span>
          </span>
          <%= render "shared/wishlist_button", product: @product %>
        </div>
      </div>

      <ul class="list-none m-0 p-0 grid grid-cols-3 gap-4 py-6 border-y border-line">
        <li><%= render "shared/vene/feature_item", icon: :shield, text: t("vene.product.authentic"), layout: :compact %></li>
        <li><%= render "shared/vene/feature_item", icon: :package, text: t("vene.product.gift_ready"), layout: :compact %></li>
        <li><%= render "shared/vene/feature_item", icon: :gem, text: t("vene.home.promise.handcrafted_title"), layout: :compact %></li>
      </ul>

      <div class="-mt-8">
        <% summary = "flex justify-between items-center min-h-14 cursor-pointer list-none vn-caps !text-[13px] [&::-webkit-details-marker]:hidden" %>
        <details open class="group border-b border-line">
          <summary class="<%= summary %>"><%= t("vene.product.description") %><span aria-hidden="true" class="font-latin text-lg group-open:hidden">+</span><span aria-hidden="true" class="font-latin text-lg hidden group-open:inline">−</span></summary>
          <div class="pb-6 flex flex-col gap-3 vn-prose !max-w-none [&_p]:!text-[15px] [&_p]:!leading-6 rtl:[&_p]:!text-base rtl:[&_p]:!leading-7">
            <%= simple_format(@product.description(I18n.locale)) %>
            <p class="!text-[13px] !leading-5"><%= t("vene.product.appearance_note") %></p>
          </div>
        </details>
        <details class="group border-b border-line">
          <summary class="<%= summary %>"><%= t("vene.product.specifications") %><span aria-hidden="true" class="font-latin text-lg group-open:hidden">+</span><span aria-hidden="true" class="font-latin text-lg hidden group-open:inline">−</span></summary>
          <dl class="m-0 pb-6 grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-x-6 gap-y-3 text-[15px] leading-6">
            <dt class="text-ink-muted"><%= t("products.metal") %></dt><dd class="m-0"><%= @product.metal.presence || "—" %></dd>
            <dt class="text-ink-muted"><%= t("products.diamonds") %></dt><dd class="m-0"><%= @product.diamonds.presence || "—" %></dd>
            <dt class="text-ink-muted"><%= t("products.gemstones") %></dt><dd class="m-0"><%= @product.gemstones.presence || "—" %></dd>
            <% if @product.others.present? %>
              <dt class="text-ink-muted"><%= t("vene.product.others") %></dt><dd class="m-0"><%= @product.others %></dd>
            <% end %>
            <dt class="text-ink-muted"><%= t("vene.product.category") %></dt><dd class="m-0"><%= category.name(I18n.locale) %></dd>
            <dt class="text-ink-muted"><%= t("vene.product.made_in") %></dt><dd class="m-0"><%= t("vene.product.beirut") %></dd>
          </dl>
        </details>
        <details class="group border-b border-line">
          <summary class="<%= summary %>"><%= t("vene.product.delivery_returns") %><span aria-hidden="true" class="font-latin text-lg group-open:hidden">+</span><span aria-hidden="true" class="font-latin text-lg hidden group-open:inline">−</span></summary>
          <div class="pb-6 flex flex-col gap-3 text-[15px] leading-6 text-ink-muted">
            <p class="m-0"><strong class="font-medium text-ink"><%= t("products.shipping_title") %>.</strong> <%= t("vene.home.promise.dhl_text") %></p>
            <p class="m-0"><strong class="font-medium text-ink"><%= t("products.shipping_time_title") %>.</strong> <%= t("vene.product.shipping_time") %></p>
            <p class="m-0"><%= t("vene.product.duties") %></p>
            <%= link_to t("pages.refund"), page_path("refund-and-cancellation-policy", locale: I18n.locale), class: "vn-link self-start text-[13px]" %>
          </div>
        </details>
      </div>
    </section>
  </div>

  <%# ---------- Related pieces ---------- %>
  <% if @related_products.any? %>
    <section aria-labelledby="related-title" class="pb-[var(--section)]">
      <header class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div class="flex flex-col gap-4">
          <%= render "shared/vene/eyebrow", text: category.name(I18n.locale) %>
          <h2 id="related-title" class="vn-h1 m-0"><%= t("products.related") %></h2>
        </div>
        <%= render "shared/vene/button", label: t("home.view_all"), href: category_path(category.slug, locale: I18n.locale), variant: :link, arrow: true %>
      </header>
      <div class="vn-products">
        <% @related_products.each do |product| %>
          <%= render "shared/vene/product_card", product: product %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ---------- Fullscreen image ---------- %>
  <div x-show="showImageModal" x-cloak x-transition.opacity.duration.400ms @click="showImageModal = false"
       class="fixed inset-0 z-50 bg-media flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="<%= name %>">
    <button type="button" @click="showImageModal = false" class="vn-icon-btn absolute top-4 end-4" aria-label="<%= t('common.close') %>"><%= vn_icon(:close, size: 24) %></button>
    <img :src="activeImage" alt="<%= name %>" class="block max-w-full max-h-[90vh] object-contain" @click.stop>
  </div>
</div>
<%# GA4 ecommerce: product detail view %>
<%= ga4_data_layer Ga4.view_item_event(@product) %>
<%# Meta Pixel: product detail view %>
<%= meta_pixel_event MetaPixel.view_content_event(@product) %>
