<% content_for :title, "#{t('products.all')} · VENÈ Jewelry" %>
<%# Every piece: the collection layout with categories as chips. %>
<%= render "shared/vene/breadcrumb", current: t("products.all") %>
<div class="pt-[clamp(32px,5vw,64px)] pb-12">
  <%= render "shared/vene/page_header", eyebrow: t("vene.collection.eyebrow"), title: t("vene.collection.fine_jewelry"), lead: t("vene.collection.lead"), align: :center %>
</div>
<% if @categories.any? %>
  <nav aria-label="<%= t('vene.home.categories') %>" class="vn-scroll-x flex items-center gap-3 overflow-x-auto py-4 border-y border-line mb-12">
    <span class="vn-label whitespace-nowrap me-1"><%= t("vene.collection.category") %></span>
    <span class="vn-chip is-active" aria-current="page"><%= t("vene.collection.all") %></span>
    <% @categories.each do |category| %>
      <%= link_to category.name(I18n.locale), category_path(category.slug, locale: I18n.locale), class: "vn-chip" %>
    <% end %>
  </nav>
<% end %>
<p aria-live="polite" class="m-0 mb-6 vn-small"><%= t("vene.collection.count", count: @products.size) %></p>
<div class="vn-products">
  <% @products.each do |product| %>
    <%= render "shared/vene/product_card", product: product, heading: :h2 %>
  <% end %>
</div>
