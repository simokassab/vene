<% content_for :full_width, true %>
<%# Cart.dc.html: the bag on the start side, the order summary beside it. Quantity updates, coupons
    and the remove confirmation keep their existing forms. %>
<% whatsapp = current_settings.whatsapp_phone_number.to_s.gsub(/[^0-9]/, "") %>
<div x-data="{ showRemoveModal: false, itemToRemove: null }" @keydown.escape.window="showRemoveModal = false"
     class="vn-container pt-[clamp(48px,6vw,96px)] pb-[var(--section)]">
  <header class="flex flex-wrap items-baseline justify-between gap-4 mb-12">
    <div class="flex flex-col gap-3">
      <h1 class="vn-display-l m-0"><%= t("vene.cart.title") %></h1>
      <% if @cart.items.any? %>
        <span class="vn-small"><%= t("vene.cart.count", count: @cart.items.sum(&:quantity)) %></span>
      <% end %>
    </div>
    <%= link_to t("cart.continue_shopping"), products_path(locale: I18n.locale), class: "vn-link text-[13px] tracking-nav uppercase rtl:text-sm" %>
  </header>

  <% if @cart.items.empty? %>
    <div class="flex flex-col items-center gap-6 py-32 px-4 text-center bg-surface-sunken">
      <p class="m-0 font-display font-light text-[44px] leading-[52px] rtl:text-[32px] rtl:leading-[48px]"><%= t("vene.cart.empty_title") %></p>
      <p class="m-0 max-w-[460px] text-[15px] leading-6 text-ink-muted"><%= t("vene.cart.empty_text") %></p>
      <%= render "shared/vene/button", label: t("storefront.home.hero_cta"), href: products_path(locale: I18n.locale), arrow: true %>
    </div>
  <% else %>
    <div class="flex flex-wrap items-start gap-y-12 gap-x-[clamp(48px,6vw,96px)]">
      <section aria-label="<%= t('vene.cart.pieces') %>" class="flex-[999_1_560px] min-w-0">
        <ul class="list-none m-0 p-0 border-t border-line">
          <% @cart.items.each do |item| %>
            <% product = item.product %>
            <% href = product_path(product.slug, locale: I18n.locale) %>
            <% meta = [product.metal.presence, item.product_variant&.display_name].compact.join(" · ") %>
            <% unit = capture do %><%= vn_price(item.unit_price) %> <%= t("cart.each") %><% if product.on_sale_with_price? %> <s class="text-ink-subtle"><%= vn_price(product.price) %></s><% end %><% end %>
            <li class="py-8 border-b border-line">
              <%= render "shared/vene/line_item", size: :lg, heading: :h2, href: href, title: product.name(I18n.locale),
                    image: vn_product_image_url(product, variant: item.product_variant), meta: meta.presence || product.category.name(I18n.locale),
                    detail: unit, price: vn_price(item.line_total) do %>
                <span x-data="{ qty: <%= item.quantity %> }" class="contents">
                <%= form_with url: update_item_cart_path(locale: I18n.locale), method: :patch, local: true,
                      class: "flex items-center gap-3" do |f| %>
                  <%= hidden_field_tag :cart_key, item.cart_key, id: nil %>
                  <span class="inline-flex items-center border border-line-control" role="group" aria-label="<%= t('vene.product.quantity') %>: <%= product.name(I18n.locale) %>">
                    <button type="button" class="vn-icon-btn" @click="qty = Math.max(1, qty - 1)" aria-label="<%= t('vene.product.decrease') %>"><%= vn_icon(:minus, size: 14) %></button>
                    <input type="number" name="quantity" min="1" x-model.number="qty" value="<%= item.quantity %>" aria-label="<%= t('vene.product.quantity') %>"
                           class="w-10 h-11 text-center border-0 bg-transparent font-latin vn-num text-[15px] focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none">
                    <button type="button" class="vn-icon-btn" @click="qty = qty + 1" aria-label="<%= t('vene.product.increase') %>"><%= vn_icon(:plus, size: 14) %></button>
                  </span>
                  <button type="submit" class="vn-textbtn" x-show="qty !== <%= item.quantity %>" x-cloak><%= t("cart.update") %></button>
                  <noscript><button type="submit" class="vn-textbtn"><%= t("cart.update") %></button></noscript>
                <% end %>
                </span>
                <span class="flex flex-wrap items-center gap-6">
                  <% if item.is_preorder? %>
                    <span class="vn-badge vn-badge--gold"><%= t("orders.preorder") %></span>
                    <% if item.estimated_delivery_date %>
                      <span class="vn-small"><%= t("orders.preorder_ships_by", date: l(item.estimated_delivery_date, format: :short)) %></span>
                    <% end %>
                  <% end %>
                  <button type="button" class="vn-textbtn" @click="showRemoveModal = true; itemToRemove = '<%= item.cart_key %>'"><%= t("cart.remove") %></button>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <% if @cart.items.any?(&:is_preorder?) %>
          <div class="mt-8 p-6 bg-gold-soft flex flex-col gap-2" role="note">
            <span class="vn-eyebrow"><%= t("cart.preorder_notice_title") %></span>
            <% if (disclaimer = current_settings.preorder_disclaimer(I18n.locale)).present? %>
              <p class="m-0 text-[15px] leading-6"><%= disclaimer %></p>
            <% end %>
            <p class="m-0 vn-small"><%= t("cart.preorder_ship_together") %></p>
          </div>
        <% end %>
      </section>

      <div class="flex-[1_1_360px] min-w-0 max-w-[460px] lg:sticky lg:top-[180px]">
        <aside aria-labelledby="summary-title" class="bg-surface-raised shadow-hairline p-8 flex flex-col gap-6">
          <h2 id="summary-title" class="m-0 font-display font-medium text-2xl leading-8 rtl:font-bold rtl:text-xl"><%= t("vene.cart.summary") %></h2>
          <%
            rows = [[t("orders.subtotal"), vn_price(@cart.subtotal)],
                    [t("vene.cart.delivery"), t("checkout.at_checkout")]]
            if @cart.has_coupon? && @cart.discount_amount.positive?
              rows << [safe_join([t("coupons.discount"), " ", tag.bdi(@cart.coupon&.code, class: "font-latin tracking-wide")]),
                       safe_join(["−", vn_price(@cart.discount_amount)])]
            end
          %>
          <%= render "shared/vene/totals", rows: rows, total: vn_price(@cart.total_after_discount), total_suffix: t("vene.cart.plus_delivery") %>

          <% if @cart.has_coupon? %>
            <div class="flex items-center justify-between gap-4 py-3 px-4 bg-gold-soft">
              <span class="flex flex-col">
                <span class="vn-label !text-gold-text"><%= t("coupons.applied_title") %></span>
                <bdi class="font-latin text-[15px] tracking-wide"><%= @cart.coupon&.code %></bdi>
              </span>
              <%= button_to t("coupons.remove"), remove_coupon_cart_path(locale: I18n.locale), method: :delete, class: "vn-textbtn" %>
            </div>
          <% else %>
            <%= form_with url: apply_coupon_cart_path(locale: I18n.locale), method: :post, data: { turbo: false }, class: "flex items-end gap-4" do |f| %>
              <div class="vn-field flex-1">
                <label for="coupon_code" class="vn-field__label"><%= t("coupons.enter_code") %></label>
                <%= f.text_field :coupon_code, id: "coupon_code", placeholder: t("coupons.code_placeholder"), dir: "ltr", autocomplete: "off", class: "vn-input uppercase font-latin", required: true %>
              </div>
              <%= f.submit t("coupons.apply"), class: "vn-btn vn-btn--outline vn-btn--sm" %>
            <% end %>
          <% end %>

          <%= render "shared/vene/button", label: t("vene.cart.checkout"), href: checkout_path(locale: I18n.locale), block: true, arrow: true %>
          <p class="m-0 vn-small text-center"><%= t("vene.cart.checkout_note") %></p>
          <ul class="list-none m-0 pt-6 border-t border-line flex flex-col gap-3">
            <li><%= render "shared/vene/feature_item", icon: :lock, text: t("cart.secure_checkout"), layout: :compact %></li>
            <li><%= render "shared/vene/feature_item", icon: :truck, text: t("cart.fast_shipping"), layout: :compact %></li>
            <% if whatsapp.present? %>
              <li><%= render "shared/vene/feature_item", icon: :message, layout: :compact,
                        text: safe_join([t("vene.cart.questions"), " ", link_to(t("vene.cart.message_us"), "https://wa.me/#{whatsapp}", target: "_blank", rel: "noopener", class: "vn-link")]) %></li>
            <% end %>
          </ul>
          <div class="flex items-center gap-3 vn-small">
            <span><%= t("cart.accepted_payments") %></span>
            <%= image_tag "visa.png", alt: "Visa, Mastercard", class: "h-5 w-auto" %>
            <span class="font-latin text-xs tracking-wide">MontyPay</span>
          </div>
        </aside>
      </div>
    </div>
  <% end %>

  <%# Remove confirmation %>
  <div x-show="showRemoveModal" x-cloak x-transition.opacity.duration.400ms @click="showRemoveModal = false"
       class="fixed inset-0 z-50 bg-ink/60 flex items-center justify-center p-4">
    <div @click.stop role="alertdialog" aria-modal="true" aria-labelledby="remove-title" aria-describedby="remove-text"
         class="bg-surface-raised shadow-lift max-w-md w-full p-8 flex flex-col gap-6">
      <div class="flex items-start justify-between gap-4">
        <h2 id="remove-title" class="vn-h3 m-0"><%= t("cart.confirm_remove_title") %></h2>
        <button type="button" class="vn-icon-btn -mt-2 -me-2" @click="showRemoveModal = false" aria-label="<%= t('common.close') %>"><%= vn_icon(:close, size: 20) %></button>
      </div>
      <p id="remove-text" class="m-0 text-[15px] leading-6 text-ink-muted"><%= t("cart.confirm_remove") %></p>
      <div class="flex flex-wrap gap-3">
        <button type="button" class="vn-btn vn-btn--outline flex-1" @click="showRemoveModal = false"><%= t("common.cancel") %></button>
        <%= form_with url: remove_item_cart_path(locale: I18n.locale), method: :delete, class: "flex-1 flex", data: { turbo: true } do |f| %>
          <input type="hidden" name="cart_key" x-bind:value="itemToRemove">
          <%= f.submit t("cart.remove"), class: "vn-btn vn-btn--danger flex-1" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
