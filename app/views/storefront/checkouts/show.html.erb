<% content_for :full_width, true %>
<% content_for :checkout, true %>
<% content_for :title, "#{t('checkout.title')} · VENÈ Jewelry" %>
<script>
  window.noPostalCountries = <%= @no_postal_countries.to_json.html_safe %>;
</script>
<%# Checkout.dc.html, step 1: delivery and contact, then the order summary. Field names, the
    saved-address binding and the DHL city check are unchanged; only the markup is new. %>
<div x-data="{
  addressMode: '<%= @addresses.any? ? 'saved' : 'new' %>',
  selectedAddressId: '<%= @addresses.find { |a| a.is_default }&.id || @addresses.first&.id %>',
  selectedCountry: '<%= @order.country %>',
  get showPostalCode() { return !window.noPostalCountries.includes(this.selectedCountry) },
  cityValue: '<%= j @order.city.to_s %>',
  cityStatus: 'idle',
  cityError: '',
  citySuggestions: [],
  cityTimer: null,
  validateCity() {
    clearTimeout(this.cityTimer);
    if (!this.cityValue || this.cityValue.length < 2 || !this.selectedCountry) {
      this.cityStatus = 'idle';
      this.cityError = '';
      this.citySuggestions = [];
      return;
    }
    this.cityStatus = 'loading';
    this.cityTimer = setTimeout(() => {
      const token = document.querySelector('meta[name=&quot;csrf-token&quot;]')?.content;
      fetch('<%= validate_city_checkout_path(locale: I18n.locale) %>', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': token, 'Accept': 'application/json' },
        body: JSON.stringify({ country: this.selectedCountry, city: this.cityValue })
      })
      .then(r => r.json())
      .then(data => {
        if (data.valid) {
          this.cityStatus = 'valid';
          this.cityError = '';
          this.citySuggestions = [];
          if (data.postal_code && this.$refs.postalCode && !this.$refs.postalCode.value) {
            this.$refs.postalCode.value = data.postal_code;
          }
        } else {
          this.cityStatus = 'invalid';
          this.cityError = '<%= j t('vene.checkout.city_unknown') %>';
          this.citySuggestions = data.suggestions || [];
        }
      })
      .catch(() => { this.cityStatus = 'idle'; });
    }, 600);
  },
  applySuggestion(name) {
    this.cityValue = name;
    this.$refs.cityInput.value = name;
    this.validateCity();
  }
}" class="vn-container pt-[clamp(32px,5vw,64px)] pb-[var(--section)]">
  <%= render "shared/vene/checkout_steps", current: :details %>

  <%= form_with url: review_checkout_path(locale: I18n.locale), method: :post, data: { turbo: false } do |form| %>
    <input type="hidden" name="address_id" x-bind:value="addressMode === 'saved' ? selectedAddressId : ''" />
    <%# The review step re-renders this form with the reason it stopped (e.g. a city DHL does not know). %>
    <% if @order.errors.any? %>
      <div class="mb-8"><%= render "shared/vene/form_errors", record: @order, title: t("vene.checkout.fix_details") %></div>
    <% end %>
    <div class="flex flex-wrap items-start gap-y-12 gap-x-[clamp(48px,6vw,96px)]">
      <div class="flex-[999_1_560px] min-w-0 flex flex-col">
        <%# ---------- Contact ---------- %>
        <section aria-labelledby="s-contact" class="border-t border-line py-8 flex flex-col gap-6">
          <h1 id="s-contact" class="vn-h2 m-0"><%= t("vene.checkout.contact") %></h1>
          <% if @is_guest %>
            <p class="m-0 text-[15px] leading-6 text-ink-muted">
              <%= t("checkout.have_account") %>
              <%= link_to t("checkout.sign_in"), new_user_session_path(locale: I18n.locale, redirect_to: checkout_path), class: "vn-link" %>
              <%= t("checkout.or_continue_guest") %>
            </p>
          <% end %>
          <div class="vn-field max-w-[520px]">
            <label for="order_email" class="vn-field__label"><%= t("activerecord.attributes.user.email") %></label>
            <input id="order_email" type="email" name="order[email]" value="<%= @order.email %>" required autocomplete="email" dir="ltr"
                   placeholder="you@example.com" class="vn-input" aria-describedby="email-hint">
            <span id="email-hint" class="vn-field__hint"><%= t("vene.checkout.email_hint") %></span>
          </div>
        </section>

        <%# ---------- Delivery ---------- %>
        <section aria-labelledby="s-delivery" class="border-t border-line py-8 flex flex-col gap-6">
          <h2 id="s-delivery" class="vn-h2 m-0"><%= t("vene.checkout.delivery") %></h2>

          <% if @addresses.any? %>
            <fieldset class="m-0 p-0 border-0">
              <legend class="vn-label mb-4"><%= t("checkout.shipping_address") %></legend>
              <div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
                <% @addresses.each do |addr| %>
                  <label class="flex gap-4 p-5 cursor-pointer bg-surface-raised border transition-colors duration-400"
                         :class="addressMode === 'saved' && selectedAddressId === '<%= addr.id %>' ? 'border-ink' : 'border-line hover:border-line-control'">
                    <input type="radio" name="vn_address_choice" class="mt-1 accent-[var(--ink)] w-4 h-4 flex-none"
                           :checked="addressMode === 'saved' && selectedAddressId === '<%= addr.id %>'"
                           @change="addressMode = 'saved'; selectedAddressId = '<%= addr.id %>'">
                    <span class="flex flex-col gap-0.5 text-[15px] leading-6 min-w-0">
                      <span class="flex items-center gap-2 flex-wrap">
                        <strong class="font-medium"><%= addr.name %></strong>
                        <% if addr.label.present? %><span class="vn-badge vn-badge--outline"><%= addr.label %></span><% end %>
                        <% if addr.is_default? %><span class="vn-badge vn-badge--gold"><%= t("vene.checkout.default") %></span><% end %>
                      </span>
                      <span class="text-ink-muted"><%= addr.street_address %><%= ", #{addr.building}" if addr.building.present? %></span>
                      <span class="text-ink-muted"><%= [addr.city, addr.postal_code, addr.country].compact_blank.join(", ") %></span>
                      <bdi class="text-ink-muted font-latin"><%= addr.phone %></bdi>
                    </span>
                  </label>
                <% end %>
                <label class="flex gap-4 items-center p-5 cursor-pointer border border-dashed transition-colors duration-400"
                       :class="addressMode === 'new' ? 'border-ink' : 'border-line-control hover:border-ink'">
                  <input type="radio" name="vn_address_choice" class="accent-[var(--ink)] w-4 h-4 flex-none" :checked="addressMode === 'new'" @change="addressMode = 'new'">
                  <span class="inline-flex items-center gap-2 text-[15px]"><%= vn_icon(:plus, size: 16) %><%= t("checkout.add_new_address") %></span>
                </label>
              </div>
            </fieldset>
          <% end %>

          <div x-show="addressMode === 'new'" x-cloak class="flex flex-col gap-6">
            <div class="vn-field">
              <label for="order_name" class="vn-field__label"><%= t("checkout.full_name") %></label>
              <input id="order_name" type="text" name="order[name]" value="<%= @order.name %>" required autocomplete="name"
                     pattern="\s*\S+(\s+\S+)+\s*" title="<%= t('checkout.full_name_required') %>" class="vn-input" aria-describedby="name-hint">
              <span id="name-hint" class="vn-field__hint"><%= t("checkout.full_name_required") %></span>
            </div>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6">
              <div class="vn-field">
                <label for="order_country" class="vn-field__label"><%= t("checkout.country") %></label>
                <%= country_select "order", "country",
                      { priority_countries: [current_settings.local_country], except: %w[IL IR CU RU KP], selected: @order.country },
                      { required: true, id: "order_country", autocomplete: "country-name", "x-model": "selectedCountry", "@change": "validateCity()", class: "vn-select" } %>
              </div>
              <div class="vn-field">
                <label for="order_city" class="vn-field__label"><%= t("checkout.city") %></label>
                <div class="relative">
                  <input id="order_city" type="text" name="order[city]" x-model="cityValue" x-ref="cityInput" required autocomplete="address-level2"
                         @input="validateCity()" @change="validateCity()" class="vn-input pe-8"
                         :aria-invalid="(cityStatus === 'invalid').toString()" aria-describedby="city-status">
                  <span class="absolute end-0 top-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true">
                    <span x-show="cityStatus === 'loading'" x-cloak class="vn-small"><%= t("vene.checkout.checking") %></span>
                    <span x-show="cityStatus === 'valid'" x-cloak><%= vn_icon(:check, size: 18, stroke: 1.5, tone: :success) %></span>
                  </span>
                </div>
                <p id="city-status" x-show="cityStatus === 'invalid'" x-cloak class="vn-field__error m-0" x-text="cityError" role="status"></p>
                <div x-show="citySuggestions.length > 0" x-cloak class="flex flex-col gap-2 pt-1">
                  <span class="vn-small"><%= t("vene.checkout.did_you_mean") %></span>
                  <div class="flex flex-wrap gap-2">
                    <template x-for="s in citySuggestions" :key="s">
                      <button type="button" class="vn-chip !h-9 !px-4" @click="applySuggestion(s)" x-text="s"></button>
                    </template>
                  </div>
                </div>
              </div>
            </div>
            <div class="vn-field">
              <label for="order_street" class="vn-field__label"><%= t("checkout.street_address") %></label>
              <input id="order_street" type="text" name="order[street_address]" value="<%= @order.street_address %>" required autocomplete="address-line1" class="vn-input">
            </div>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-6">
              <div class="vn-field">
                <label for="order_building" class="vn-field__label"><%= t("vene.checkout.building") %></label>
                <input id="order_building" type="text" name="order[building]" value="<%= @order.building %>" autocomplete="address-line2"
                       placeholder="<%= t('vene.checkout.optional') %>" class="vn-input">
              </div>
              <div class="vn-field" x-show="showPostalCode" x-cloak>
                <label for="order_postal" class="vn-field__label"><%= t("checkout.postal_code") %></label>
                <input id="order_postal" type="text" name="order[postal_code]" value="<%= @order.postal_code %>" x-ref="postalCode"
                       x-bind:disabled="!showPostalCode" autocomplete="postal-code" dir="ltr" class="vn-input">
              </div>
            </div>
            <div class="vn-field">
              <label for="order_phone" class="vn-field__label"><%= t("checkout.phone") %></label>
              <input id="order_phone" type="text" name="order[phone]" value="<%= @order.phone %>" required autocomplete="tel" dir="ltr"
                     placeholder="+961" class="vn-input" aria-describedby="phone-hint">
              <span id="phone-hint" class="vn-field__hint"><%= t("vene.checkout.phone_hint") %></span>
            </div>
            <% unless @is_guest %>
              <label class="vn-check vn-check--muted">
                <input type="checkbox" name="save_address" value="1" checked id="save_address_checkbox">
                <span><%= t("checkout.save_address") %></span>
              </label>
            <% end %>
          </div>

          <div class="flex flex-col gap-3">
            <span class="vn-label"><%= t("vene.checkout.delivery_method") %></span>
            <div class="flex justify-between items-start gap-4 p-5 bg-surface-raised border border-ink">
              <span class="flex gap-3 items-start">
                <%= vn_icon(:truck, size: 20, css: "mt-0.5") %>
                <span class="flex flex-col">
                  <span class="text-[15px] leading-6 font-medium">DHL Express</span>
                  <span class="vn-small"><%= t("vene.checkout.dhl_hint") %></span>
                </span>
              </span>
              <span class="vn-small whitespace-nowrap"><%= t("vene.checkout.rate_next") %></span>
            </div>
            <p class="m-0 vn-small"><%= t("vene.product.duties") %></p>
          </div>
        </section>

        <div class="border-t border-line pt-8">
          <button type="submit" class="vn-btn vn-btn--primary vn-btn--block"><span><%= t("checkout.continue_to_payment") %></span><span class="vn-btn__arrow" aria-hidden="true">→</span></button>
        </div>
      </div>

      <div class="flex-[1_1_360px] min-w-0 max-w-[460px] lg:sticky lg:top-8">
        <%
          rows = [[t("orders.subtotal"), vn_price(@cart.subtotal)],
                  [t("vene.cart.delivery"), t("vene.checkout.rate_next")]]
          if @cart.has_coupon? && @cart.discount_amount.positive?
            rows << [safe_join([t("coupons.discount"), " ", tag.bdi(@cart.coupon&.code, class: "font-latin")]), safe_join(["−", vn_price(@cart.discount_amount)])]
          end
        %>
        <%= render "shared/vene/order_summary", items: @cart.items, rows: rows, total: vn_price(@cart.total_after_discount),
              total_label: t("orders.subtotal"), total_suffix: t("vene.cart.plus_delivery"), note: t("vene.checkout.secure_note") %>
      </div>
    </div>
  <% end %>
</div>
<%# GA4 ecommerce: fire begin_checkout only when the customer first lands on checkout (GET show),
    not on review re-renders or validation re-renders. %>
<% if action_name == "show" %>
  <%= ga4_data_layer Ga4.begin_checkout_event(@cart) %>
  <%= meta_pixel_event MetaPixel.initiate_checkout_event(@cart) %>
<% end %>
