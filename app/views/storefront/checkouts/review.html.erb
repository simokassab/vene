<% content_for :full_width, true %>
<% content_for :checkout, true %>
<% content_for :title, "#{t('checkout.review_title', default: 'Review Your Order')} · VENÈ Jewelry" %>
<%# Checkout.dc.html, step 2: the delivery summary, the pieces and the payment method, beside the
    priced summary with the place-order form (hidden fields unchanged). %>
<% review_total = @cart.total_after_discount + @shipping_amount %>
<div class="vn-container pt-[clamp(32px,5vw,64px)] pb-[var(--section)]">
  <%= render "shared/vene/checkout_steps", current: :review %>
  <div class="flex flex-wrap items-start gap-y-12 gap-x-[clamp(48px,6vw,96px)]">
    <div class="flex-[999_1_560px] min-w-0 flex flex-col">
      <section aria-labelledby="s-contact" class="border-t border-line py-8">
        <div class="flex justify-between items-baseline gap-4">
          <h1 id="s-contact" class="vn-h2 m-0"><%= t("vene.checkout.contact_delivery") %></h1>
          <%= link_to t("vene.checkout.edit"), checkout_path(locale: I18n.locale), class: "vn-link text-xs tracking-nav uppercase rtl:text-sm" %>
        </div>
        <dl class="m-0 mt-6 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-8 gap-y-4 text-[15px] leading-6">
          <div><dt class="vn-label mb-1"><%= t("checkout.full_name") %></dt><dd class="m-0"><%= @order.name %></dd></div>
          <div><dt class="vn-label mb-1"><%= t("activerecord.attributes.user.email") %></dt><dd class="m-0"><bdi class="font-latin"><%= @order.email %></bdi></dd></div>
          <div><dt class="vn-label mb-1"><%= t("checkout.phone") %></dt><dd class="m-0"><bdi class="font-latin"><%= @order.phone %></bdi></dd></div>
          <div>
            <dt class="vn-label mb-1"><%= t("vene.checkout.address") %></dt>
            <dd class="m-0 text-ink-muted">
              <%= @order.street_address %><%= ", #{@order.building}" if @order.building.present? %><br>
              <%= [@order.city, @order.postal_code, @order.country].compact_blank.join(", ") %>
            </dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="s-items" class="border-t border-line py-8">
        <h2 id="s-items" class="vn-h2 m-0 mb-6"><%= t("vene.checkout.pieces") %> <span class="vn-small font-sans align-middle">(<%= t("vene.cart.count", count: @cart.items.sum(&:quantity)) %>)</span></h2>
        <ul class="list-none m-0 p-0 flex flex-col gap-6">
          <% @cart.items.each do |item| %>
            <li>
              <%= render "shared/vene/line_item", size: :md, title: item.product.name(I18n.locale), image: vn_product_image_url(item.product, variant: item.product_variant),
                    meta: [item.product.metal.presence, item.product_variant&.display_name].compact.join(" · ").presence || item.product.category.name(I18n.locale),
                    detail: safe_join([vn_price(item.unit_price), " × ", tag.bdi(item.quantity, class: "font-latin"), (" · #{t('orders.preorder')}" if item.is_preorder?)]),
                    price: vn_price(item.line_total) %>
            </li>
          <% end %>
        </ul>
      </section>

      <section aria-labelledby="s-pay" class="border-y border-line py-8">
        <h2 id="s-pay" class="vn-h2 m-0 mb-6"><%= t("vene.checkout.payment") %></h2>
        <div class="flex flex-wrap justify-between items-center gap-4 p-5 bg-surface-raised border border-ink">
          <span class="flex items-start gap-3">
            <%= vn_icon(:lock, size: 20, css: "mt-0.5") %>
            <span class="flex flex-col">
              <span class="text-[15px] leading-6 font-medium"><%= t("vene.checkout.card") %> · <span class="font-latin">MontyPay</span></span>
              <span class="vn-small"><%= t("vene.checkout.card_note") %></span>
            </span>
          </span>
          <%= image_tag "visa.png", alt: "Visa, Mastercard", class: "h-6 w-auto" %>
        </div>
      </section>
    </div>

    <div class="flex-[1_1_360px] min-w-0 max-w-[460px] lg:sticky lg:top-8">
      <%
        rows = [[t("orders.subtotal"), vn_price(@cart.subtotal)],
                [(@shipping_estimated ? t("checkout.estimated_shipping", default: "Estimated Shipping") : t("vene.cart.delivery")), vn_price(@shipping_amount)]]
        if @cart.has_coupon? && @cart.discount_amount.positive?
          rows << [safe_join([t("coupons.discount"), " ", tag.bdi(@cart.coupon&.code, class: "font-latin")]), safe_join(["−", vn_price(@cart.discount_amount)])]
        end
      %>
      <%= render "shared/vene/order_summary", items: @cart.items, rows: rows, total: vn_price(review_total),
            note: (t("common.prices_include_tax") if current_settings.show_tax_notice) do %>
        <%= form_with url: checkout_path(locale: I18n.locale), method: :post, data: { turbo: false }, class: "flex flex-col gap-4" do |form| %>
          <%= hidden_field_tag "order[name]", @order.name %>
          <%= hidden_field_tag "order[email]", @order.email %>
          <%= hidden_field_tag "order[phone]", @order.phone %>
          <%= hidden_field_tag "order[country]", @order.country %>
          <%= hidden_field_tag "order[country_code]", @order.country_code %>
          <%= hidden_field_tag "order[city]", @order.city %>
          <%= hidden_field_tag "order[postal_code]", @order.postal_code %>
          <%= hidden_field_tag "order[street_address]", @order.street_address %>
          <%= hidden_field_tag "order[building]", @order.building %>
          <%= hidden_field_tag "order[address_id]", @order.address_id %>
          <input type="hidden" name="payment_method" value="card">
          <%= form.button t("vene.checkout.place_order"), type: "submit", class: "vn-btn vn-btn--primary vn-btn--block" %>
          <p class="m-0 vn-small">
            <%= t("vene.checkout.agree") %>
            <%= link_to t("pages.refund"), page_path("refund-and-cancellation-policy", locale: I18n.locale), class: "vn-link" %>
            <%= t("auth.and") %>
            <%= link_to t("pages.delivery"), page_path("delivery-policy", locale: I18n.locale), class: "vn-link" %>.
          </p>
        <% end %>
        <% if @shipping_estimated %>
          <%= render "shared/vene/notice", variant: :banner, tone: :note, text: t("checkout.estimated_shipping_note", default: "Shipping cost is estimated. The actual rate from DHL could not be retrieved at this time.") %>
        <% end %>
        <%= render "shared/vene/feature_item", icon: :lock, text: t("vene.checkout.secure_note"), layout: :compact %>
      <% end %>
    </div>
  </div>
</div>
