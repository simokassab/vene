<% content_for :full_width, true %>
<%# Home (Main.dc.html, HomeAr-9vjr.dc.html). Sections: hero banners, categories, the house edit
    (top pieces per category), new arrivals, the story band, the featured marquee, the must-have
    piece on noir, the long-form story, and the house promises. %>
<% reveal = { "x-data": "{ shown: false }", "x-intersect.once": "shown = true", "x-init": "setTimeout(() => shown = true, 900)", ":class": "shown && 'is-shown'" } %>

<%# ---------- Hero: banners advance every 7s (never under 6s), pausing on interaction ---------- %>
<section aria-label="<%= t('vene.home.hero_label') %>" class="relative bg-media border-b border-line"
         x-data="{ slide: 0, autoplay: true, count: <%= [@banners.size, 1].max %>,
                   init() { if (this.count > 1) setInterval(() => { if (this.autoplay) this.slide = (this.slide + 1) % this.count }, 7000) } }">
  <% if @banners.any? %>
    <% @banners.each_with_index do |banner, index| %>
      <% product = banner.product %>
      <% button_url = if product.present?
                        product_path(product.slug, locale: I18n.locale)
                      elsif banner.url.present?
                        banner.url
                      else
                        products_path(locale: I18n.locale)
                      end %>
      <div x-show="slide === <%= index %>" <%= "x-cloak" if index.positive? %>
           x-transition:enter="transition-opacity duration-700 ease-vene" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
           class="grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] min-h-[clamp(520px,calc(100svh-170px),920px)]"
           role="group" aria-roledescription="slide" aria-label="<%= index + 1 %> / <%= @banners.size %>">
        <div class="relative order-1 md:order-2 min-h-[320px] overflow-hidden bg-media">
          <%= image_tag banner.image.url, alt: banner.title(I18n.locale).to_s, class: "absolute inset-0 w-full h-full object-cover",
                                               style: "object-position: #{banner.image_focus}% 50%", loading: (index.zero? ? "eager" : "lazy") %>
        </div>
        <div class="order-2 md:order-1 flex items-center px-[var(--gutter)] py-12 md:py-20 md:ps-[max(var(--gutter),calc((100vw-var(--container-site))/2+var(--gutter)))]">
          <div class="@container w-full min-w-0 max-w-[560px] flex flex-col gap-6 md:gap-8">
            <%= render "shared/vene/eyebrow", text: (product&.name(I18n.locale) || t("storefront.home.hero_eyebrow")) %>
            <h1 class="vn-display-xl vn-display-xl--fit m-0"><%= banner.title(I18n.locale).presence || t("vene.brand.tagline") %></h1>
            <% if banner.subtitle(I18n.locale).present? %>
              <p class="vn-lead m-0 !text-[26px] !leading-9 rtl:!text-lg rtl:!leading-8"><%= banner.subtitle(I18n.locale) %></p>
            <% end %>
            <div class="flex flex-wrap items-center gap-8">
              <%= render "shared/vene/button", label: t("common.shop_now"), href: button_url, arrow: true %>
              <% if product.present? %>
                <%= render "shared/vene/button", label: t("vene.home.discover", name: product.name(I18n.locale)), href: products_path(locale: I18n.locale), variant: :link %>
              <% end %>
            </div>
            <% if product.present? %>
              <div class="flex flex-wrap justify-between gap-3 pt-6 border-t border-line max-w-[520px]">
                <span class="vn-caps text-ink-muted"><%= [product.metal, product.diamonds].compact_blank.join(" · ") %></span>
                <%= render "shared/product_price", product: product %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <% if @banners.size > 1 %>
      <div class="absolute bottom-6 start-[var(--gutter)] md:start-[max(var(--gutter),calc((100vw-var(--container-site))/2+var(--gutter)))] z-10 flex items-center gap-3">
        <% @banners.size.times do |index| %>
          <button type="button" @click="slide = <%= index %>; autoplay = false"
                  class="w-8 h-8 flex items-center justify-center cursor-pointer bg-transparent border-0 p-0"
                  :aria-current="(slide === <%= index %>).toString()" aria-label="<%= t('vene.home.go_to_slide', number: index + 1) %>">
            <span class="block h-px w-6 transition-colors duration-400" :class="slide === <%= index %> ? 'bg-ink' : 'bg-line-control'"></span>
          </button>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] min-h-[clamp(520px,calc(100svh-170px),920px)]">
      <div class="relative order-1 md:order-2 min-h-[320px] overflow-hidden bg-media">
        <video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
          <source src="/videos/vene-hero.mp4" type="video/mp4">
        </video>
      </div>
      <div class="order-2 md:order-1 flex items-center px-[var(--gutter)] py-12 md:py-20 md:ps-[max(var(--gutter),calc((100vw-var(--container-site))/2+var(--gutter)))]">
        <div class="max-w-[560px] flex flex-col gap-6 md:gap-8">
          <%= render "shared/vene/eyebrow", text: t("storefront.home.hero_eyebrow") %>
          <h1 class="vn-display-xl m-0"><%= t("vene.brand.tagline") %></h1>
          <p class="vn-lead m-0"><%= t("vene.brand.lifetime") %></p>
          <div><%= render "shared/vene/button", label: t("common.shop_now"), href: products_path(locale: I18n.locale), arrow: true %></div>
        </div>
      </div>
    </div>
  <% end %>
</section>

<%# ---------- Shop by category ---------- %>
<% if @categories.any? %>
  <section aria-labelledby="cat-title" class="vn-container pt-[var(--section)]">
    <header class="flex flex-col items-center gap-4 text-center mb-12">
      <%= render "shared/vene/eyebrow", text: t("vene.home.shop_by_category") %>
      <h2 id="cat-title" class="vn-h1 m-0"><%= t("vene.home.find_your_piece") %></h2>
    </header>
    <nav aria-label="<%= t('vene.home.categories') %>" class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-6 border-t border-line">
      <% @categories.each do |category| %>
        <% note = category.sub_categories.select(&:active?).sort_by { |sc| sc.position || 999 }.first(3).map { |sc| sc.name(I18n.locale) }.to_sentence %>
        <%= link_to category_path(category.slug, locale: I18n.locale), class: "vn-quiet !text-ink hover:!text-gold-text flex flex-col gap-2 py-8 pe-6 border-b border-line h-full" do %>
          <span class="font-display text-[32px] leading-10 rtl:text-[28px] rtl:leading-[44px]"><%= category.name(I18n.locale) %> <span aria-hidden="true" class="font-latin text-base"><%= vn_arrow %></span></span>
          <% if note.present? %><span class="vn-small rtl:text-sm rtl:leading-[22px]"><%= note %></span><% end %>
        <% end %>
      <% end %>
    </nav>
  </section>
<% end %>

<%# ---------- The house edit: top pieces per category ---------- %>
<% edit_categories = @categories.take(6).select { |c| @category_products[c.id].present? } %>
<% if edit_categories.any? %>
  <section aria-labelledby="edit-title" class="vn-container vn-section" x-data="{ selected: <%= edit_categories.first.id %> }">
    <header class="flex flex-col items-center gap-4 text-center mb-10">
      <%= render "shared/vene/eyebrow", text: t("vene.home.house_edit") %>
      <h2 id="edit-title" class="vn-h1 m-0"><%= t("storefront.home.top_product") %></h2>
      <p class="vn-lead m-0 max-w-[620px]"><%= t("vene.home.edit_lead") %></p>
    </header>
    <div class="vn-scroll-x flex gap-3 overflow-x-auto pb-2 mb-12 md:justify-center" role="tablist" aria-label="<%= t('vene.home.categories') %>">
      <% edit_categories.each do |category| %>
        <button type="button" class="vn-chip" role="tab" @click="selected = <%= category.id %>"
                :aria-selected="(selected === <%= category.id %>).toString()" :aria-pressed="(selected === <%= category.id %>).toString()"
                aria-controls="edit-<%= category.id %>"><%= category.name(I18n.locale) %></button>
      <% end %>
    </div>
    <% edit_categories.each_with_index do |category, i| %>
      <div id="edit-<%= category.id %>" role="tabpanel" x-show="selected === <%= category.id %>" <%= "x-cloak" if i.positive? %>
           x-transition:enter="transition-opacity duration-600 ease-vene" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
           class="vn-products">
        <% @category_products[category.id].take(4).each do |product| %>
          <%= render "shared/vene/product_card", product: product %>
        <% end %>
      </div>
    <% end %>
    <div class="flex justify-center mt-16">
      <%= render "shared/vene/button", label: t("vene.home.view_all_jewelry"), href: products_path(locale: I18n.locale), variant: :outline %>
    </div>
  </section>
<% end %>

<%# ---------- Story band: the atelier film in an arched frame ---------- %>
<section aria-labelledby="story-title" class="bg-surface-sunken">
  <div class="vn-container vn-section flex flex-wrap items-center gap-[clamp(48px,7vw,128px)]">
    <div class="flex-[1_1_340px] max-w-[460px] min-w-0 aspect-[3/4] bg-media overflow-hidden mx-auto md:mx-0" style="border-radius: var(--radius-arch) var(--radius-arch) 0 0;">
      <video class="block w-full h-full object-cover" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
        <source src="/videos/vene-hero.mp4" type="video/mp4">
      </video>
    </div>
    <div class="flex-[1_1_440px] min-w-0 max-w-[620px] flex flex-col gap-6 vn-reveal" <%= tag.attributes(reveal) %>>
      <%= render "shared/vene/eyebrow", text: t("storefront.home.hero_eyebrow") %>
      <h2 id="story-title" class="vn-h1 m-0"><%= t("storefront.home.hero_heading") %></h2>
      <p class="vn-body m-0"><%= t("storefront.home.hero_body") %></p>
      <div class="pt-2"><%= render "shared/vene/button", label: t("storefront.home.hero_cta"), href: products_path(locale: I18n.locale), variant: :link, arrow: true %></div>
    </div>
  </div>
</section>

<%# ---------- New arrivals ---------- %>
<% if @featured_products.any? %>
  <section aria-labelledby="new-title" class="vn-container vn-section">
    <header class="flex flex-wrap items-end justify-between gap-6 mb-12">
      <div class="flex flex-col gap-4">
        <%= render "shared/vene/eyebrow", text: t("vene.home.just_in") %>
        <h2 id="new-title" class="vn-h1 m-0"><%= t("storefront.home.new_arrivals") %></h2>
      </div>
      <%= render "shared/vene/button", label: t("common.view_all"), href: products_path(locale: I18n.locale), variant: :link, arrow: true %>
    </header>
    <div class="vn-products">
      <% @featured_products.each do |product| %>
        <%= render "shared/vene/product_card", product: product %>
      <% end %>
    </div>
  </section>
<% end %>

<%# ---------- Must have: one piece on noir, with the gleam ---------- %>
<% sale_product = Product.active.on_sale.includes(:product_images).first %>
<% if sale_product.present? %>
  <section aria-labelledby="must-title" class="vn-noir">
    <div class="vn-container vn-section flex flex-wrap-reverse items-center gap-[clamp(48px,7vw,128px)]">
      <div class="flex-[1_1_440px] min-w-0 max-w-[560px] flex flex-col gap-6">
        <%= render "shared/vene/eyebrow", text: t("storefront.home.must_have") %>
        <h2 id="must-title" class="vn-display-l m-0"><%= sale_product.name(I18n.locale) %></h2>
        <% if sale_product.description(I18n.locale).present? %>
          <p class="vn-body m-0 line-clamp-4"><%= strip_tags(sale_product.description(I18n.locale)) %></p>
        <% end %>
        <span class="vn-small"><%= [sale_product.metal, sale_product.diamonds].compact_blank.join(" · ") %></span>
        <div class="text-xl"><%= render "shared/product_price", product: sale_product, size: :page %></div>
        <div class="flex flex-wrap gap-3 pt-2">
          <% if sale_product.made_to_order? && (wa = made_to_order_whatsapp_url(sale_product)) %>
            <%= link_to wa, target: "_blank", rel: "noopener", class: "vn-btn vn-btn--gold" do %>
              <%= render "shared/whatsapp_icon", css_class: "w-4 h-4" %><span><%= t("products.order_on_whatsapp") %></span>
            <% end %>
          <% else %>
            <%= render "shared/vene/button", label: t("common.shop_now"), href: product_path(sale_product.slug, locale: I18n.locale), variant: :gold, arrow: true %>
          <% end %>
        </div>
      </div>
      <div class="flex-[1_1_420px] min-w-0 max-w-[520px] mx-auto">
        <%= link_to product_path(sale_product.slug, locale: I18n.locale), class: "relative block w-full aspect-square bg-media shadow-gleam overflow-hidden", "aria-label": sale_product.name(I18n.locale) do %>
          <div class="vn-card__badge"><%= render "shared/made_to_order_badge", product: sale_product, positioned: false %></div>
          <% if (src = vn_product_image_url(sale_product)) %>
            <%= image_tag src, alt: "", loading: "lazy", class: "block w-[84%] h-[84%] m-[8%] object-contain" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# ---------- Featured pieces: a slow marquee (static under reduced motion) ---------- %>
<% featured = @scrolling_featured_products.to_a %>
<% if featured.any? %>
  <section aria-labelledby="featured-title" class="vn-section overflow-hidden">
    <header class="vn-container flex flex-col items-center gap-4 text-center mb-12">
      <%= render "shared/vene/eyebrow", text: t("vene.header.featured") %>
      <h2 id="featured-title" class="vn-h1 m-0"><%= t("storefront.home.featured_products") %></h2>
    </header>
    <% if marquee_scrollable?(featured) %>
      <div class="vn-marquee px-[var(--gutter)]">
        <% marquee_products(featured).each_with_index do |product, i| %>
          <div class="flex-none w-56 md:w-72" <%= 'aria-hidden="true" inert' .html_safe if i >= featured.size %>>
            <%= render "shared/vene/product_card", product: product, wishlist: false %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="vn-container flex flex-wrap justify-center gap-6">
        <% featured.each do |product| %>
          <div class="w-56 md:w-72"><%= render "shared/vene/product_card", product: product, wishlist: false %></div>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<%# ---------- Our story, long form ---------- %>
<section id="our-story" aria-labelledby="narrative-title" class="bg-surface-sunken">
  <div class="vn-container vn-section flex flex-col items-center">
    <div class="vn-measure w-full flex flex-col gap-6 vn-reveal" <%= tag.attributes(reveal) %>>
      <%= render "shared/vene/eyebrow", text: t("storefront.home.story_eyebrow") %>
      <h2 id="narrative-title" class="vn-h1 m-0"><%= t("storefront.home.story_heading") %></h2>
      <div class="vn-prose">
        <% (1..5).each do |n| %><p><%= t("storefront.home.story_p#{n}") %></p><% end %>
      </div>
      <p class="vn-lead m-0 pt-6 border-t border-line"><%= t("storefront.home.story_closing") %></p>
    </div>
  </div>
</section>

<%# ---------- The house promises ---------- %>
<section aria-label="<%= t('vene.home.promise_label') %>" class="vn-container py-[clamp(64px,7vw,96px)]">
  <ul class="list-none m-0 p-0 grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-x-8 gap-y-12">
    <li><%= render "shared/vene/feature_item", icon: :gem, title: t("vene.home.promise.handcrafted_title"), text: t("vene.home.promise.handcrafted_text") %></li>
    <li><%= render "shared/vene/feature_item", icon: :truck, title: t("vene.home.promise.dhl_title"), text: t("vene.home.promise.dhl_text") %></li>
    <% if current_settings.show_tax_notice %>
      <li><%= render "shared/vene/feature_item", icon: :shield, title: t("vene.home.promise.taxes_title"), text: t("common.prices_include_tax") %></li>
    <% else %>
      <li><%= render "shared/vene/feature_item", icon: :lock, title: t("vene.home.promise.secure_title"), text: t("vene.home.promise.secure_text") %></li>
    <% end %>
    <li><%= render "shared/vene/feature_item", icon: :package, title: t("vene.home.promise.track_title"), text: t("vene.home.promise.track_text") %></li>
  </ul>
</section>
