<%# Wishlist alert: a saved piece now costs less. Stated plainly, never discount-led. %>
<% content_for :preheader, t("mailers.wishlist_mailer.price_drop.subject", product: @product.name, percentage: @percentage) %>
<% content_for :footer_note, t("mailers.wishlist_mailer.common.footer") %>
<%= vn_email_section(ground: :surface, padding: "56px 56px 40px") do %>
  <%= vn_email_eyebrow(t("vene.email.wishlist.eyebrow")) %>
  <%= vn_email_title(t("vene.email.wishlist.price_title"), size: 44) %>
  <%= vn_email_text(t("mailers.wishlist_mailer.price_drop.greeting", name: @user.name), muted: false) %>
  <%= vn_email_text(t("mailers.wishlist_mailer.price_drop.body", product: @product.name, percentage: @percentage)) %>
<% end %>
<%= vn_email_section(ground: :raised) do %>
  <%= vn_email_line_item(name: @product.name, image: vn_email_image_url(@product), meta: @product.metal.presence,
                         detail: @variant&.display_name, price: vn_email_usd(@current_price)) %>
  <%= vn_email_totals([[t("wishlist.original_price"), vn_email_usd(@original_price)],
                       [t("wishlist.you_save"), "#{vn_email_usd(@original_price - @current_price)} (#{@percentage}%)"]],
                      total_label: t("wishlist.new_price"), total: vn_email_usd(@current_price)) %>
  <div style="height: 24px; line-height: 24px;">&nbsp;</div>
  <%= vn_email_button(t("mailers.wishlist_mailer.price_drop.cta"), product_url(@product.slug, locale: I18n.locale)) %>
<% end %>
