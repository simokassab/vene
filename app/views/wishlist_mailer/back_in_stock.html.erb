<%# Wishlist alert: a saved piece is available again. %>
<% content_for :preheader, t("mailers.wishlist_mailer.back_in_stock.subject", product: @product.name) %>
<% content_for :footer_note, t("mailers.wishlist_mailer.common.footer") %>
<%= vn_email_section(ground: :surface, padding: "56px 56px 40px") do %>
  <%= vn_email_eyebrow(t("vene.email.wishlist.eyebrow")) %>
  <%= vn_email_title(t("vene.email.wishlist.back_title"), size: 44) %>
  <%= vn_email_text(t("mailers.wishlist_mailer.back_in_stock.greeting", name: @user.name), muted: false) %>
  <%= vn_email_text(t("mailers.wishlist_mailer.back_in_stock.body", product: @product.name)) %>
<% end %>
<%= vn_email_section(ground: :raised) do %>
  <%= vn_email_line_item(name: @product.name, image: vn_email_image_url(@product, variant: @variant), meta: @product.metal.presence,
                         detail: @variant&.display_name, price: vn_email_usd(@wishlist_item.current_price)) %>
  <%= vn_email_button(t("mailers.wishlist_mailer.back_in_stock.cta"), product_url(@product.slug, locale: I18n.locale)) %>
<% end %>
