<%# EmailPurchase.dc.html: thanks and order meta, the pieces and totals, delivery and what
    happens next, then (for guests) an invitation to keep the order in an account. %>
<% content_for :preheader, t("vene.email.confirmation.preheader", number: "##{@order.id}") %>
<% content_for :footer_note do %>
  <%= t("vene.product.duties") %>
  <%= link_to t("pages.delivery"), page_url("delivery-policy", locale: I18n.locale), style: "color: #{vn_email_color(:muted)};" %> ·
  <%= link_to t("pages.refund"), page_url("refund-and-cancellation-policy", locale: I18n.locale), style: "color: #{vn_email_color(:muted)};" %>
<% end %>
<% first_name = @order.name.to_s.split.first %>

<%= vn_email_section(ground: :surface, padding: "56px 56px 40px") do %>
  <%= vn_email_eyebrow(t("vene.email.confirmation.eyebrow"), tone: :success) %>
  <%= vn_email_title(t("vene.email.confirmation.title", name: first_name)) %>
  <%= vn_email_text(t("vene.email.confirmation.body", email: @order.email)) %>
  <%= vn_email_meta([
        [t("vene.orders.order_label"), "##{@order.id}"],
        [t("vene.orders.placed"), l(@order.created_at.to_date, format: :long)],
        [t("vene.email.delivery"), "DHL Express"]
      ]) %>
  <%= vn_email_button(t("vene.email.view_order"), order_url(@order, locale: I18n.locale)) %>
<% end %>

<%= vn_email_section(ground: :raised) do %>
  <%= vn_email_heading(t("vene.email.your_pieces")) %>
  <% @order.order_items.each do |item| %>
    <%= vn_email_line_item(
          name: item.product.name(I18n.locale),
          image: vn_email_image_url(item.product),
          meta: [item.product.metal.presence, item.product_variant&.display_name].compact.join(" · "),
          detail: [t("vene.email.qty", count: item.quantity), (t("vene.email.made_to_order") if item.is_preorder)].compact.join(" · "),
          price: vn_email_order_price(item.line_total, @order)) %>
  <% end %>
  <%
    rows = [[t("orders.subtotal"), vn_email_order_price(@order.subtotal, @order)],
            [t("vene.cart.delivery"), vn_email_order_price(@order.shipping_amount, @order)]]
    rows << ["#{t('coupons.discount')} (#{@order.coupon_code})", "−#{vn_email_order_price(@order.discount_amount, @order)}"] if @order.discount_amount.to_f.positive?
    rows << [t("vene.email.taxes"), t("vene.email.included")] if Setting.current.show_tax_notice
  %>
  <%= vn_email_totals(rows, total_label: t("orders.total"), total: vn_email_order_price(@order.total_amount, @order)) %>
<% end %>

<% if @order.has_preorder_items? %>
  <%= vn_email_section(ground: :gold_soft, padding: "32px 56px") do %>
    <%= vn_email_eyebrow(t("mailers.order_mailer.confirmation.preorder_notice")) %>
    <%= vn_email_text(Setting.current.preorder_disclaimer(I18n.locale), muted: false, size: 15) if Setting.current.preorder_disclaimer(I18n.locale).present? %>
    <% if @order.order_items.preorders.any? && @order.order_items.regular_orders.any? %>
      <%= vn_email_text(t("mailers.order_mailer.confirmation.ship_together"), size: 15) %>
    <% end %>
  <% end %>
<% end %>

<%= vn_email_section(ground: :surface) do %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td width="50%" style="vertical-align: top; padding-<%= vn_email_rtl? ? 'left' : 'right' %>: 20px; text-align: <%= vn_email_align %>;">
        <%= vn_email_eyebrow(t("vene.orders.deliver_to"), tone: :muted) %>
        <p style="margin: 0; font-family: <%= vn_email_sans %>; font-size: 15px; line-height: 24px; color: <%= vn_email_color(:ink) %>;">
          <%= @order.name %><br>
          <% if @order.street_address.present? %>
            <%= @order.street_address %><br>
            <% if @order.building.present? %><%= @order.building %><br><% end %>
            <%= [@order.city, @order.postal_code].compact_blank.join(", ") %><br>
            <%= @order.country %>
          <% else %>
            <%= @order.address_text %><br><%= @order.city %>, <%= @order.country %>
          <% end %>
        </p>
      </td>
      <td width="50%" style="vertical-align: top; text-align: <%= vn_email_align %>;">
        <%= vn_email_eyebrow(t("vene.email.next"), tone: :muted) %>
        <% %w[crafted shipped delivered].each_with_index do |step, i| %>
          <p style="margin: 0 0 6px; font-family: <%= vn_email_sans %>; font-size: 15px; line-height: 24px; color: <%= vn_email_color(:ink) %>;">
            <span style="font-family: <%= VeneEmailHelper::EMAIL_SERIF %>; font-size: 18px; color: <%= vn_email_color(:gold_text) %>;"><%= %w[I II III][i] %></span>&nbsp;&nbsp;<%= t("vene.email.steps.#{step}") %>
          </p>
        <% end %>
      </td>
    </tr>
  </table>
<% end %>

<% if @order.is_guest? %>
  <%= vn_email_section(ground: :gold_soft, padding: "32px 56px") do %>
    <p style="margin: 0 0 8px; font-family: <%= vn_email_serif %>; font-weight: <%= vn_email_rtl? ? 700 : 500 %>; font-size: 22px; line-height: 28px; color: <%= vn_email_color(:ink) %>;"><%= t("vene.email.guest_title") %></p>
    <p style="margin: 0; font-family: <%= vn_email_sans %>; font-size: 15px; line-height: 24px; color: <%= vn_email_color(:muted) %>;">
      <%= t("vene.email.guest_text") %>
      <%= link_to t("vene.auth.create"), new_user_registration_url(locale: I18n.locale), style: "color: #{vn_email_color(:ink)}; text-decoration: none; border-bottom: 1px solid #{vn_email_color(:gold)};" %>
    </p>
  <% end %>
<% end %>
