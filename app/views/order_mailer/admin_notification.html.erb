<%# Internal: a new order for the atelier. Same kit as the client emails, denser content. %>
<% content_for :preheader, "#{t('vene.email.admin.title')} · ##{@order.id} · #{display_order_price(@order.total_amount, @order, compact: true)}" %>
<%= vn_email_section(ground: :surface, padding: "48px 56px 32px") do %>
  <%= vn_email_eyebrow(t("vene.email.admin.eyebrow")) %>
  <%= vn_email_title(t("vene.email.admin.title"), size: 40) %>
  <%= vn_email_meta([
        [t("vene.orders.order_label"), "##{@order.id}"],
        [t("vene.orders.placed"), l(@order.created_at, format: :long)],
        [t("vene.orders.value"), vn_email_order_price(@order.total_amount, @order)]
      ]) %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family: <%= vn_email_sans %>; font-size: 15px; line-height: 24px; color: <%= vn_email_color(:ink) %>;">
    <% [[t("vene.email.admin.customer"), "#{@order.name} (#{@order.email})"],
        [t("checkout.phone"), @order.phone],
        [t("vene.orders.payment"), "#{payment_method_label(@order)} · #{vn_payment_status_label(@order.payment_status)}"],
        [t("orders.status"), vn_status_label(@order.status)]].each do |label, value| %>
      <tr>
        <td style="padding: 4px 0; width: 160px; color: <%= vn_email_color(:muted) %>; text-align: <%= vn_email_align %>;"><%= label %></td>
        <td style="padding: 4px 0; text-align: <%= vn_email_align %>;"><%= value %></td>
      </tr>
    <% end %>
  </table>
  <%= vn_email_button(t("vene.email.admin.open"), admin_order_url(@order, locale: I18n.locale)) %>
<% end %>
<%= vn_email_section(ground: :raised) do %>
  <%= vn_email_heading(t("vene.email.your_pieces")) %>
  <% @order.order_items.each do |item| %>
    <%= vn_email_line_item(
          name: item.product.name_en,
          image: vn_email_image_url(item.product),
          meta: item.product_variant&.display_name,
          detail: [t("vene.email.qty", count: item.quantity), "#{vn_email_order_price(item.unit_price, @order)} #{t('cart.each')}", (t("vene.email.made_to_order") if item.is_preorder)].compact.join(" · "),
          price: vn_email_order_price(item.line_total, @order)) %>
  <% end %>
  <%= vn_email_eyebrow(t("vene.orders.deliver_to"), tone: :muted) %>
  <p style="margin: 0; font-family: <%= vn_email_sans %>; font-size: 15px; line-height: 24px; color: <%= vn_email_color(:ink) %>;">
    <% if @order.street_address.present? %>
      <%= @order.street_address %><br>
      <% if @order.building.present? %><%= @order.building %><br><% end %>
      <%= [@order.city, @order.postal_code].compact_blank.join(", ") %><br>
      <%= @order.country %>
    <% else %>
      <%= @order.address_text %><br><%= @order.city %>, <%= @order.country %>
    <% end %>
  </p>
<% end %>
